---
import { getCollection } from "astro:content";
import DocsLayout from "@/layouts/DocsLayout.astro";
import ComponentApi from "@/components/docs/ComponentApi.astro";
import ComponentExamples from "@/components/docs/ComponentExamples.astro";
import ComponentInstall from "@/components/docs/ComponentInstall.astro";
import MarkdownContent from "@/components/docs/MarkdownContent.vue";
import { demoHeadings, hasDemos } from "@/components/docs/demos";
import { apiHeadings, FRAMEWORKS, type Framework } from "@/lib/docs";
import { documentForFramework, documentHeadings, parseDocument } from "@/lib/markdown";

export async function getStaticPaths() {
  const guides = await getCollection("guides");
  const components = await getCollection("components");

  return [
    ...guides.map((entry) => ({
      params: { slug: entry.id },
      props: { entry, framework: null as Framework | null },
    })),
    ...components.flatMap((entry) =>
      FRAMEWORKS.map((framework) => ({
        params: { slug: `components/${framework}/${entry.id}` },
        props: { entry, framework: framework as Framework | null },
      })),
    ),
  ];
}

const { entry, framework } = Astro.props;
const parsed = await parseDocument(entry.body ?? "");
const document = framework ? documentForFramework(parsed, framework) : parsed;

const registryItem = entry.collection === "components" ? entry.data.registryItem : null;
const installNote = entry.collection === "components" ? entry.data.installNote : undefined;

const exampleHeadings =
  registryItem && hasDemos(registryItem)
    ? [{ slug: "examples", text: "Examples", depth: 2 }, ...demoHeadings(registryItem)]
    : [];

const tocHeadings =
  registryItem && framework
    ? [
        ...exampleHeadings,
        { slug: "installation", text: "Installation", depth: 2 },
        ...documentHeadings(document),
        ...(await apiHeadings(registryItem)),
      ]
    : documentHeadings(document);
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  headings={tocHeadings}
  framework={framework}
  component={registryItem}
>
  {
    registryItem && framework && (
      <ComponentExamples slot="preview" component={registryItem} framework={framework} />
    )
  }

  {
    registryItem && framework && (
      <ComponentInstall registryItem={registryItem} note={installNote} />
    )
  }

  <MarkdownContent value={document} class="prose" />

  {
    registryItem && framework && (
      <ComponentApi slot="api" registryItem={registryItem} framework={framework} />
    )
  }
</DocsLayout>
