---
import { getEntry } from "astro:content";
import DocsLayout from "@/layouts/DocsLayout.astro";
import MarkdownContent from "@/components/docs/MarkdownContent.vue";
import { documentHeadings, parseDocument } from "@/lib/markdown";

const entry = await getEntry("guides", "introduction");
if (!entry) throw new Error("Introduction guide not found");

const document = await parseDocument(entry.body ?? "");
const tocHeadings = documentHeadings(document);
---

<DocsLayout title={entry.data.title} description={entry.data.description} headings={tocHeadings}>
  <MarkdownContent value={document} class="prose" />
</DocsLayout>
