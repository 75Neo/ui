---
import Layout from "@/layouts/Layout.astro";
import SiteHeader from "@/components/site/SiteHeader.astro";
import Button from "@/registry/vue/ui/button/Button.vue";
import { docsNavigation } from "@/lib/docs";

const sections = await docsNavigation();
const componentSections = sections.filter((section) => section.label !== "Getting started");

const principles = [
  {
    title: "The source is the deliverable",
    body: "The CLI writes TypeScript into your repository under your own alias. There is no runtime package, so there is nothing to upgrade and nothing to eject from.",
  },
  {
    title: "One recipe, two adapters",
    body: "Each component is written once as a tailwind-variants recipe and twice as a thin adapter. Restyling means editing the recipe, not chasing two implementations.",
  },
  {
    title: "Behaviour comes from Ark UI",
    body: "Anything with state, focus management or an accessibility contract is built over Ark UI, which ships the same state machines to React and Vue.",
  },
];
---

<Layout>
  <SiteHeader />

  <main>
    <section class="mx-auto w-full max-w-360 px-4 pt-16 pb-20 sm:px-6 lg:pt-24">
      <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_28rem]">
        <div>
          <h1
            class="text-4xl font-semibold tracking-tight text-balance text-default sm:text-5xl lg:text-6xl"
          >
            One UI kit for React and Vue
          </h1>

          <p class="mt-6 max-w-xl text-lg leading-8 text-muted">
            Theme tokens, accessible primitives and copy paste components, published as a shadcn
            registry rather than a package.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a
              href="/docs/introduction"
              class="inline-flex items-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-inverted transition-colors hover:bg-primary/75 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >
              Get started
            </a>
            <a
              href="/docs/components/button"
              class="inline-flex items-center rounded-md px-4 py-2 text-sm font-medium text-default ring ring-default transition-colors hover:bg-muted/60 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >
              Browse components
            </a>
          </div>
        </div>

        <div class="rounded-md p-6 ring ring-default sm:p-8">
          <div class="flex flex-wrap gap-2">
            <Button>Solid</Button>
            <Button variant="outline" color="secondary">Outline</Button>
            <Button variant="soft" color="success">Soft</Button>
            <Button variant="subtle" color="warning">Subtle</Button>
            <Button variant="ghost" color="info">Ghost</Button>
            <Button variant="link" color="error">Link</Button>
          </div>

          <div class="mt-6 flex flex-wrap items-center gap-2 border-t border-default pt-6">
            <Button size="xs" variant="outline">xs</Button>
            <Button size="sm" variant="outline">sm</Button>
            <Button size="md" variant="outline">md</Button>
            <Button size="lg" variant="outline">lg</Button>
            <Button size="xl" variant="outline">xl</Button>
          </div>
        </div>
      </div>
    </section>

    <section class="border-t border-default">
      <div class="mx-auto w-full max-w-360 px-4 py-16 sm:px-6">
        <div class="grid gap-8 sm:grid-cols-2">
          <div>
            <p class="text-xs font-medium text-dimmed">React</p>
            <pre
              class="mt-2 overflow-x-auto rounded-md bg-muted/40 p-4 font-mono text-[0.8125rem] text-default ring ring-default">npx shadcn@latest add @75neo/button</pre>
          </div>

          <div>
            <p class="text-xs font-medium text-dimmed">Vue</p>
            <pre
              class="mt-2 overflow-x-auto rounded-md bg-muted/40 p-4 font-mono text-[0.8125rem] text-default ring ring-default">npx shadcn-vue@latest add @75neo/button</pre>
          </div>
        </div>

        <p class="mt-6 text-sm text-muted">
          Both registries publish the same item names.{" "}
          <a
            href="/docs/installation"
            class="font-medium text-primary underline decoration-primary/40 underline-offset-4 transition-colors hover:decoration-primary"
            >Installation</a
          > covers pointing the CLI at them.
        </p>
      </div>
    </section>

    <section class="border-t border-default">
      <div class="mx-auto w-full max-w-360 px-4 py-20 sm:px-6">
        <h2 class="max-w-2xl text-2xl font-semibold tracking-tight text-default sm:text-3xl">
          Built to be edited, not configured
        </h2>

        <dl class="mt-10 divide-y divide-default border-t border-default">
          {
            principles.map((principle) => (
              <div class="grid gap-2 py-6 lg:grid-cols-[18rem_minmax(0,1fr)] lg:gap-10">
                <dt class="font-medium text-default">{principle.title}</dt>
                <dd class="max-w-2xl leading-7 text-muted">{principle.body}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="border-t border-default">
      <div class="mx-auto w-full max-w-360 px-4 py-20 sm:px-6">
        <h2 class="text-2xl font-semibold tracking-tight text-default sm:text-3xl">Components</h2>

        <div class="mt-10 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
          {
            componentSections.map((section) => (
              <div>
                <p class="text-xs font-medium text-dimmed">{section.label}</p>
                <ul class="mt-3 flex flex-col gap-1">
                  {section.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        class="text-muted transition-colors hover:text-primary"
                      >
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <footer class="border-t border-default">
      <div
        class="mx-auto flex w-full max-w-360 flex-wrap items-center justify-between gap-4 px-4 py-8 text-sm text-dimmed sm:px-6"
      >
        <p>Released under the MIT licence.</p>
        <a
          href="https://github.com/75Neo/ui"
          rel="noreferrer"
          class="transition-colors hover:text-default">GitHub</a
        >
      </div>
    </footer>
  </main>
</Layout>
