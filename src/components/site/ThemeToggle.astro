---
import ThemeIcon from "@/components/site/ThemeIcon.vue";
---

<button
  type="button"
  data-theme-toggle
  aria-label="Switch between the light and dark theme"
  class="inline-flex size-8 cursor-pointer items-center justify-center rounded-md text-muted transition-colors hover:bg-muted hover:text-default focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
>
  <ThemeIcon />
</button>

<script>
  const root = document.documentElement;

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element) || !target.closest("[data-theme-toggle]")) return;

    const dark = root.classList.toggle("dark");
    localStorage.setItem("theme", dark ? "dark" : "light");
  });
</script>
