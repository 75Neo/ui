---
import type { DocsSection } from "@/lib/docs";

interface Props {
  sections: DocsSection[];
  current: string;
}

const { sections, current } = Astro.props;
---

<nav data-docs-nav aria-label="Documentation" class="flex flex-col gap-7 text-sm">
  {
    sections.map((section) => (
      <div>
        <p class="mb-2 px-3 text-xs font-medium text-dimmed">{section.label}</p>

        <ul class="flex flex-col">
          {section.links.map((link) => (
            <li>
              <a
                href={link.href}
                data-component={link.component}
                aria-current={link.href === current ? "page" : undefined}
                class="block rounded-md px-3 py-1.5 text-muted transition-colors hover:bg-muted hover:text-default aria-[current=page]:bg-muted aria-[current=page]:font-medium aria-[current=page]:text-default"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</nav>

<script>
  const FRAMEWORKS = ["react", "vue"];
  const DEFAULT_FRAMEWORK = "react";

  const isFramework = (value: string | null | undefined): value is string =>
    typeof value === "string" && FRAMEWORKS.includes(value);

  const frameworkFromLocation = () => {
    const [section, group, segment] = window.location.pathname.split("/").filter(Boolean);
    return section === "docs" && group === "components" && isFramework(segment) ? segment : null;
  };

  const remember = (framework: string) => {
    try {
      localStorage.setItem("framework", framework);
    } catch {
      return;
    }
  };

  const recall = () => {
    try {
      return localStorage.getItem("framework");
    } catch {
      return null;
    }
  };

  const activeFramework = () => {
    const fromLocation = frameworkFromLocation();
    if (fromLocation) {
      remember(fromLocation);
      return fromLocation;
    }

    const stored = recall();
    return isFramework(stored) ? stored : DEFAULT_FRAMEWORK;
  };

  const syncNavigation = () => {
    const framework = activeFramework();
    const raw = window.location.pathname.replace(/\/$/, "") || "/";
    const current = raw === "/" ? "/docs/introduction" : raw;

    for (const link of document.querySelectorAll<HTMLAnchorElement>("a[data-component]")) {
      link.setAttribute("href", `/docs/components/${framework}/${link.dataset.component}`);
    }

    for (const link of document.querySelectorAll("[data-docs-nav] a")) {
      if (link.getAttribute("href") === current) link.setAttribute("aria-current", "page");
      else link.removeAttribute("aria-current");
    }
  };

  syncNavigation();
</script>
