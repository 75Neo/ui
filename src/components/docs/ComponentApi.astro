---
import { getEntry } from "astro:content";
import ApiTable from "@/components/docs/ApiTable.astro";
import { apiHeadingSlug, FRAMEWORK_LABELS, type Framework } from "@/lib/docs";

interface Props {
  registryItem: string;
  framework: Framework;
}

const { registryItem, framework } = Astro.props;
const entry = await getEntry("componentApi", registryItem);

if (!entry) {
  throw new Error(`No extracted API for the registry item "${registryItem}".`);
}

const { components } = entry.data;
const label = FRAMEWORK_LABELS[framework];
---

<section>
  <h2 id="api-reference" class="mt-14 scroll-mt-24 text-xl font-semibold tracking-tight text-default">
    API reference
  </h2>

  <p class="mt-3 text-[0.9375rem] leading-7 text-muted">
    Read straight from the {label} sources at build time, so it never drifts from the code you
    install. A red asterisk marks a required prop.
  </p>

  {
    components.map((component) => (
      <article class="mt-10 border-t border-default pt-8">
        <h3
          id={apiHeadingSlug(component.name)}
          class="scroll-mt-24 font-mono text-base font-semibold text-default"
        >
          {component.name}
        </h3>

        {framework === "vue" && component.vue && (
          <>
            {component.vue.props.length > 0 && (
              <ApiTable label="Props" nameHeading="Prop" rows={component.vue.props} />
            )}
            {component.vue.slots.length > 0 && (
              <ApiTable label="Slots" nameHeading="Slot" rows={component.vue.slots} />
            )}
            {component.vue.events.length > 0 && (
              <ApiTable label="Events" nameHeading="Event" rows={component.vue.events} />
            )}
          </>
        )}

        {framework === "react" && component.react && (
          <>
            {component.react.props.length > 0 && (
              <ApiTable label="Props" nameHeading="Prop" rows={component.react.props} />
            )}

            {component.react.inherits.length > 0 && (
              <p class="mt-3 text-xs text-dimmed">
                It also accepts everything in{" "}
                {component.react.inherits.map((inherited, index) => (
                  <>
                    {index > 0 && " and "}
                    <code class="rounded-sm bg-muted/60 px-1 py-0.5 text-default">{inherited}</code>
                  </>
                ))}
                .
              </p>
            )}
          </>
        )}
      </article>
    ))
  }
</section>
