---
import PackageManagerTabs from "@/components/docs/PackageManagerTabs.vue";

interface Props {
  registryItem: string;
  note?: string;
}

const { registryItem, note } = Astro.props;
---

<section>
  <h2 id="installation" class="mt-14 scroll-mt-24 text-xl font-semibold tracking-tight text-default">
    Installation
  </h2>

  <PackageManagerTabs value={`npx @75neo/ui@latest add ${registryItem}`} />

  {note && <p class="mt-4 text-[0.9375rem] leading-7 text-muted">{note}</p>}
</section>
