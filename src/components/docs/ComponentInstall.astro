---
import MarkdownContent from "@/components/docs/MarkdownContent.vue";
import type { Framework } from "@/lib/docs";
import { parseDocument } from "@/lib/markdown";

interface Props {
  registryItem: string;
  framework: Framework;
  note?: string;
}

const { registryItem, framework, note } = Astro.props;
const cli = framework === "react" ? "shadcn" : "shadcn-vue";
const document = await parseDocument(
  `\`\`\`sh\nnpx ${cli}@latest add @75neo/${registryItem}\n\`\`\``,
);
---

<section>
  <h2 id="installation" class="mt-14 scroll-mt-24 text-xl font-semibold tracking-tight text-default">
    Installation
  </h2>

  <div class="mt-4">
    <MarkdownContent value={document} class="prose" />
  </div>

  {note && <p class="mt-4 text-[0.9375rem] leading-7 text-muted">{note}</p>}
</section>
