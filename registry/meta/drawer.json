{
  "type": "registry:ui",
  "title": "Drawer",
  "description": "A panel that slides in from an edge and can be swiped away.",
  "registryDependencies": ["@75neo/theme"],
  "dependencies": ["@ark-ui/{framework}", "cn", "tailwind-variants"],
  "cssVars": {
    "theme": {
      "--animate-fade-in": "fade-in 0.15s ease-out",
      "--animate-fade-out": "fade-out 0.1s ease-in",
      "--animate-drawer-in": "drawer-in 0.2s cubic-bezier(0.16, 1, 0.3, 1)",
      "--animate-drawer-out": "drawer-out 0.15s ease-in"
    }
  },
  "css": {
    "@keyframes fade-in": {
      "from": {
        "opacity": "0"
      },
      "to": {
        "opacity": "1"
      }
    },
    "@keyframes fade-out": {
      "from": {
        "opacity": "1"
      },
      "to": {
        "opacity": "0"
      }
    },
    "@keyframes drawer-in": {
      "from": {
        "translate": "var(--drawer-from)"
      },
      "to": {
        "translate": "0 0"
      }
    },
    "@keyframes drawer-out": {
      "from": {
        "translate": "0 0"
      },
      "to": {
        "translate": "var(--drawer-from)"
      }
    }
  }
}
