{
  "type": "registry:ui",
  "title": "Floating Panel",
  "description": "A window that can be dragged, resized, minimised and maximised.",
  "registryDependencies": ["@75neo/theme"],
  "dependencies": ["@ark-ui/{framework}", "cn", "tailwind-variants"],
  "cssVars": {
    "theme": {
      "--animate-fade-in": "fade-in 0.15s ease-out",
      "--animate-fade-out": "fade-out 0.1s ease-in"
    }
  },
  "css": {
    "@keyframes fade-in": {
      "from": {
        "opacity": "0"
      },
      "to": {
        "opacity": "1"
      }
    },
    "@keyframes fade-out": {
      "from": {
        "opacity": "1"
      },
      "to": {
        "opacity": "0"
      }
    }
  }
}
