{
  "type": "registry:theme",
  "title": "75NeoUI theme",
  "description": "The colour, radius and text tokens every 75NeoUI component draws on.",
  "css": {
    "@custom-variant light (&:where(.light, .light *))": {},
    "@custom-variant dark (&:where(.dark, .dark *))": {},
    "@layer base": {
      ":root": {
        "--ui-primary": "var(--color-stone-900)",
        "--ui-secondary": "var(--color-stone-200)",
        "--ui-success": "var(--color-green-500)",
        "--ui-info": "var(--color-blue-500)",
        "--ui-warning": "var(--color-amber-500)",
        "--ui-error": "var(--color-red-500)",
        "--ui-neutral": "var(--color-stone-500)",
        "--ui-text": "var(--color-stone-900)",
        "--ui-text-muted": "var(--color-stone-600)",
        "--ui-text-toned": "var(--color-stone-700)",
        "--ui-text-dimmed": "var(--color-stone-400)",
        "--ui-text-highlighted": "var(--color-stone-950)",
        "--ui-text-inverted": "var(--color-stone-50)",
        "--ui-bg": "var(--color-white)",
        "--ui-bg-elevated": "var(--color-white)",
        "--ui-bg-muted": "var(--color-stone-100)",
        "--ui-bg-accented": "var(--color-stone-200)",
        "--ui-bg-inverted": "var(--color-stone-900)",
        "--ui-border": "var(--color-stone-200)",
        "--ui-border-muted": "var(--color-stone-100)",
        "--ui-border-accented": "var(--color-stone-300)",
        "--ui-border-inverted": "var(--color-stone-900)",
        "--ui-shadow-xs": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
        "--ui-shadow-sm": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)",
        "--ui-shadow-md": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)",
        "--ui-shadow-lg": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)",
        "--ui-radius": "0.25rem",
        "--ui-container": "50rem"
      },
      ".dark": {
        "--ui-primary": "var(--color-stone-50)",
        "--ui-secondary": "var(--color-stone-800)",
        "--ui-success": "var(--color-green-500)",
        "--ui-info": "var(--color-blue-500)",
        "--ui-warning": "var(--color-amber-500)",
        "--ui-error": "var(--color-red-500)",
        "--ui-neutral": "var(--color-stone-400)",
        "--ui-text": "var(--color-stone-50)",
        "--ui-text-muted": "var(--color-stone-400)",
        "--ui-text-toned": "var(--color-stone-300)",
        "--ui-text-dimmed": "var(--color-stone-500)",
        "--ui-text-highlighted": "var(--color-white)",
        "--ui-text-inverted": "var(--color-stone-900)",
        "--ui-bg": "var(--color-stone-950)",
        "--ui-bg-elevated": "var(--color-stone-900)",
        "--ui-bg-muted": "var(--color-stone-800)",
        "--ui-bg-accented": "var(--color-stone-700)",
        "--ui-bg-inverted": "var(--color-stone-50)",
        "--ui-border": "var(--color-stone-800)",
        "--ui-border-muted": "var(--color-stone-700)",
        "--ui-border-accented": "var(--color-stone-700)",
        "--ui-border-inverted": "var(--color-white)"
      }
    },
    "@theme default": {
      "--color-primary": "var(--ui-primary)",
      "--color-secondary": "var(--ui-secondary)",
      "--color-success": "var(--ui-success)",
      "--color-info": "var(--ui-info)",
      "--color-warning": "var(--ui-warning)",
      "--color-error": "var(--ui-error)",
      "--color-neutral": "var(--ui-neutral)",
      "--radius-xs": "calc(var(--ui-radius) * 0.5)",
      "--radius-sm": "calc(var(--ui-radius))",
      "--radius-md": "calc(var(--ui-radius) * 1.5)",
      "--radius-lg": "calc(var(--ui-radius) * 2)",
      "--radius-xl": "calc(var(--ui-radius) * 2.5)",
      "--radius-2xl": "calc(var(--ui-radius) * 3)",
      "--radius-3xl": "calc(var(--ui-radius) * 3.5)",
      "--radius-4xl": "calc(var(--ui-radius) * 4)",
      "--shadow-xs": "var(--ui-shadow-xs)",
      "--shadow-sm": "var(--ui-shadow-sm)",
      "--shadow-md": "var(--ui-shadow-md)",
      "--shadow-lg": "var(--ui-shadow-lg)",
      "--text-color-default": "var(--ui-text)",
      "--text-color-dimmed": "var(--ui-text-dimmed)",
      "--text-color-muted": "var(--ui-text-muted)",
      "--text-color-toned": "var(--ui-text-toned)",
      "--text-color-highlighted": "var(--ui-text-highlighted)",
      "--text-color-inverted": "var(--ui-text-inverted)",
      "--background-color-default": "var(--ui-bg)",
      "--background-color-elevated": "var(--ui-bg-elevated)",
      "--background-color-muted": "var(--ui-bg-muted)",
      "--background-color-accented": "var(--ui-bg-accented)",
      "--background-color-inverted": "var(--ui-bg-inverted)",
      "--border-color-default": "var(--ui-border)",
      "--border-color-muted": "var(--ui-border-muted)",
      "--border-color-accented": "var(--ui-border-accented)",
      "--border-color-inverted": "var(--ui-border-inverted)",
      "--ring-color-default": "var(--ui-border)",
      "--ring-color-muted": "var(--ui-border-muted)",
      "--ring-color-accented": "var(--ui-border-accented)",
      "--ring-color-inverted": "var(--ui-border-inverted)",
      "--divide-color-default": "var(--ui-border)",
      "--divide-color-muted": "var(--ui-border-muted)",
      "--divide-color-accented": "var(--ui-border-accented)",
      "--divide-color-inverted": "var(--ui-border-inverted)",
      "--outline-color-default": "var(--ui-border)",
      "--outline-color-muted": "var(--ui-border-muted)",
      "--outline-color-accented": "var(--ui-border-accented)",
      "--outline-color-inverted": "var(--ui-border-inverted)"
    }
  },
  "docs": "Theme tokens are injected into your Tailwind CSS file (components.json tailwind.css). Override --ui-* variables afterwards in the same file."
}
