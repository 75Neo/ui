{
  "type": "registry:ui",
  "title": "Tour",
  "description": "A guided walk through a page, one spotlit step at a time.",
  "registryDependencies": ["@75neo/theme"],
  "dependencies": ["@ark-ui/{framework}", "cn", "tailwind-variants"],
  "cssVars": {
    "theme": {
      "--animate-fade-in": "fade-in 0.15s ease-out",
      "--animate-fade-out": "fade-out 0.1s ease-in",
      "--animate-panel-in": "panel-in 0.15s ease-out",
      "--animate-panel-out": "panel-out 0.1s ease-in"
    }
  },
  "css": {
    "@keyframes fade-in": {
      "from": {
        "opacity": "0"
      },
      "to": {
        "opacity": "1"
      }
    },
    "@keyframes fade-out": {
      "from": {
        "opacity": "1"
      },
      "to": {
        "opacity": "0"
      }
    },
    "@keyframes panel-in": {
      "from": {
        "opacity": "0",
        "transform": "translateY(-0.25rem)"
      },
      "to": {
        "opacity": "1",
        "transform": "translateY(0)"
      }
    },
    "@keyframes panel-out": {
      "from": {
        "opacity": "1",
        "transform": "translateY(0)"
      },
      "to": {
        "opacity": "0",
        "transform": "translateY(-0.25rem)"
      }
    }
  }
}
