{
  "type": "registry:ui",
  "title": "Date Picker",
  "description": "A calendar in a popover that reads and writes one date or a range.",
  "registryDependencies": ["@75neo/theme"],
  "dependencies": ["@ark-ui/{framework}", "cn", "tailwind-variants"],
  "cssVars": {
    "theme": {
      "--animate-panel-in": "panel-in 0.15s ease-out",
      "--animate-panel-out": "panel-out 0.1s ease-in"
    }
  },
  "css": {
    "@keyframes panel-in": {
      "from": {
        "opacity": "0",
        "transform": "translateY(-0.25rem)"
      },
      "to": {
        "opacity": "1",
        "transform": "translateY(0)"
      }
    },
    "@keyframes panel-out": {
      "from": {
        "opacity": "1",
        "transform": "translateY(0)"
      },
      "to": {
        "opacity": "0",
        "transform": "translateY(-0.25rem)"
      }
    }
  }
}
