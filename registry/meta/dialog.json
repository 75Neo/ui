{
  "type": "registry:ui",
  "title": "Dialog",
  "description": "A modal window that traps focus until it is dismissed.",
  "registryDependencies": ["@75neo/theme"],
  "dependencies": ["@ark-ui/{framework}", "cn", "tailwind-variants"],
  "cssVars": {
    "theme": {
      "--animate-fade-in": "fade-in 0.15s ease-out",
      "--animate-fade-out": "fade-out 0.1s ease-in",
      "--animate-dialog-in": "dialog-in 0.15s cubic-bezier(0.16, 1, 0.3, 1)",
      "--animate-dialog-out": "dialog-out 0.1s ease-in"
    }
  },
  "css": {
    "@keyframes fade-in": {
      "from": {
        "opacity": "0"
      },
      "to": {
        "opacity": "1"
      }
    },
    "@keyframes fade-out": {
      "from": {
        "opacity": "1"
      },
      "to": {
        "opacity": "0"
      }
    },
    "@keyframes dialog-in": {
      "from": {
        "opacity": "0",
        "transform": "scale(0.96)"
      },
      "to": {
        "opacity": "1",
        "transform": "scale(1)"
      }
    },
    "@keyframes dialog-out": {
      "from": {
        "opacity": "1",
        "transform": "scale(1)"
      },
      "to": {
        "opacity": "0",
        "transform": "scale(0.96)"
      }
    }
  }
}
