{
  "name": "@75neo/react",
  "version": "0.0.0",
  "description": "75NeoUI components for React",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint:package": "publint",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@75neo/styles": "workspace:*",
    "@ark-ui/react": "^5.38.2",
    "lucide-react": "catalog:"
  },
  "devDependencies": {
    "@75neo/tooling": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
