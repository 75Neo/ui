{
  "name": "@75neo/ui",
  "version": "1.0.1",
  "description": "The 75NeoUI installer and animation stylesheet",
  "keywords": [
    "75neoui",
    "react",
    "registry",
    "tailwindcss",
    "vue"
  ],
  "homepage": "https://75neo-ui.pages.dev",
  "license": "MIT",
  "author": "Vo Quang Chien <2giosangmitom@gmail.com>",
  "contributors": [
    "Vo Van Duy <nstcrystal@gmail.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/75Neo/ui.git",
    "directory": "packages/ui"
  },
  "bin": {
    "75neoui": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "animations.css"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./animations.css": "./animations.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "yargs": "^18.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/yargs": "^17.0.35",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
