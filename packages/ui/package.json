{
  "name": "@75neo/ui",
  "version": "0.1.0",
  "description": "The 75NeoUI installer and animation stylesheet",
  "keywords": [
    "75neoui",
    "react",
    "registry",
    "tailwindcss",
    "vue"
  ],
  "homepage": "https://75neo-ui.pages.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/75Neo/ui.git",
    "directory": "packages/ui"
  },
  "bin": {
    "75neoui": "./dist/cli.js"
  },
  "files": [
    "dist",
    "animations.css"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./animations.css": "./animations.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "prepack": "tsc"
  },
  "dependencies": {
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/yargs": "^17.0.35",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
