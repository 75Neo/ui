{
  "name": "@75neo/svelte",
  "version": "0.0.0",
  "description": "75NeoUI components for Svelte",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "svelte-package --input src --output dist",
    "dev": "svelte-package --input src --output dist --watch",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint:package": "publint",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@75neo/styles": "workspace:*",
    "@ark-ui/svelte": "^5.23.1",
    "@lucide/svelte": "catalog:"
  },
  "devDependencies": {
    "@75neo/tooling": "workspace:*",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "publint": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "svelte": ">=5.20"
  }
}
