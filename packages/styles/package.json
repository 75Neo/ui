{
  "name": "@75neo/styles",
  "version": "0.0.0",
  "description": "Shared Panda CSS preset and generated styled-system for 75NeoUI",
  "license": "MIT",
  "files": [
    "src",
    "styled-system"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./preset": "./src/preset.ts",
    "./css": {
      "types": "./styled-system/css/index.d.ts",
      "default": "./styled-system/css/index.mjs"
    },
    "./recipes": {
      "types": "./styled-system/recipes/index.d.ts",
      "default": "./styled-system/recipes/index.mjs"
    },
    "./patterns": {
      "types": "./styled-system/patterns/index.d.ts",
      "default": "./styled-system/patterns/index.mjs"
    },
    "./tokens": {
      "types": "./styled-system/tokens/index.d.ts",
      "default": "./styled-system/tokens/index.mjs"
    },
    "./types": {
      "types": "./styled-system/types/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "codegen": "panda codegen --clean",
    "dev": "panda codegen --watch",
    "build": "panda codegen --clean",
    "check": "tsc --noEmit",
    "prepack": "panda codegen --clean"
  },
  "devDependencies": {
    "@pandacss/dev": "catalog:",
    "postcss": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:"
  }
}
