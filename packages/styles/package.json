{
  "name": "@75neo/styles",
  "version": "0.0.0",
  "description": "Shared Tailwind CSS theme and tailwind-variants component themes for 75NeoUI",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint:package": "publint",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1"
  },
  "devDependencies": {
    "@75neo/tooling": "workspace:*",
    "publint": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "tailwindcss": ">=4.1"
  }
}
