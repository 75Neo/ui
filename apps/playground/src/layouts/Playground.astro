---
import "../assets/css/main.css";
import { previews } from "../routes";

interface Props {
  title: string;
}

const { title } = Astro.props;
const current = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · 75NeoUI playground</title>
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><text y='14' font-size='14'>🎛️</text></svg>"
    />
    <script is:inline>
      if (localStorage.getItem("neo-theme") === "dark") {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>
  <body class="min-h-dvh">
    <header
      class="bg-default/85 sticky top-0 z-10 border-b backdrop-blur"
    >
      <div class="mx-auto flex max-w-6xl items-center gap-6 px-6 py-3">
        <a href="/" class="text-sm font-semibold text-highlighted">
          75NeoUI
        </a>
        <nav class="flex flex-1 gap-4 text-sm">
          {
            previews.map(({ href, label }) => (
              <a
                href={href}
                class:list={[
                  "text-muted hover:text-highlighted",
                  current === href && "text-highlighted font-medium",
                ]}
              >
                {label}
              </a>
            ))
          }
        </nav>
        <button
          id="theme-toggle"
          type="button"
          class="text-toned hover:bg-elevated rounded-md border px-2.5 py-1 text-xs"
        >
          Toggle theme
        </button>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-6 py-10">
      <h1 class="text-highlighted mb-8 text-2xl font-semibold">{title}</h1>
      <slot />
    </main>

    <script is:inline>
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const dark = document.documentElement.classList.toggle("dark");
        localStorage.setItem("neo-theme", dark ? "dark" : "light");
      });
    </script>
  </body>
</html>
