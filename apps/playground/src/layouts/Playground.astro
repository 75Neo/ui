---
import "../assets/css/main.css";
import SegmentedControl from "../components/SegmentedControl.astro";
import { previews } from "../routes";

interface Props {
  title: string;
  /** Small mono line above the page title — the kind of page this is. */
  eyebrow: string;
  description: string;
  /**
   * Whether this page renders a specimen stage. The surface control only has
   * something to act on when it does, so it is left out otherwise.
   */
  hasStage?: boolean;
}

const { title, eyebrow, description, hasStage = false } = Astro.props;
const current = Astro.url.pathname.replace(/\/$/, "") || "/";

const shell = "mx-auto w-full max-w-page px-5 sm:px-8 lg:px-12";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · 75NeoUI playground</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · 75NeoUI playground`} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/logo-brand.svg" type="image/svg+xml" />
    <link rel="icon" href="/logo-brand.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/logo-brand.png" />
    <script is:inline>
      // Runs before first paint so the page never flashes the wrong theme.
      (() => {
        const root = document.documentElement;
        let theme = "auto";
        let surface = "default";
        try {
          theme = localStorage.getItem("neo-theme") ?? "auto";
          surface = localStorage.getItem("neo-surface") ?? "default";
        } catch {
          // Storage can throw in a locked-down browser; the defaults stand.
        }
        root.dataset.theme = theme;
        root.dataset.surface = surface;
        root.classList.toggle(
          "dark",
          theme === "dark"
            || (theme === "auto"
              && window.matchMedia("(prefers-color-scheme: dark)").matches),
        );
      })();
    </script>
  </head>

  <body class="flex min-h-dvh flex-col">
    <a
      href="#content"
      class="bg-inverted text-inverted sr-only rounded-md px-4 py-2 text-sm font-medium focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-30"
    >
      Skip to content
    </a>

    <header class="bg-default/80 border-muted sticky top-0 z-20 border-b backdrop-blur-md">
      <div
        class={`${shell} flex min-h-14 flex-wrap items-center gap-x-4 gap-y-2 py-2 sm:py-0`}
      >
        <a
          href="/"
          class="group hover:text-highlighted -mx-2 flex shrink-0 items-center gap-2.5 rounded-md px-2 py-1.5"
        >
          <img
            src="/logo-brand.svg"
            alt=""
            width="22"
            height="22"
            class="rounded-[0.3rem]"
          />
          <span class="text-highlighted text-sm font-semibold tracking-[-0.01em]">
            75NeoUI
          </span>
          <span
            class="border-muted text-dimmed hidden rounded-sm border px-1.5 py-0.5 font-mono text-[0.625rem] leading-none sm:inline"
            data-identifier
          >
            playground
          </span>
        </a>

        <div class="ml-auto flex items-center gap-3 sm:gap-5">
          {
            hasStage && (
              <>
                <SegmentedControl
                  name="surface"
                  label="surface"
                  options={[
                    { value: "default", label: "default" },
                    { value: "muted", label: "muted" },
                    { value: "elevated", label: "elevated" },
                  ]}
                />
                <span class="border-muted hidden h-5 border-l sm:block" />
              </>
            )
          }
          <SegmentedControl
            name="theme"
            label="theme"
            options={[
              { value: "light", label: "light" },
              { value: "dark", label: "dark" },
              { value: "auto", label: "auto" },
            ]}
          />
        </div>
      </div>

      <nav aria-label="Components" class="border-muted border-t">
        <div class={`${shell} -mb-px flex gap-1 overflow-x-auto`}>
          {
            [
              { href: "/", label: "Overview" },
              { href: "/tokens", label: "Tokens" },
              ...previews,
            ].map(({ href, label }) => (
              <a
                href={href}
                aria-current={current === href ? "page" : undefined}
                class:list={[
                  "border-b-2 px-2.5 py-2.5 text-sm whitespace-nowrap focus-visible:rounded-t-sm",
                  current === href
                    ? "border-primary text-highlighted font-medium"
                    : "text-muted hover:text-highlighted border-transparent",
                ]}
              >
                {label}
              </a>
            ))
          }
        </div>
      </nav>
    </header>

    <div class="border-muted border-b">
      <div class={`${shell} py-12 lg:py-16`}>
        <p class="text-dimmed font-mono text-xs tracking-wide" data-identifier>
          {eyebrow}
        </p>
        <h1
          class="text-highlighted mt-3 max-w-[16ch] text-4xl font-semibold tracking-[-0.035em] text-balance sm:text-5xl"
        >
          {title}
        </h1>
        <p class="text-muted mt-5 max-w-[62ch] text-base/7 text-pretty">
          {description}
        </p>
      </div>
    </div>

    <main id="content" class={`${shell} flex-1 py-12 lg:py-16`}>
      <slot />
    </main>

    <footer class="border-muted mt-8 border-t">
      <div
        class={`${shell} flex flex-wrap items-center justify-between gap-x-8 gap-y-3 py-8`}
      >
        <p class="text-dimmed max-w-[54ch] text-xs/6">
          Components render straight from <code class="text-muted" data-identifier>
            packages/*/src</code
          >, so what you see here is source, not a published build.
        </p>
        <a
          href="https://github.com/75Neo/ui"
          class="text-muted hover:text-highlighted rounded-sm font-mono text-xs"
          data-identifier
        >
          github.com/75Neo/ui
        </a>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const media = window.matchMedia("(prefers-color-scheme: dark)");

        const paint = () => {
          root.classList.toggle(
            "dark",
            root.dataset.theme === "dark"
              || (root.dataset.theme === "auto" && media.matches),
          );
          for (const button of document.querySelectorAll("[data-control]")) {
            const { control, value } = button.dataset;
            button.setAttribute(
              "aria-pressed",
              String(root.dataset[control] === value),
            );
          }
        };

        for (const button of document.querySelectorAll("[data-control]")) {
          button.addEventListener("click", () => {
            const { control, value } = button.dataset;
            root.dataset[control] = value;
            try {
              localStorage.setItem(`neo-${control}`, value);
            } catch {
              // Nothing to persist to; the choice still applies to this page.
            }
            paint();
          });
        }

        media.addEventListener("change", paint);
        paint();
      })();
    </script>
  </body>
</html>
