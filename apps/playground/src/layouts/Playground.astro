---
import { ClientRouter } from "astro:transitions";
import { PanelLeft } from "@lucide/astro";
import "../assets/css/main.css";
import Search from "../components/Search.astro";
import SegmentedControl from "../components/SegmentedControl.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Sidebar from "../components/Sidebar.astro";
import { iconButton } from "../lib/controls";
import { shell, stickyColumn } from "../lib/layout";

/**
 * The playground shell: a column of every page, and one page's specimens beside it.
 *
 * @remarks
 * The bar, the measure and the gutters are the ones the Header and the Container
 * render, so the workbench is built out of the same numbers as the components on it.
 * The column is carried across client-side navigations, so its scroll position and the
 * page's own are independent and neither is lost on the way to the next component.
 */
interface Props {
  title: string;
  description: string;
  /** Whether the page has a stage for the surface control to act on. */
  hasStage?: boolean;
}

const { title, description, hasStage = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · 75NeoUI playground</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · 75NeoUI playground`} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/logo-brand.svg" type="image/svg+xml" />
    <link rel="icon" href="/logo-brand.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/logo-brand.png" />

    <ClientRouter />

    <script is:inline>
      // Runs before first paint so the page never flashes the wrong theme.
      (() => {
        const root = document.documentElement;
        let theme = "auto";
        let surface = "default";
        try {
          theme = localStorage.getItem("neo-theme") ?? "auto";
          surface = localStorage.getItem("neo-surface") ?? "default";
        } catch {
          // Storage can throw in a locked-down browser; the defaults stand.
        }
        root.dataset.theme = theme;
        root.dataset.surface = surface;
        root.classList.toggle(
          "dark",
          theme === "dark"
            || (theme === "auto" && window.matchMedia("(prefers-color-scheme: dark)").matches),
        );
      })();
    </script>
  </head>

  <body class="bg-default text-default font-sans antialiased">
    <a
      href="#content"
      class="bg-inverted text-inverted sr-only rounded-md px-4 py-2 text-sm font-medium focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50"
    >
      Skip to content
    </a>

    <header
      class="border-default bg-default/75 sticky top-0 z-50 h-header border-b backdrop-blur-sm"
    >
      <div class="mx-auto flex h-full w-full max-w-page items-center gap-2 px-5 sm:px-8 lg:px-12">
        <button
          type="button"
          data-nav-toggle
          aria-expanded="false"
          aria-controls="page-nav"
          class={`${iconButton} -ms-1.5 lg:hidden`}
        >
          <PanelLeft aria-hidden="true" />
          <span class="sr-only">Navigation</span>
        </button>

        <a
          href="/"
          class="text-highlighted outline-primary/25 flex shrink-0 items-center gap-2 rounded-sm focus-visible:outline-3"
        >
          <img src="/logo-brand.svg" alt="" width="22" height="22" class="rounded-sm" />
          <span class="text-base font-bold tracking-tight">75NeoUI</span>
          <span
            class="bg-elevated text-dimmed hidden rounded-sm px-1.5 py-0.5 font-mono text-[0.6875rem] leading-none sm:inline"
            data-identifier
          >
            playground
          </span>
        </a>

        <div class="ms-auto flex min-w-0 items-center gap-1.5">
          <Search />
          {
            hasStage && (
              <SegmentedControl
                class="hidden md:flex"
                name="surface"
                label="Surface"
                options={[
                  { value: "default", label: "Default" },
                  { value: "muted", label: "Muted" },
                  { value: "elevated", label: "Elevated" },
                ]}
              />
            )
          }
          <ThemeToggle />
        </div>
      </div>
    </header>

    <div class={shell}>
      <div class="grid items-start lg:grid-cols-[15rem_minmax(0,1fr)]">
        <aside
          id="page-nav"
          data-page-nav
          data-column
          transition:persist="sidebar"
          data-open="false"
          class={`border-default border-b lg:border-b-0 lg:border-e lg:pe-4 ${stickyColumn}`}
        >
          <Sidebar path={path} />
        </aside>

        <main id="content" class="min-w-0 py-10 lg:ps-8">
          <h1 class="text-highlighted text-3xl font-semibold tracking-tight text-balance">
            {title}
          </h1>
          <p class="text-muted mt-2 max-w-[70ch] text-base/7 text-pretty">
            {description}
          </p>

          <slot />

          <p class="border-default text-dimmed mt-16 border-t pt-6 text-sm/6">
            Components render straight from <code class="text-muted" data-identifier
              >packages/*/src</code
            >, so what you see here is source, not a published build.
          </p>
        </main>
      </div>
    </div>

    <script>
      /**
       * The chrome's stateful controls, bound once for the whole visit.
       *
       * @remarks
       * Listeners are delegated from `document`, because a navigation replaces the body.
       * The choices are held here rather than read off the root element, whose attributes
       * a swap rewrites from the incoming document, and are put back on
       * `astro:after-swap` before the browser paints.
       */
      const root = document.documentElement;
      const media = window.matchMedia("(prefers-color-scheme: dark)");

      /** The current value of each control, keyed by the attribute it writes. */
      const chosen: Record<string, string> = {
        theme: root.dataset.theme ?? "auto",
        surface: root.dataset.surface ?? "default",
      };

      const apply = () => {
        for (const [control, value] of Object.entries(chosen)) root.dataset[control] = value;

        root.classList.toggle(
          "dark",
          chosen.theme === "dark" || (chosen.theme === "auto" && media.matches),
        );

        for (const button of document.querySelectorAll<HTMLElement>("[data-control]")) {
          const { control, value } = button.dataset;
          button.setAttribute("aria-pressed", String(!!control && chosen[control] === value));
        }

        for (const button of document.querySelectorAll<HTMLElement>("[data-theme-option]")) {
          button.setAttribute(
            "aria-checked",
            String(chosen.theme === button.dataset.themeOption),
          );
        }
      };

      /** The persisted column keeps the previous page's current row, so move it here. */
      const markCurrent = () => {
        const here = window.location.pathname.replace(/\/$/, "") || "/";
        for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-page-nav] a")) {
          const href = new URL(link.href).pathname.replace(/\/$/, "") || "/";
          if (href === here) link.setAttribute("aria-current", "page");
          else link.removeAttribute("aria-current");
        }
      };

      /**
       * Put every menu away. They are `details` elements, so this is one attribute
       * each, and `except` is the one the reader just clicked inside.
       */
      const closeMenus = (except?: Element | null) => {
        for (const menu of document.querySelectorAll<HTMLDetailsElement>("[data-menu]")) {
          if (menu !== except) menu.removeAttribute("open");
        }
      };

      document.addEventListener("click", (event) => {
        const target = event.target as HTMLElement | null;

        closeMenus(target?.closest("[data-menu]"));

        const mode = target?.closest<HTMLElement>("[data-theme-option]");
        if (mode?.dataset.themeOption) {
          chosen.theme = mode.dataset.themeOption;
          try {
            localStorage.setItem("neo-theme", chosen.theme);
          } catch {
            // Nothing to persist to; the choice still applies to this visit.
          }
          apply();
          closeMenus();
          return;
        }

        const option = target?.closest<HTMLElement>("[data-control]");
        if (option?.dataset.control && option.dataset.value) {
          const { control, value } = option.dataset;
          chosen[control] = value;
          try {
            localStorage.setItem(`neo-${control}`, value);
          } catch {
            // Nothing to persist to; the choice still applies to this visit.
          }
          apply();
          return;
        }

        const toggle = target?.closest<HTMLElement>("[data-nav-toggle]");
        if (toggle) {
          const panel = document.querySelector<HTMLElement>("[data-page-nav]");
          if (!panel) return;
          const open = panel.dataset.open !== "true";
          panel.dataset.open = String(open);
          toggle.setAttribute("aria-expanded", String(open));
          return;
        }

        // A tap on a link inside the narrow-layout navigation puts it away again.
        if (target?.closest("[data-page-nav] a")) {
          const panel = document.querySelector<HTMLElement>("[data-page-nav]");
          const button = document.querySelector<HTMLElement>("[data-nav-toggle]");
          if (panel && window.matchMedia("(width < 64rem)").matches) {
            panel.dataset.open = "false";
            button?.setAttribute("aria-expanded", "false");
          }
        }
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") closeMenus();
      });

      media.addEventListener("change", apply);
      document.addEventListener("astro:after-swap", () => {
        apply();
        markCurrent();
      });

      apply();
      markCurrent();
    </script>
  </body>
</html>
