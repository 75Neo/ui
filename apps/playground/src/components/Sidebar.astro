---
import { overview, previews } from "../routes";

/**
 * The column of every page in the playground.
 *
 * @remarks
 * The current row is painted from `aria-current` rather than from a class decided here.
 * This element is carried across navigations, so the markup arriving with the new page
 * is discarded and only an attribute a script can set moves the highlight.
 */
interface Props {
  /** The path the reader is on, so one row is already current on first paint. */
  path: string;
}

const { path } = Astro.props;

const sections = [
  { label: "Overview", links: overview },
  { label: "Components", links: previews },
];

const row =
  "text-muted hover:text-highlighted hover:bg-elevated outline-primary/25 block truncate rounded-md px-2 py-1.5 text-sm transition-colors focus-visible:outline-3";
---

<nav aria-label="Playground" class="flex flex-col gap-5 py-6">
  {
    sections.map(({ label, links }) => (
      <div>
        <p class="text-highlighted px-2 pb-1.5 text-sm font-semibold">{label}</p>
        <ul class="flex flex-col gap-px">
          {links.map(({ href, label: link }) => (
            <li>
              <a href={href} aria-current={path === href ? "page" : undefined} class={row}>
                {link}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</nav>
