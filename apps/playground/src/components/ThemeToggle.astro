---
import { Check, Monitor, Moon, Sun } from "@lucide/astro";
import { iconButton, panel, panelItem } from "../lib/controls";

/**
 * A three-way theme control, behind one button.
 *
 * @remarks
 * A `details` element rather than the library's own Menu, which stands in chrome both
 * routes and the landing page share. All three icons are rendered and `main.css`
 * reveals the one matching `data-theme` on the root element, so the trigger is right on
 * the first frame and after a navigation repaints nothing.
 */
const options = [
  { value: "light", label: "Light", icon: Sun },
  { value: "dark", label: "Dark", icon: Moon },
  { value: "auto", label: "System", icon: Monitor },
] as const;
---

<details data-menu data-theme-menu class="relative">
  <summary aria-label="Theme" class={`${iconButton} list-none`}>
    {
      options.map(({ value, icon: Icon }) => (
        <span data-theme-current={value}>
          <Icon size={16} aria-hidden="true" />
        </span>
      ))
    }
  </summary>

  <div role="menu" aria-label="Theme" class={`${panel} absolute end-0 top-full z-50 mt-1.5 w-36`}>
    {
      options.map(({ value, label, icon: Icon }) => (
        <button
          type="button"
          role="menuitemradio"
          aria-checked="false"
          data-theme-option={value}
          class={panelItem}
        >
          <Icon size={15} aria-hidden="true" class="text-dimmed shrink-0" />
          {label}
          <Check size={14} aria-hidden="true" class="text-primary ms-auto" data-theme-tick />
        </button>
      ))
    }
  </div>
</details>
