---
/**
 * A labelled group of exclusive options whose value lives on the root element as
 * `data-{name}`. The active segment is painted by attribute selectors in `main.css`, so
 * it is right on first paint and survives a navigation with nothing to repaint it.
 *
 * @remarks
 * The look is the SegmentGroup's: a recessed track, and the current segment lifted back
 * to the page's own surface.
 */

/**
 * One of the icon components the icon package ships. Taken off the package rather than
 * from Astro's own types: an `.astro` file's default export is not the factory type a
 * component boundary sees.
 */
type Icon = (typeof import("@lucide/astro"))["Sun"];

interface Props {
  /** Root data attribute this control writes, e.g. `theme` → `data-theme`. */
  name: string;
  label: string;
  /** An option shows its `icon` where it has one, and its `label` otherwise. */
  options: readonly { value: string; label: string; icon?: Icon }[];
  /** Where the control is shown, for the ones a narrow header has no room for. */
  class?: string;
}

const { name, label, options, class: className } = Astro.props;
---

<div class:list={["flex items-center gap-2", className]}>
  <span id={`${name}-label`} class="text-dimmed hidden text-xs xl:inline">{label}</span>
  <div
    role="group"
    aria-labelledby={`${name}-label`}
    class="bg-elevated flex items-center gap-0.5 rounded-md p-0.5"
  >
    {
      options.map(({ value, label: option, icon: Icon }) =>
        Icon ? (
          <button
            type="button"
            data-control={name}
            data-option={`${name}:${value}`}
            data-value={value}
            title={option}
            class="text-muted hover:text-highlighted outline-primary/25 grid size-6 cursor-pointer place-items-center rounded-sm transition-colors focus-visible:outline-3"
          >
            <Icon size={13} aria-hidden="true" />
            <span class="sr-only">{option}</span>
          </button>
        ) : (
          <button
            type="button"
            data-control={name}
            data-option={`${name}:${value}`}
            data-value={value}
            class="text-muted hover:text-highlighted outline-primary/25 cursor-pointer rounded-sm px-2 py-1 text-xs font-medium transition-colors focus-visible:outline-3"
          >
            {option}
          </button>
        ),
      )
    }
  </div>
</div>
