---
/**
 * One specimen stage: the same matrix rendered by both adapters, on the page's
 * current surface.
 *
 * @remarks
 * The section's notes sit above the frames rather than in a rail beside them. The
 * shell already spends a column on the page list, and the thing worth the remaining
 * width is the comparison: two adapters rendering the same matrix, wide enough that a
 * difference between them is a difference and not a wrap.
 */
interface Props {
  title: string;
  description: string;
  /** Facts read off the recipe, shown as a row of chips under the notes. */
  meta?: readonly { term: string; value: string }[];
}

const { title, description, meta = [] } = Astro.props;

const frameLabel = "text-highlighted font-mono text-xs leading-none";
const framePackage = "text-dimmed font-mono text-[0.625rem] leading-none";
const frameHeader =
  "bg-muted border-muted flex items-center justify-between gap-3 border-b px-4 py-2.5";
const stage = "p-5 sm:p-7";
---

<section class="mt-10">
  <h2 class="text-highlighted text-lg font-semibold tracking-[-0.02em]">{title}</h2>
  <p class="text-muted mt-2 max-w-[68ch] text-sm/6 text-pretty">{description}</p>

  {
    meta.length > 0 && (
      <dl class="mt-4 flex flex-wrap gap-x-2 gap-y-1.5">
        {meta.map(({ term, value }) => (
          <div class="border-muted flex items-baseline gap-2 rounded-lg border px-2 py-1">
            <dt class="text-dimmed font-mono text-xs" data-identifier>
              {term}
            </dt>
            <dd class="text-toned font-mono text-xs" data-identifier>
              {value}
            </dd>
          </div>
        ))}
      </dl>
    )
  }

  <div class="border-muted bg-default mt-5 overflow-hidden rounded-xl border">
    <div class="grid md:grid-cols-2">
      <article class="border-muted min-w-0 border-b md:border-r md:border-b-0">
        <header class={frameHeader}>
          <h3 class={frameLabel} data-identifier>react</h3>
          <span class={framePackage} data-identifier>@75neo/react</span>
        </header>
        <div data-stage class={stage}>
          <slot name="react" />
        </div>
      </article>

      <article class="min-w-0">
        <header class={frameHeader}>
          <h3 class={frameLabel} data-identifier>vue</h3>
          <span class={framePackage} data-identifier>@75neo/vue</span>
        </header>
        <div data-stage class={stage}>
          <slot name="vue" />
        </div>
      </article>
    </div>
  </div>
</section>
