---
/**
 * One specimen stage: the same matrix rendered by both adapters, on the page's current
 * surface. The notes sit above the frames rather than beside them, because the shell
 * already spends a column on the page list and the comparison is worth the rest.
 */
interface Props {
  title: string;
  description: string;
  /** Facts read off the recipe, shown as a row of chips under the notes. */
  meta?: readonly { term: string; value: string }[];
}

const { title, description, meta = [] } = Astro.props;

const frameLabel = "text-highlighted font-mono text-xs leading-none";
const framePackage = "text-dimmed font-mono text-[0.6875rem] leading-none";
const frameHeader =
  "bg-muted border-default flex items-center justify-between gap-3 border-b px-4 py-2.5";
const stage = "p-5 sm:p-7";
---

<section class="border-default mt-12 border-t pt-8">
  <h2 class="text-highlighted text-xl font-semibold tracking-tight">{title}</h2>
  <p class="text-muted mt-2 max-w-[70ch] text-base/7 text-pretty">{description}</p>

  {
    meta.length > 0 && (
      <dl class="mt-4 flex flex-wrap gap-x-2 gap-y-1.5">
        {meta.map(({ term, value }) => (
          <div class="bg-elevated flex items-baseline gap-2 rounded-md px-2 py-1">
            <dt class="text-dimmed font-mono text-xs" data-identifier>
              {term}
            </dt>
            <dd class="text-toned font-mono text-xs" data-identifier>
              {value}
            </dd>
          </div>
        ))}
      </dl>
    )
  }

  <div class="border-default bg-default mt-5 overflow-hidden rounded-lg border">
    <div class="grid md:grid-cols-2">
      <article class="border-default min-w-0 border-b md:border-e md:border-b-0">
        <header class={frameHeader}>
          <h3 class={frameLabel} data-identifier>react</h3>
          <span class={framePackage} data-identifier>@75neo/react</span>
        </header>
        <div data-stage class={stage}>
          <slot name="react" />
        </div>
      </article>

      <article class="min-w-0">
        <header class={frameHeader}>
          <h3 class={frameLabel} data-identifier>vue</h3>
          <span class={framePackage} data-identifier>@75neo/vue</span>
        </header>
        <div data-stage class={stage}>
          <slot name="vue" />
        </div>
      </article>
    </div>
  </div>
</section>
