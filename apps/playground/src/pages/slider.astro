---
import * as SliderParts from "@75neo/react/slider";
import { sliderSchema } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import SliderPreview from "../previews/SliderPreview.tsx";
import SliderPreviewVue from "../previews/SliderPreview.vue";

// Read off the module rather than restated here, so this ledger cannot drift.
const parts = Object.keys(SliderParts).filter((key) => !key.startsWith("use"));
const variantKeys = Object.keys(sliderSchema);
const combinations = variantKeys.reduce(
  (total, key) => total * (sliderSchema[key as keyof typeof sliderSchema].values.length as number),
  1,
);

const meta = [
  { term: "parts", value: parts.join(" · ") },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground title="Slider" description="A track, the part of it that is selected, and a thumb per value. One thumb per entry in the array, which is the whole of what makes a range slider.">
  <Preview
    title="Variant matrix"
    description="Every size, then all seven colors, then a label and readout, a range, marks, disabled and vertical. Both columns render the same matrix."
    meta={meta}
  >
    <Fragment slot="react"><SliderPreview client:load /></Fragment>
    <Fragment slot="vue"><SliderPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
