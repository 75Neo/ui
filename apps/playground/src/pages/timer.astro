---
import { timer, variantValues } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import TimerPreview from "../previews/TimerPreview.tsx";
import TimerPreviewVue from "../previews/TimerPreview.vue";

// Read off the recipe rather than restated here, so this ledger cannot drift.
const slots = Object.keys(timer.slots);
const variantKeys = [...timer.variantKeys];
const combinations = variantKeys.reduce(
  (total, key) => total * variantValues(timer, key).length,
  1,
);

const meta = [
  { term: "key", value: "timer" },
  { term: "slots", value: String(slots.length) },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  eyebrow="component"
  title="Timer"
  description="One recipe in @75neo/themes, rendered by both adapters. The units array draws the digits, their labels and the separators between them, and the buttons underneath drive the clock Ark keeps."
  hasStage
>
  <Preview
    title="Sizes, a countdown and renamed units"
    description="Three sizes frozen at a starting time, then a five-minute countdown with working buttons, then custom labels and a dotted separator."
    meta={meta}
  >
    <Fragment slot="react"><TimerPreview client:load /></Fragment>
    <Fragment slot="vue"><TimerPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
