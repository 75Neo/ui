---
import * as ComboboxParts from "@75neo/react/combobox";
import { comboboxSchema } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import ComboboxPreview from "../previews/ComboboxPreview.tsx";
import ComboboxPreviewVue from "../previews/ComboboxPreview.vue";

// Read off the module rather than restated here, so this ledger cannot drift.
const parts = Object.keys(ComboboxParts).filter((key) => !key.startsWith("use"));
const variantKeys = Object.keys(comboboxSchema);
const combinations = variantKeys.reduce(
  (total, key) =>
    total * (comboboxSchema[key as keyof typeof comboboxSchema].values.length as number),
  1,
);

const meta = [
  { term: "parts", value: parts.join(" · ") },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="Combobox"
  description="A text field that happens to open a list. The ring sits focus-within on the box around the input, and filtering narrows the options without ever leaving the component."
>
  <Preview
    title="Variant matrix"
    description="Every size, then all seven colors, then multiple and the empty state. Both columns render the same matrix, so anything that differs between them is a real difference between the adapters."
    meta={meta}
  >
    <Fragment slot="react"><ComboboxPreview client:load /></Fragment>
    <Fragment slot="vue"><ComboboxPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
