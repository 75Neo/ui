---
import { combobox, variantValues } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import ComboboxPreview from "../previews/ComboboxPreview.tsx";
import ComboboxPreviewVue from "../previews/ComboboxPreview.vue";

// Read off the recipe rather than restated here, so this ledger cannot drift.
const slots = Object.keys(combobox.slots);
const variantKeys = [...combobox.variantKeys];
const combinations = variantKeys.reduce(
  (total, key) => total * variantValues(combobox, key).length,
  1,
);

const meta = [
  { term: "key", value: "combobox" },
  { term: "slots", value: String(slots.length) },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="Combobox"
  description="One recipe in @75neo/themes, rendered by both adapters. The field owns its own filter, so a changed list of options reaches the popup on the next render in both frameworks."
  hasStage
>
  <Preview
    title="Sizes, accents and the ways it takes an answer"
    description="Three sizes, then every accent color, then the field opening on click, taking several answers, accepting text that matches nothing, and disabled. The last one is controlled and prints its own selection."
    meta={meta}
  >
    <Fragment slot="react"><ComboboxPreview client:load /></Fragment>
    <Fragment slot="vue"><ComboboxPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
