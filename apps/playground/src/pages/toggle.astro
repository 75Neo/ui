---
import * as ToggleParts from "@75neo/react/toggle";
import { toggleSchema } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import TogglePreview from "../previews/TogglePreview.tsx";
import TogglePreviewVue from "../previews/TogglePreview.vue";

// Read off the module rather than restated here, so this ledger cannot drift.
const parts = Object.keys(ToggleParts).filter((key) => !key.startsWith("use"));
const variantKeys = Object.keys(toggleSchema);
const combinations = variantKeys.reduce(
  (total, key) =>
    total * (toggleSchema[key as keyof typeof toggleSchema].values.length as number),
  1,
);

const meta = [
  { term: "parts", value: parts.join(" · ") },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="Toggle"
  description="A button that stays pressed. Five weights across seven colors, and the pressed state in every cell — the default weight is soft, so an unpressed toggle never shouts."
>
  <Preview
    title="Variant matrix"
    description="Every variant, then all seven colors, then pressed, icons and disabled. Both columns render the same matrix, so anything that differs between them is a real difference between the adapters."
    meta={meta}
  >
    <Fragment slot="react"><TogglePreview client:load /></Fragment>
    <Fragment slot="vue"><TogglePreviewVue client:load /></Fragment>
  </Preview>
</Playground>
