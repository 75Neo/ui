---
import * as ListboxParts from "@75neo/react/listbox";
import { listboxSchema } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import ListboxPreview from "../previews/ListboxPreview.tsx";
import ListboxPreviewVue from "../previews/ListboxPreview.vue";

// Read off the module rather than restated here, so this ledger cannot drift.
const parts = Object.keys(ListboxParts).filter((key) => !key.startsWith("use"));
const variantKeys = Object.keys(listboxSchema);
const combinations = variantKeys.reduce(
  (total, key) =>
    total * (listboxSchema[key as keyof typeof listboxSchema].values.length as number),
  1,
);

const meta = [
  { term: "parts", value: parts.join(" · ") },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="Listbox"
  description="An inline list of options with no trigger and no portal. A chosen row carries data-selected, and the frame is the same popup the Select drops."
>
  <Preview
    title="Variant matrix"
    description="Every size, then all seven colors, then multiple and the empty state. Both columns render the same matrix, so anything that differs between them is a real difference between the adapters."
    meta={meta}
  >
    <Fragment slot="react"><ListboxPreview client:load /></Fragment>
    <Fragment slot="vue"><ListboxPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
