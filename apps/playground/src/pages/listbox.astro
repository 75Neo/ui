---
import { listbox, variantValues } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import ListboxPreview from "../previews/ListboxPreview.tsx";
import ListboxPreviewVue from "../previews/ListboxPreview.vue";

// Read off the recipe rather than restated here, so this ledger cannot drift.
const slots = Object.keys(listbox.slots);
const variantKeys = [...listbox.variantKeys];
const combinations = variantKeys.reduce(
  (total, key) => total * variantValues(listbox, key).length,
  1,
);

const meta = [
  { term: "key", value: "listbox" },
  { term: "slots", value: String(slots.length) },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="Listbox"
  description="The Select's list without the button that opens it. It stays on the page at the width of its parent, holding one answer or several, and shares its item's three parts with the Select so the two read as one."
  hasStage
>
  <Preview
    title="Sizes, accents, selection modes and a controlled list"
    description="Three sizes, then the accent on the highlight and the chosen row, three ways of collecting answers, an empty and a disabled list, and one whose selection is owned outside the component."
    meta={meta}
  >
    <Fragment slot="react"><ListboxPreview client:load /></Fragment>
    <Fragment slot="vue"><ListboxPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
