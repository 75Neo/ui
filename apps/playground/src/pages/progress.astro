---
import { progress, variantValues } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import ProgressPreview from "../previews/ProgressPreview.tsx";
import ProgressPreviewVue from "../previews/ProgressPreview.vue";

// Read off the recipe rather than restated here, so this ledger cannot drift.
const slots = Object.keys(progress.slots);
const variantKeys = [...progress.variantKeys];
const combinations = variantKeys.reduce(
  (total, key) => total * variantValues(progress, key).length,
  1,
);

const meta = [
  { term: "key", value: "progress" },
  { term: "slots", value: String(slots.length) },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="Progress"
  description="One recipe in @75neo/themes, rendered by both adapters. Size is thickness rather than length, orientation is read off Ark's attribute, and a null value is the indeterminate state that sweeps instead of measuring."
  hasStage
>
  <Preview
    title="Sizes, colors and nothing to measure"
    description="Five thicknesses, then every color, then a labelled bar, an indeterminate one, one that moves on a timer and one that counts megabytes. The vertical set at the end sweeps down rather than across."
    meta={meta}
  >
    <Fragment slot="react"><ProgressPreview client:load /></Fragment>
    <Fragment slot="vue"><ProgressPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
