---
import { swap, variantValues } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import SwapPreview from "../previews/SwapPreview.tsx";
import SwapPreviewVue from "../previews/SwapPreview.vue";

// Read off the recipe rather than restated here, so this ledger cannot drift.
const slots = Object.keys(swap.slots);
const variantKeys = [...swap.variantKeys];
const combinations = variantKeys.reduce(
  (total, key) => total * variantValues(swap, key).length,
  1,
);

const meta = [
  { term: "key", value: "swap" },
  { term: "slots", value: String(slots.length) },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="Swap"
  description="One recipe in @75neo/themes, rendered by both adapters. One icon while on and another while off, with Ark's presence choosing which one the reader sees, so the state is a prop and never a variant."
  hasStage
>
  <Preview
    title="Sizes and a controlled flip"
    description="Three sizes showing both states at once, then one swap driven from a button outside the component."
    meta={meta}
  >
    <Fragment slot="react"><SwapPreview client:load /></Fragment>
    <Fragment slot="vue"><SwapPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
