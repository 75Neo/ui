---
import * as SwapParts from "@75neo/react/swap";
import { swapSchema } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import SwapPreview from "../previews/SwapPreview.tsx";
import SwapPreviewVue from "../previews/SwapPreview.vue";

// Read off the module rather than restated here, so this ledger cannot drift.
const parts = Object.keys(SwapParts).filter((key) => !key.startsWith("use"));
const variantKeys = Object.keys(swapSchema);
const combinations = variantKeys.reduce(
  (total, key) => total * (swapSchema[key as keyof typeof swapSchema].values.length as number),
  1,
);

const meta = [
  { term: "parts", value: parts.join(" · ") },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground title="Swap" description="One icon shown while on, another while off. Which one the reader sees is chosen by presence, so one class string covers both states.">
  <Preview
    title="Variant matrix"
    description="Every size, then off, then on, then a pair inside buttons that flip on click. Both columns render the same matrix."
    meta={meta}
  >
    <Fragment slot="react"><SwapPreview client:load /></Fragment>
    <Fragment slot="vue"><SwapPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
