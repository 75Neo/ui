---
import { error as recipe, variantValues } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import ErrorPreview from "../previews/ErrorPreview.tsx";
import ErrorPreviewVue from "../previews/ErrorPreview.vue";

// Read off the recipe rather than restated here, so this ledger cannot drift.
const slots = Object.keys(recipe.slots);
const variantKeys = [...recipe.variantKeys];
const combinations = variantKeys.reduce(
  (total, key) => total * variantValues(recipe, key).length,
  1,
);

const meta = [
  { term: "key", value: "error" },
  { term: "slots", value: String(slots.length) },
  { term: "variants", value: variantKeys.join(" · ") || "none" },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  eyebrow="component"
  title="Error"
  description="The page shown when there is nothing else to show. A status, a headline, a sentence and whatever way out the caller offers, centred in what the Header leaves behind."
  hasStage
>
  <Preview
    title="A full page, a bare status, and every colour"
    description="The colour reaches the status code and the icon and stops there, because an error page is already loud and colouring the sentence people are meant to read makes it harder."
    meta={meta}
  >
    <Fragment slot="react"><ErrorPreview client:load /></Fragment>
    <Fragment slot="vue"><ErrorPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
