---
import * as TableOfContentsParts from "@75neo/react/table-of-contents";
import { tableOfContentsSchema } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import TableOfContentsPreview from "../previews/TableOfContentsPreview.tsx";
import TableOfContentsPreviewVue from "../previews/TableOfContentsPreview.vue";

// Read off the module rather than restated here, so this ledger cannot drift.
const parts = Object.keys(TableOfContentsParts).filter((key) => !key.startsWith("use"));
const variantKeys = Object.keys(tableOfContentsSchema);
const combinations = variantKeys.reduce(
  (total, key) =>
    total * (tableOfContentsSchema[key as keyof typeof tableOfContentsSchema].values.length as number),
  1,
);

const meta = [
  { term: "parts", value: parts.join(" · ") },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="TableOfContents"
  description="A rail of heading links that follows the reading position, with an indicator that slides to the section on screen. Depth indents off the data-depth attribute, never a variant."
>
  <Preview
    title="Variant matrix"
    description="Every size and color against one set of headings, then a title-less rail. Both columns render the same matrix, so anything that differs between them is a real difference between the adapters."
    meta={meta}
  >
    <Fragment slot="react"><TableOfContentsPreview client:load /></Fragment>
    <Fragment slot="vue"><TableOfContentsPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
