---
import { radioGroup, variantValues } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import RadioGroupPreview from "../previews/RadioGroupPreview.tsx";
import RadioGroupPreviewVue from "../previews/RadioGroupPreview.vue";

// Read off the recipe rather than restated here, so this ledger cannot drift.
const slots = Object.keys(radioGroup.slots);
const variantKeys = [...radioGroup.variantKeys];
const combinations = variantKeys.reduce(
  (total, key) => total * variantValues(radioGroup, key).length,
  1,
);

const meta = [
  { term: "key", value: "radioGroup" },
  { term: "slots", value: String(slots.length) },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  eyebrow="component"
  title="RadioGroup"
  description="One recipe in @75neo/themes, rendered by both adapters. The Checkbox's anatomy repeated per option, with the dot drawn as a child of the control rather than by growing a border."
  hasStage
>
  <Preview
    title="Sizes, colors and two-line options"
    description="Five sizes, then every color, then options carrying a description, an invalid group and a disabled one. The last is controlled, so its legend can answer for the choice."
    meta={meta}
  >
    <Fragment slot="react"><RadioGroupPreview client:load /></Fragment>
    <Fragment slot="vue"><RadioGroupPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
