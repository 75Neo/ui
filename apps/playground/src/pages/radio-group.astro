---
import * as RadioGroupParts from "@75neo/react/radio-group";
import { radioGroupSchema } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import RadioGroupPreview from "../previews/RadioGroupPreview.tsx";
import RadioGroupPreviewVue from "../previews/RadioGroupPreview.vue";

// Read off the module rather than restated here, so this ledger cannot drift.
const parts = Object.keys(RadioGroupParts).filter((key) => !key.startsWith("use"));
const variantKeys = Object.keys(radioGroupSchema);
const combinations = variantKeys.reduce(
  (total, key) =>
    total * (radioGroupSchema[key as keyof typeof radioGroupSchema].values.length as number),
  1,
);

const meta = [
  { term: "parts", value: parts.join(" · ") },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="RadioGroup"
  description="One choice out of several, each with room for a second line. Orientation styles off the attribute Ark sets, and the legend hides itself in a row."
>
  <Preview
    title="Variant matrix"
    description="Every size, then all seven colors, then horizontal and disabled. Both columns render the same matrix, so anything that differs between them is a real difference between the adapters."
    meta={meta}
  >
    <Fragment slot="react"><RadioGroupPreview client:load /></Fragment>
    <Fragment slot="vue"><RadioGroupPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
