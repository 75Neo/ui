---
import { qrCode, variantValues } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import QrCodePreview from "../previews/QrCodePreview.tsx";
import QrCodePreviewVue from "../previews/QrCodePreview.vue";

// Read off the recipe rather than restated here, so this ledger cannot drift.
const slots = Object.keys(qrCode.slots);
const variantKeys = [...qrCode.variantKeys];
const combinations = variantKeys.reduce(
  (total, key) => total * variantValues(qrCode, key).length,
  1,
);

const meta = [
  { term: "key", value: "qrCode" },
  { term: "slots", value: String(slots.length) },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  eyebrow="component"
  title="QrCode"
  description="A code to scan, on a card carrying its quiet zone, across three sizes, wrapping Ark UI."
  hasStage
>
  <Preview
    title="Sizes"
    description="Three sizes with quiet zone margin scaling proportionally."
    meta={meta}
  >
    <Fragment slot="react"><QrCodePreview client:load /></Fragment>
    <Fragment slot="vue"><QrCodePreviewVue client:load /></Fragment>
  </Preview>
</Playground>
