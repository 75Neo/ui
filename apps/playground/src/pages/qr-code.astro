---
import * as QrCodeParts from "@75neo/react/qr-code";
import { qrCodeSchema } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import QrCodePreview from "../previews/QrCodePreview.tsx";
import QrCodePreviewVue from "../previews/QrCodePreview.vue";

// Read off the module rather than restated here, so this ledger cannot drift.
const parts = Object.keys(QrCodeParts).filter((key) => !key.startsWith("use"));
const variantKeys = Object.keys(qrCodeSchema);
const combinations = variantKeys.reduce(
  (total, key) => total * (qrCodeSchema[key as keyof typeof qrCodeSchema].values.length as number),
  1,
);

const meta = [
  { term: "parts", value: parts.join(" · ") },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground title="QrCode" description="A scannable code on a card carrying its quiet zone. The modules are the inverted tone and the card is the page, so it scans the same in either theme.">
  <Preview
    title="Variant matrix"
    description="Every size, then a logo overlaid on the code, then the download button beside it. Both columns render the same matrix."
    meta={meta}
  >
    <Fragment slot="react"><QrCodePreview client:load /></Fragment>
    <Fragment slot="vue"><QrCodePreviewVue client:load /></Fragment>
  </Preview>
</Playground>
