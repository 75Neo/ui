---
import { tabs, variantValues } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import TabsPreview from "../previews/TabsPreview.tsx";
import TabsPreviewVue from "../previews/TabsPreview.vue";

// Read off the recipe rather than restated here, so this ledger cannot drift.
const slots = Object.keys(tabs.slots);
const variantKeys = [...tabs.variantKeys];
const combinations = variantKeys.reduce((total, key) => total * variantValues(tabs, key).length, 1);

const meta = [
  { term: "key", value: "tabs" },
  { term: "slots", value: String(slots.length) },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="Tabs"
  description="One recipe in @75neo/themes, rendered by both adapters. Orientation is read off Ark's data-orientation rather than declared as a variant, and the indicator is one element that Ark places on one axis and the recipe places on the other."
  hasStage
>
  <Preview
    title="Two variants, three sizes, seven colors"
    description="Pill and link, then the sizes, then every color in both variants: a pill is a raised surface so the color goes on the selected label, a link has no surface so the color is the line. Then a vertical set, and one whose panels are rendered by the call site."
    meta={meta}
  >
    <Fragment slot="react"><TabsPreview client:load /></Fragment>
    <Fragment slot="vue"><TabsPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
