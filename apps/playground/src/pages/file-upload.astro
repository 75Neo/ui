---
import { fileUpload as recipe, variantValues } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import FileUploadPreview from "../previews/FileUploadPreview.tsx";
import FileUploadPreviewVue from "../previews/FileUploadPreview.vue";

// Read off the recipe rather than restated here, so this ledger cannot drift.
const slots = Object.keys(recipe.slots);
const variantKeys = [...recipe.variantKeys];
const combinations = variantKeys.reduce(
  (total, key) => total * variantValues(recipe, key).length,
  1,
);

const meta = [
  { term: "key", value: "fileUpload" },
  { term: "slots", value: String(slots.length) },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  eyebrow="component"
  title="FileUpload"
  description="One recipe in @75neo/themes, rendered by both adapters. The dropzone is the whole control rather than a strip beside a button, and the accent appears only while a file is over the window."
  hasStage
>
  <Preview
    title="Sizes, accents and what it will take"
    description="Three sizes, then every accent color, then images with thumbnails, images without, a document, and disabled. The last one is controlled and counts what it holds."
    meta={meta}
  >
    <Fragment slot="react"><FileUploadPreview client:load /></Fragment>
    <Fragment slot="vue"><FileUploadPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
