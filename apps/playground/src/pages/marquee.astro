---
import { marquee, variantValues } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import MarqueePreview from "../previews/MarqueePreview.tsx";
import MarqueePreviewVue from "../previews/MarqueePreview.vue";

// Read off the recipe rather than restated here, so this ledger cannot drift.
const slots = Object.keys(marquee.slots);
const variantKeys = [...marquee.variantKeys];
const combinations = variantKeys.reduce(
  (total, key) => total * variantValues(marquee, key).length,
  1,
);

const meta = [
  { term: "key", value: "marquee" },
  { term: "slots", value: String(slots.length) },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="Marquee"
  description="One recipe in @75neo/themes, rendered by both adapters. Ark owns the timing and writes it onto the root as custom properties; the recipe only names the keyframe, so one side variant picks the axis and one speed variant picks the pace."
  hasStage
>
  <Preview
    title="Sizes, speeds, edges and the vertical axis"
    description="Three sizes, then three named paces, then a loop with edge fades that stills on hover, and one scrolling down instead of across."
    meta={meta}
  >
    <Fragment slot="react"><MarqueePreview client:load /></Fragment>
    <Fragment slot="vue"><MarqueePreviewVue client:load /></Fragment>
  </Preview>
</Playground>
