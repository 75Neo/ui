---
import * as SegmentGroupParts from "@75neo/react/segment-group";
import { segmentGroupSchema } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import SegmentGroupPreview from "../previews/SegmentGroupPreview.tsx";
import SegmentGroupPreviewVue from "../previews/SegmentGroupPreview.vue";

// Read off the module rather than restated here, so this ledger cannot drift.
const parts = Object.keys(SegmentGroupParts).filter((key) => !key.startsWith("use"));
const variantKeys = Object.keys(segmentGroupSchema);
const combinations = variantKeys.reduce(
  (total, key) =>
    total * (segmentGroupSchema[key as keyof typeof segmentGroupSchema].values.length as number),
  1,
);

const meta = [
  { term: "parts", value: parts.join(" · ") },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="SegmentGroup"
  description="A row of choices under a pill that snaps to the checked one. Orientation places the row, and the pill carries no transition."
>
  <Preview
    title="Variant matrix"
    description="Every size, then all seven colors, then vertical and disabled. Both columns render the same matrix, so anything that differs between them is a real difference between the adapters."
    meta={meta}
  >
    <Fragment slot="react"><SegmentGroupPreview client:load /></Fragment>
    <Fragment slot="vue"><SegmentGroupPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
