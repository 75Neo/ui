---
import * as TooltipParts from "@75neo/react/tooltip";
import { tooltipSchema } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import TooltipPreview from "../previews/TooltipPreview.tsx";
import TooltipPreviewVue from "../previews/TooltipPreview.vue";

// Read off the module rather than restated here, so this ledger cannot drift.
const parts = Object.keys(TooltipParts).filter((key) => !key.startsWith("use"));
const variantKeys = Object.keys(tooltipSchema);
const combinations = variantKeys.reduce(
  (total, key) => total * (tooltipSchema[key as keyof typeof tooltipSchema].values.length as number),
  1,
);

const meta = [
  { term: "parts", value: parts.join(" · ") },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground title="Tooltip" description="A bubble that appears beside whatever it explains. The trigger is the caller's own element, handed to Ark with asChild, so it has to be focusable.">
  <Preview
    title="Variant matrix"
    description="Every size, then the four placements, then the arrow, then disabled. Both columns render the same matrix."
    meta={meta}
  >
    <Fragment slot="react"><TooltipPreview client:load /></Fragment>
    <Fragment slot="vue"><TooltipPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
