---
import { scrollArea, variantValues } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import ScrollAreaPreview from "../previews/ScrollAreaPreview.tsx";
import ScrollAreaPreviewVue from "../previews/ScrollAreaPreview.vue";

// Read off the recipe rather than restated here, so this ledger cannot drift.
const slots = Object.keys(scrollArea.slots);
const variantKeys = [...scrollArea.variantKeys];
const combinations = variantKeys.reduce(
  (total, key) => total * variantValues(scrollArea, key).length,
  1,
);

const meta = [
  { term: "key", value: "scrollArea" },
  { term: "slots", value: String(slots.length) },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="ScrollArea"
  description="A custom scrollable container that replaces native scrollbars with theme-styled ones, across three sizes, wrapping Ark UI."
  hasStage
>
  <Preview
    title="Sizes"
    description="Three sizes of scrollbars showing on hover, focus, or while scrolling."
    meta={meta}
  >
    <Fragment slot="react"><ScrollAreaPreview client:load /></Fragment>
    <Fragment slot="vue"><ScrollAreaPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
