---
import * as ScrollAreaParts from "@75neo/react/scroll-area";
import { scrollAreaSchema } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import ScrollAreaPreview from "../previews/ScrollAreaPreview.tsx";
import ScrollAreaPreviewVue from "../previews/ScrollAreaPreview.vue";

// Read off the module rather than restated here, so this ledger cannot drift.
const parts = Object.keys(ScrollAreaParts).filter((key) => !key.startsWith("use"));
const variantKeys = Object.keys(scrollAreaSchema);
const combinations = variantKeys.reduce(
  (total, key) => total * (scrollAreaSchema[key as keyof typeof scrollAreaSchema].values.length as number),
  1,
);

const meta = [
  { term: "parts", value: parts.join(" · ") },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground title="ScrollArea" description="A scrollable region with scrollbars of its own. The native bar is hidden and the styled one shows only while the pointer is over the region or it scrolls.">
  <Preview
    title="Variant matrix"
    description="Every size, then horizontal, then both directions with the corner between them. Both columns render the same matrix."
    meta={meta}
  >
    <Fragment slot="react"><ScrollAreaPreview client:load /></Fragment>
    <Fragment slot="vue"><ScrollAreaPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
