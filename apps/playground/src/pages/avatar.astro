---
import { avatar, variantValues } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import AvatarPreview from "../previews/AvatarPreview.tsx";
import AvatarPreviewVue from "../previews/AvatarPreview.vue";

// Read off the recipe rather than restated here, so this ledger cannot drift.
const slots = Object.keys(avatar.slots);
const variantKeys = [...avatar.variantKeys];
const combinations = variantKeys.reduce(
  (total, key) => total * variantValues(avatar, key).length,
  1,
);

const meta = [
  { term: "key", value: "avatar" },
  { term: "slots", value: String(slots.length) },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="Avatar"
  description="One recipe in @75neo/themes, rendered by both adapters. Neither adapter restates a class name, and neither does this page — the matrix below is read off the recipe at runtime."
  hasStage
>
  <Preview
    title="Variant matrix"
    description="Every shape against every size, then fallbacks, images, broken handling and custom image via renderImage (React) / #image (Vue) for NextImage and NuxtImg. Both columns render the same matrix, so anything that differs between them is a real difference between the adapters."
    meta={meta}
  >
    <Fragment slot="react"><AvatarPreview client:load /></Fragment>
    <Fragment slot="vue"><AvatarPreviewVue client:load /></Fragment>
  </Preview>

  <aside class="border-default mt-16 border-t pt-8 lg:mt-24">
    <div class="grid gap-6 lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-12">
      <h2 class="text-highlighted text-base font-semibold tracking-tight">
        Where this comes from
      </h2>
      <dl class="grid gap-x-12 gap-y-4 text-sm sm:grid-cols-2">
        {
          [
            {
              term: "packages/themes/src/components/avatar.ts",
              value: "The recipe, its slot and variant types, registry entry, and getAvatarInitials helper.",
            },
            {
              term: "packages/react/src/components/Avatar.tsx",
              value: "The React adapter — resolve the theme, render the slots, with renderImage for NextImage.",
            },
            {
              term: "packages/vue/src/components/Avatar.vue",
              value: "The Vue adapter, with props written out by hand and #image slot for NuxtImg.",
            },
            {
              term: "packages/core/src/utils/__tests__/resolve.test.ts",
              value: "The cascade order, asserted. That file is the specification.",
            },
          ].map(({ term, value }) => (
            <div>
              <dt class="text-toned font-mono text-xs break-all" data-identifier>
                {term}
              </dt>
              <dd class="text-muted mt-1.5 text-sm/6">{value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </aside>
</Playground>
