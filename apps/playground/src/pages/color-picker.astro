---
import { colorPicker, variantValues } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import ColorPickerPreview from "../previews/ColorPickerPreview.tsx";
import ColorPickerPreviewVue from "../previews/ColorPickerPreview.vue";

// Read off the recipe rather than restated here, so this ledger cannot drift.
const slots = Object.keys(colorPicker.slots);
const variantKeys = [...colorPicker.variantKeys];
const combinations = variantKeys.reduce(
  (total, key) => total * variantValues(colorPicker, key).length,
  1,
);

const meta = [
  { term: "key", value: "colorPicker" },
  { term: "slots", value: String(slots.length) },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="ColorPicker"
  description="One recipe in @75neo/themes, rendered by both adapters. Ark paints every gradient, the checkerboard and each thumb's fill from the current value, so the recipe supplies geometry and focus and no color at all."
  hasStage
>
  <Preview
    title="Sizes, accents and the optional parts"
    description="Three sizes, then every accent color with a row of presets, then alpha, the eyedropper, a picker with no hex field and a disabled one. The last picker is controlled and prints its own value."
    meta={meta}
  >
    <Fragment slot="react"><ColorPickerPreview client:load /></Fragment>
    <Fragment slot="vue"><ColorPickerPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
