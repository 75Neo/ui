---
import * as ColorPickerParts from "@75neo/react/color-picker";
import { colorPickerSchema } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import ColorPickerPreview from "../previews/ColorPickerPreview.tsx";
import ColorPickerPreviewVue from "../previews/ColorPickerPreview.vue";

// Read off the module rather than restated here, so this ledger cannot drift.
const parts = Object.keys(ColorPickerParts).filter((key) => !key.startsWith("use"));
const variantKeys = Object.keys(colorPickerSchema);
const combinations = variantKeys.reduce(
  (total, key) =>
    total * (colorPickerSchema[key as keyof typeof colorPickerSchema].values.length as number),
  1,
);

const meta = [
  { term: "parts", value: parts.join(" · ") },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="ColorPicker"
  description="An inline color picker with no color axis — it edits every color. Alpha, eyedropper and swatches compose around the area and sliders."
>
  <Preview
    title="Variant matrix"
    description="Every size, then alpha, input, eyedropper and swatches. Both columns render the same matrix, so anything that differs between them is a real difference between the adapters."
    meta={meta}
  >
    <Fragment slot="react"><ColorPickerPreview client:load /></Fragment>
    <Fragment slot="vue"><ColorPickerPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
