---
import { navigationMenu, variantValues } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import NavigationMenuPreview from "../previews/NavigationMenuPreview.tsx";
import NavigationMenuPreviewVue from "../previews/NavigationMenuPreview.vue";

// Read off the recipe rather than restated here, so this ledger cannot drift.
const slots = Object.keys(navigationMenu.slots);
const variantKeys = [...navigationMenu.variantKeys];
const combinations = variantKeys.reduce(
  (total, key) => total * variantValues(navigationMenu, key).length,
  1,
);

const meta = [
  { term: "key", value: "navigationMenu" },
  { term: "slots", value: String(slots.length) },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="NavigationMenu"
  description="A row of triggers, each opening a panel of links. Every panel is positioned against its own row rather than by a popper, so the recipe owns every coordinate and the bar runs either across the page or down it."
  hasStage
>
  <Preview
    title="Sizes, accents and both directions"
    description="Three sizes, then the accent on the highlighted and the current link, and a bar running down instead of across, with its panels opening to the side."
    meta={meta}
  >
    <Fragment slot="react"><NavigationMenuPreview client:load /></Fragment>
    <Fragment slot="vue"><NavigationMenuPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
