---
import * as NavigationMenuParts from "@75neo/react/navigation-menu";
import { navigationMenuSchema } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import NavigationMenuPreview from "../previews/NavigationMenuPreview.tsx";
import NavigationMenuPreviewVue from "../previews/NavigationMenuPreview.vue";

// Read off the module rather than restated here, so this ledger cannot drift.
const parts = Object.keys(NavigationMenuParts).filter((key) => !key.startsWith("use"));
const variantKeys = Object.keys(navigationMenuSchema);
const combinations = variantKeys.reduce(
  (total, key) => total * (navigationMenuSchema[key as keyof typeof navigationMenuSchema].values.length as number),
  1,
);

const meta = [
  { term: "parts", value: parts.join(" · ") },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground title="NavigationMenu" description="A row of triggers, each opening a panel of links. Each panel is positioned against its own row, so no positioning library is involved.">
  <Preview
    title="Variant matrix"
    description="Every size, then all seven colors, then the bar turned vertical. Both columns render the same matrix."
    meta={meta}
  >
    <Fragment slot="react"><NavigationMenuPreview client:load /></Fragment>
    <Fragment slot="vue"><NavigationMenuPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
