---
import { popover, variantValues } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import PopoverPreview from "../previews/PopoverPreview.tsx";
import PopoverPreviewVue from "../previews/PopoverPreview.vue";

// Read off the recipe rather than restated here, so this ledger cannot drift.
const slots = Object.keys(popover.slots);
const variantKeys = [...popover.variantKeys];
const combinations = variantKeys.reduce(
  (total, key) => total * variantValues(popover, key).length,
  1,
);

const meta = [
  { term: "key", value: "popover" },
  { term: "slots", value: String(slots.length) },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  eyebrow="component"
  title="Popover"
  description="One recipe in @75neo/themes, rendered by both adapters. The Dialog's anatomy on the Tooltip's geometry: a titled panel whose parts are addressed by name, anchored to whatever opened it."
  hasStage
>
  <Preview
    title="Sizes, placements and the way out"
    description="Three sizes, then the four sides with an arrow, then a close button, a modal panel and one that refuses Escape. The trigger is always the caller's own button rather than one wrapped around it."
    meta={meta}
  >
    <Fragment slot="react"><PopoverPreview client:load /></Fragment>
    <Fragment slot="vue"><PopoverPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
