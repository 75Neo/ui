---
import * as PopoverParts from "@75neo/react/popover";
import { popoverSchema } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import PopoverPreview from "../previews/PopoverPreview.tsx";
import PopoverPreviewVue from "../previews/PopoverPreview.vue";

// Read off the module rather than restated here, so this ledger cannot drift.
const parts = Object.keys(PopoverParts).filter((key) => !key.startsWith("use"));
const variantKeys = Object.keys(popoverSchema);
const combinations = variantKeys.reduce(
  (total, key) =>
    total * (popoverSchema[key as keyof typeof popoverSchema].values.length as number),
  1,
);

const meta = [
  { term: "parts", value: parts.join(" · ") },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="Popover"
  description="A small panel anchored to a trigger. The title and description pad for the cross when it is on, so the close variant is read by three parts, not one."
>
  <Preview
    title="Variant matrix"
    description="Every size, then the arrow, the cross, and a top placement. Both columns render the same matrix, so anything that differs between them is a real difference between the adapters."
    meta={meta}
  >
    <Fragment slot="react"><PopoverPreview client:load /></Fragment>
    <Fragment slot="vue"><PopoverPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
