---
import * as ClipboardParts from "@75neo/react/clipboard";
import { clipboardSchema } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import ClipboardPreview from "../previews/ClipboardPreview.tsx";
import ClipboardPreviewVue from "../previews/ClipboardPreview.vue";

// Read off the module rather than restated here, so this ledger cannot drift.
const parts = Object.keys(ClipboardParts).filter((key) => !key.startsWith("use"));
const variantKeys = Object.keys(clipboardSchema);
const combinations = variantKeys.reduce(
  (total, key) =>
    total * (clipboardSchema[key as keyof typeof clipboardSchema].values.length as number),
  1,
);

const meta = [
  { term: "parts", value: parts.join(" · ") },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="Clipboard"
  description="A read-only field holding a value, and a button that copies it. The color variant reaches the trigger only; the field around it is furniture."
>
  <Preview
    title="Variant matrix"
    description="Every size, then all seven trigger colors, then label, custom icons and disabled. Both columns render the same matrix, so anything that differs between them is a real difference between the adapters."
    meta={meta}
  >
    <Fragment slot="react"><ClipboardPreview client:load /></Fragment>
    <Fragment slot="vue"><ClipboardPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
