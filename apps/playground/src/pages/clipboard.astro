---
import { clipboard, variantValues } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import ClipboardPreview from "../previews/ClipboardPreview.tsx";
import ClipboardPreviewVue from "../previews/ClipboardPreview.vue";

// Read off the recipe rather than restated here, so this ledger cannot drift.
const slots = Object.keys(clipboard.slots);
const variantKeys = [...clipboard.variantKeys];
const combinations = variantKeys.reduce(
  (total, key) => total * variantValues(clipboard, key).length,
  1,
);

const meta = [
  { term: "key", value: "clipboard" },
  { term: "slots", value: String(slots.length) },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="Clipboard"
  description="One recipe in @75neo/themes, rendered by both adapters. The value is shown rather than hidden behind the button, and the copied state is an icon swap rather than a seventh color."
  hasStage
>
  <Preview
    title="Sizes, colors and a label"
    description="Three sizes, then the color variant on the trigger alone, then a labelled field. Copy any of them: the icon swaps for three seconds and swaps back on its own."
    meta={meta}
  >
    <Fragment slot="react"><ClipboardPreview client:load /></Fragment>
    <Fragment slot="vue"><ClipboardPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
