---
import { ArrowRight } from "@lucide/astro";
import Playground from "../layouts/Playground.astro";
import { previews } from "../routes";

const steps = [
  {
    path: "packages/themes/src/components/<name>.ts",
    note: "The recipe, its types, and the registry augmentation.",
  },
  {
    path: "packages/{react,vue}/src/components/<Name>",
    note: "One adapter file each. No styling logic in either.",
  },
  {
    path: "apps/playground/src/previews/",
    note: "A .tsx and a .vue preview, plus a route and a page.",
  },
  {
    path: "packages/themes/src/tokens/utilities.css",
    note: "Only when a recipe needs a color utility nothing else composes yet.",
  },
];
---

<Playground
  title="Every component, both frameworks"
  description="Each page renders one component twice, once through @75neo/react and once through @75neo/vue, from the same recipe in @75neo/themes. Edits to packages/*/src hot-reload here with no build step."
>
  <section aria-labelledby="components" class="mt-10">
    <h2 id="components" class="text-highlighted text-xl font-semibold tracking-tight">
      Components
    </h2>
    <p class="text-muted mt-2 max-w-[68ch] text-sm/6 text-pretty">
      The column on the left holds the same list. Press <kbd
        class="bg-elevated text-dimmed rounded-sm px-1.5 py-0.5 font-mono text-[0.6875rem]"
        data-identifier>⌘K</kbd
      > to jump to one by name.
    </p>

    <ul class="mt-6 grid gap-3 md:grid-cols-2 xl:grid-cols-3">
      {
        previews.map(({ href, label, summary, key }) => (
          <li class="border-default hover:bg-elevated/40 relative rounded-lg border px-4 py-3.5 transition-colors">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="text-highlighted text-sm font-semibold tracking-tight">
                <a href={href} class="after:absolute after:inset-0">
                  {label}
                </a>
              </h3>
              <span class="text-dimmed shrink-0 font-mono text-[0.6875rem]" data-identifier>
                {key}
              </span>
            </div>
            <p class="text-dimmed mt-1.5 text-xs/5 text-pretty">{summary}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="next" class="border-default mt-12 border-t pt-8">
    <h2 id="next" class="text-highlighted text-xl font-semibold tracking-tight">
      Adding the next component
    </h2>
    <p class="text-muted mt-2 max-w-[68ch] text-sm/6 text-pretty">
      Each one takes four files and lands in the list above on its own. The sequence is
      written out in <code class="text-toned font-mono text-xs" data-identifier>AGENTS.md</code
      >; what follows is the short version.
    </p>

    <ol class="divide-default border-default mt-5 max-w-[52rem] divide-y border-t">
      {
        steps.map(({ path, note }, index) => (
          <li class="flex gap-5 py-3.5">
            <span class="text-dimmed w-4 shrink-0 pt-px font-mono text-xs" data-identifier>
              {index + 1}
            </span>
            <div class="min-w-0">
              <p class="text-toned font-mono text-xs break-all" data-identifier>
                {path}
              </p>
              <p class="text-muted mt-1 text-sm/6">{note}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <a
      href="/tokens"
      class="text-muted hover:text-highlighted mt-6 inline-flex items-center gap-2 rounded-sm text-sm font-medium"
    >
      The tokens a recipe may compose
      <ArrowRight size={15} aria-hidden="true" />
    </a>
  </section>
</Playground>
