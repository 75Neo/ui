---
import { accordion, variantValues } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import AccordionPreview from "../previews/AccordionPreview.tsx";
import AccordionPreviewVue from "../previews/AccordionPreview.vue";

// Read off the recipe rather than restated here, so this ledger cannot drift.
const slots = Object.keys(accordion.slots);
const variantKeys = [...accordion.variantKeys];
const combinations = variantKeys.reduce(
  (total, key) => total * variantValues(accordion, key).length,
  1,
);

const meta = [
  { term: "key", value: "accordion" },
  { term: "slots", value: String(slots.length) },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="Accordion"
  description="The first component to wrap Ark UI. Its anatomy stays hidden behind one items prop, so both adapters expose the same surface and neither restates a class name. Orientation is styled from data-orientation rather than declared as a variant, which keeps the matrix below at nine."
  hasStage
>
  <Preview
    title="Variant matrix"
    description="Every variant, then the size scale, then the behaviours Ark drives — multiple, collapsible, disabled, a single disabled item, the render escape hatch, and horizontal. Both columns render the same matrix, so anything that differs between them is a real difference between the adapters."
    meta={meta}
  >
    <Fragment slot="react"><AccordionPreview client:load /></Fragment>
    <Fragment slot="vue"><AccordionPreviewVue client:load /></Fragment>
  </Preview>

  <aside class="border-muted mt-16 border-t pt-8 lg:mt-24">
    <div class="grid gap-6 lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-12">
      <h2 class="text-highlighted text-base font-semibold tracking-[-0.015em]">
        Where this comes from
      </h2>
      <dl class="grid gap-x-12 gap-y-4 text-sm sm:grid-cols-2">
        {
          [
            {
              term: "packages/themes/src/components/accordion.ts",
              value: "The recipe, its slot and variant types, and the registry entry.",
            },
            {
              term: "packages/react/src/components/Accordion.tsx",
              value: "The React adapter — Ark's parts, wearing the recipe's slots.",
            },
            {
              term: "packages/vue/src/components/Accordion.vue",
              value: "The Vue adapter, with props written out by hand.",
            },
            {
              term: "packages/themes/src/tokens/keyframes.css",
              value: "The expand and collapse keyframes, driven by a measured size.",
            },
          ].map(({ term, value }) => (
            <div>
              <dt class="text-toned font-mono text-xs break-all" data-identifier>
                {term}
              </dt>
              <dd class="text-muted mt-1.5 text-sm/6">{value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </aside>
</Playground>
