---
import * as AccordionParts from "@75neo/react/accordion";
import { accordionSchema } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import AccordionPreview from "../previews/AccordionPreview.tsx";
import AccordionPreviewVue from "../previews/AccordionPreview.vue";

// Read off the module rather than restated here, so this ledger cannot drift.
const parts = Object.keys(AccordionParts).filter((key) => !key.startsWith("use"));
const variantKeys = Object.keys(accordionSchema);
const combinations = variantKeys.reduce(
  (total, key) =>
    total * (accordionSchema[key as keyof typeof accordionSchema].values.length as number),
  1,
);

const meta = [
  { term: "parts", value: parts.join(" · ") },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="Accordion"
  description="Composed anatomy parts around Ark UI for keyboard and ARIA behaviour. The root publishes variant and size through context; every part reads them into its own cva. Orientation is styled from data-orientation rather than declared as a variant, which keeps the matrix below at nine."
>
  <Preview
    title="Variant matrix"
    description="Every variant, then the size scale, then the behaviours Ark drives — multiple, collapsible, disabled, a single disabled item, replaceable icon glyphs, and horizontal. Both columns render the same matrix, so anything that differs between them is a real difference between the adapters."
    meta={meta}
  >
    <Fragment slot="react"><AccordionPreview client:load /></Fragment>
    <Fragment slot="vue"><AccordionPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
