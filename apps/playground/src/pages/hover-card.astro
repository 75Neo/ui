---
import { hoverCard, variantValues } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import HoverCardPreview from "../previews/HoverCardPreview.tsx";
import HoverCardPreviewVue from "../previews/HoverCardPreview.vue";

// Read off the recipe rather than restated here, so this ledger cannot drift.
const slots = Object.keys(hoverCard.slots);
const variantKeys = [...hoverCard.variantKeys];
const combinations = variantKeys.reduce(
  (total, key) => total * variantValues(hoverCard, key).length,
  1,
);

const meta = [
  { term: "key", value: "hoverCard" },
  { term: "slots", value: String(slots.length) },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  eyebrow="component"
  title="HoverCard"
  description="A preview panel popped up when hovering or focusing a trigger, across three sizes and twelve placements, wrapping Ark UI."
  hasStage
>
  <Preview
    title="Sizes and a controlled card"
    description="Three sizes with an optional arrow, and one whose open state is held outside the component."
    meta={meta}
  >
    <Fragment slot="react"><HoverCardPreview client:load /></Fragment>
    <Fragment slot="vue"><HoverCardPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
