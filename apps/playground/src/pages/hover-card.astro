---
import * as HoverCardParts from "@75neo/react/hover-card";
import { hoverCardSchema } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import HoverCardPreview from "../previews/HoverCardPreview.tsx";
import HoverCardPreviewVue from "../previews/HoverCardPreview.vue";

// Read off the module rather than restated here, so this ledger cannot drift.
const parts = Object.keys(HoverCardParts).filter((key) => !key.startsWith("use"));
const variantKeys = Object.keys(hoverCardSchema);
const combinations = variantKeys.reduce(
  (total, key) =>
    total * (hoverCardSchema[key as keyof typeof hoverCardSchema].values.length as number),
  1,
);

const meta = [
  { term: "parts", value: parts.join(" · ") },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="HoverCard"
  description="A small panel appearing beside whatever it describes. The popover's sibling without a cross: hover opens it, leaving closes it."
>
  <Preview
    title="Variant matrix"
    description="Every size, then the arrow. Both columns render the same matrix, so anything that differs between them is a real difference between the adapters."
    meta={meta}
  >
    <Fragment slot="react"><HoverCardPreview client:load /></Fragment>
    <Fragment slot="vue"><HoverCardPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
