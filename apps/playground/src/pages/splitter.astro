---
import * as SplitterParts from "@75neo/react/splitter";
import { splitterSchema } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import SplitterPreview from "../previews/SplitterPreview.tsx";
import SplitterPreviewVue from "../previews/SplitterPreview.vue";

// Read off the module rather than restated here, so this ledger cannot drift.
const parts = Object.keys(SplitterParts).filter((key) => !key.startsWith("use"));
const variantKeys = Object.keys(splitterSchema);
const combinations = variantKeys.reduce(
  (total, key) => total * (splitterSchema[key as keyof typeof splitterSchema].values.length as number),
  1,
);

const meta = [
  { term: "parts", value: parts.join(" · ") },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground title="Splitter" description="Resizable panels divided by draggable handles. The handle is a roomy invisible bar with a small visible pill, so the grab target stays generous on touch.">
  <Preview
    title="Variant matrix"
    description="Every handle size, then three panels, then vertical, then a disabled pair. Both columns render the same matrix."
    meta={meta}
  >
    <Fragment slot="react"><SplitterPreview client:load /></Fragment>
    <Fragment slot="vue"><SplitterPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
