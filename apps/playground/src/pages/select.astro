---
import * as SelectParts from "@75neo/react/select";
import { selectSchema } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import SelectPreview from "../previews/SelectPreview.tsx";
import SelectPreviewVue from "../previews/SelectPreview.vue";

// Read off the module rather than restated here, so this ledger cannot drift.
const parts = Object.keys(SelectParts).filter((key) => !key.startsWith("use"));
const variantKeys = Object.keys(selectSchema);
const combinations = variantKeys.reduce(
  (total, key) =>
    total * (selectSchema[key as keyof typeof selectSchema].values.length as number),
  1,
);

const meta = [
  { term: "parts", value: parts.join(" · ") },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="Select"
  description="A button showing the current answer, and the list it opens. The root publishes color and size through context; the chevron's spin is the indicator's own prop."
>
  <Preview
    title="Variant matrix"
    description="Every size, then all seven colors, then multiple and disabled. Both columns render the same matrix, so anything that differs between them is a real difference between the adapters."
    meta={meta}
  >
    <Fragment slot="react"><SelectPreview client:load /></Fragment>
    <Fragment slot="vue"><SelectPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
