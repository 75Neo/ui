---
import { treeView, variantValues } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import TreeViewPreview from "../previews/TreeViewPreview.tsx";
import TreeViewPreviewVue from "../previews/TreeViewPreview.vue";

// Read off the recipe rather than restated here, so this ledger cannot drift.
const slots = Object.keys(treeView.slots);
const variantKeys = [...treeView.variantKeys];
const combinations = variantKeys.reduce(
  (total, key) => total * variantValues(treeView, key).length,
  1,
);

const meta = [
  { term: "key", value: "treeView" },
  { term: "slots", value: String(slots.length) },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  eyebrow="component"
  title="TreeView"
  description="A file tree of branches and leaves from one flat array of items: a node with children is a branch, anything else a leaf. Ark writes the depth and this recipe indents off it, so nesting needs no variant."
  hasStage
>
  <Preview
    title="Single, multiple, sizes, and the guide line"
    description="A single-select tree and a multiple one, three sizes, and a tree with the indent guide turned off. Branches and leaves share one row look in every case."
    meta={meta}
  >
    <Fragment slot="react"><TreeViewPreview client:load /></Fragment>
    <Fragment slot="vue"><TreeViewPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
