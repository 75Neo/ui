---
import * as RatingGroupParts from "@75neo/react/rating-group";
import { ratingGroupSchema } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import RatingGroupPreview from "../previews/RatingGroupPreview.tsx";
import RatingGroupPreviewVue from "../previews/RatingGroupPreview.vue";

// Read off the module rather than restated here, so this ledger cannot drift.
const parts = Object.keys(RatingGroupParts).filter((key) => !key.startsWith("use"));
const variantKeys = Object.keys(ratingGroupSchema);
const combinations = variantKeys.reduce(
  (total, key) =>
    total * (ratingGroupSchema[key as keyof typeof ratingGroupSchema].values.length as number),
  1,
);

const meta = [
  { term: "parts", value: parts.join(" · ") },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="RatingGroup"
  description="Stars that fill whole or half. A half star is the same star clipped down the middle, filling from the inline start under right-to-left locales."
>
  <Preview
    title="Variant matrix"
    description="Every size, then all seven colors, then halves and disabled. Both columns render the same matrix, so anything that differs between them is a real difference between the adapters."
    meta={meta}
  >
    <Fragment slot="react"><RatingGroupPreview client:load /></Fragment>
    <Fragment slot="vue"><RatingGroupPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
