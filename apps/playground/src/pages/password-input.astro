---
import { passwordInput, variantValues } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import PasswordInputPreview from "../previews/PasswordInputPreview.tsx";
import PasswordInputPreviewVue from "../previews/PasswordInputPreview.vue";

// Read off the recipe rather than restated here, so this ledger cannot drift.
const slots = Object.keys(passwordInput.slots);
const variantKeys = [...passwordInput.variantKeys];
const combinations = variantKeys.reduce(
  (total, key) => total * variantValues(passwordInput, key).length,
  1,
);

const meta = [
  { term: "key", value: "passwordInput" },
  { term: "slots", value: String(slots.length) },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="PasswordInput"
  description="A field holding a secret and the button that shows it. The eye is Ark's indicator part, which swaps the two icons itself, so the adapter hands over both and never reads the state they stand for."
  hasStage
>
  <Preview
    title="Sizes, accents, states and a controlled eye"
    description="Three sizes, then the accent on the field's focus ring, a new-password autocomplete, three field states, and one whose visibility is owned outside the component."
    meta={meta}
  >
    <Fragment slot="react"><PasswordInputPreview client:load /></Fragment>
    <Fragment slot="vue"><PasswordInputPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
