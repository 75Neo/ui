---
import * as PasswordInputParts from "@75neo/react/password-input";
import { passwordInputSchema } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import PasswordInputPreview from "../previews/PasswordInputPreview.tsx";
import PasswordInputPreviewVue from "../previews/PasswordInputPreview.vue";

// Read off the module rather than restated here, so this ledger cannot drift.
const parts = Object.keys(PasswordInputParts).filter((key) => !key.startsWith("use"));
const variantKeys = Object.keys(passwordInputSchema);
const combinations = variantKeys.reduce(
  (total, key) =>
    total * (passwordInputSchema[key as keyof typeof passwordInputSchema].values.length as number),
  1,
);

const meta = [
  { term: "parts", value: parts.join(" · ") },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="PasswordInput"
  description="A secret field with a visibility toggle. Ark shows the visible glyph or the hidden one; the adapter never reads the state itself."
>
  <Preview
    title="Variant matrix"
    description="Every size, then all seven colors, then states. Both columns render the same matrix, so anything that differs between them is a real difference between the adapters."
    meta={meta}
  >
    <Fragment slot="react"><PasswordInputPreview client:load /></Fragment>
    <Fragment slot="vue"><PasswordInputPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
