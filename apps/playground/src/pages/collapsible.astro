---
import * as CollapsibleParts from "@75neo/react/collapsible";
import { collapsibleSchema } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import CollapsiblePreview from "../previews/CollapsiblePreview.tsx";
import CollapsiblePreviewVue from "../previews/CollapsiblePreview.vue";

// Read off the module rather than restated here, so this ledger cannot drift.
const parts = Object.keys(CollapsibleParts).filter((key) => !key.startsWith("use"));
const variantKeys = Object.keys(collapsibleSchema);
const combinations = variantKeys.reduce(
  (total, key) => total * (collapsibleSchema[key as keyof typeof collapsibleSchema].values.length as number),
  1,
);

const meta = [
  { term: "parts", value: parts.join(" · ") },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground title="Collapsible" description="One trigger and the panel it opens. Accordion's row without the accordion around it, wearing the same three variants and the same three sizes.">
  <Preview
    title="Variant matrix"
    description="Every variant, then every size, then disabled, then a collapsed height turning it into a show-more. Both columns render the same matrix."
    meta={meta}
  >
    <Fragment slot="react"><CollapsiblePreview client:load /></Fragment>
    <Fragment slot="vue"><CollapsiblePreviewVue client:load /></Fragment>
  </Preview>
</Playground>
