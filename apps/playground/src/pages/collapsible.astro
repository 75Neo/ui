---
import { collapsible, variantValues } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import CollapsiblePreview from "../previews/CollapsiblePreview.tsx";
import CollapsiblePreviewVue from "../previews/CollapsiblePreview.vue";

// Read off the recipe rather than restated here, so this ledger cannot drift.
const slots = Object.keys(collapsible.slots);
const variantKeys = [...collapsible.variantKeys];
const combinations = variantKeys.reduce(
  (total, key) => total * variantValues(collapsible, key).length,
  1,
);

const meta = [
  { term: "key", value: "collapsible" },
  { term: "slots", value: String(slots.length) },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  eyebrow="component"
  title="Collapsible"
  description="One recipe in @75neo/themes, rendered by both adapters. Accordion's row without the accordion around it: the same three variants, the same three sizes, and the same open and close keyframes."
  hasStage
>
  <Preview
    title="Variants, sizes and a peek"
    description="Three variants, then three sizes, then a disabled panel and one given a collapsed height, which clips the content instead of hiding it. The last is driven from a button outside the component."
    meta={meta}
  >
    <Fragment slot="react"><CollapsiblePreview client:load /></Fragment>
    <Fragment slot="vue"><CollapsiblePreviewVue client:load /></Fragment>
  </Preview>
</Playground>
