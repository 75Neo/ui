---
import { tour, variantValues } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import TourPreview from "../previews/TourPreview.tsx";
import TourPreviewVue from "../previews/TourPreview.vue";

// Read off the recipe rather than restated here, so this ledger cannot drift.
const slots = Object.keys(tour.slots);
const variantKeys = [...tour.variantKeys];
const combinations = variantKeys.reduce(
  (total, key) => total * variantValues(tour, key).length,
  1,
);

const meta = [
  { term: "key", value: "tour" },
  { term: "slots", value: String(slots.length) },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="Tour"
  description="A spotlight onboarding flow: the Dialog's panel on the Popover's geometry, with a backdrop and a ring around each step's target. The steps live in Ark's useTour next to their targets; this component only styles the anatomy."
  hasStage
>
  <Preview
    title="A dialog, two tooltips, and three panel sizes"
    description="One tour opens as a dialog, anchors to each button in turn, and reports its position back. Below, the same three steps start again in every panel size."
    meta={meta}
  >
    <Fragment slot="react"><TourPreview client:load /></Fragment>
    <Fragment slot="vue"><TourPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
