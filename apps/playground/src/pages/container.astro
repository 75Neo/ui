---
import { container as recipe } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import ContainerPreview from "../previews/ContainerPreview.tsx";
import ContainerPreviewVue from "../previews/ContainerPreview.vue";

// Read off the recipe rather than restated here, so this ledger cannot drift.
const slots = Object.keys(recipe.slots);

// The recipe declares no variant, so there is no matrix to count and no row for one.
const meta = [
  { term: "key", value: "container" },
  { term: "slots", value: String(slots.length) },
  { term: "variants", value: "none" },
];
---

<Playground
  eyebrow="component"
  title="Container"
  description="The measure every page's content is held to, and the gutter that keeps it off the edge. One slot and no variants, so the Header, the Footer and the page body all line up without any of them naming a width."
  hasStage
>
  <Preview
    title="Three measures, one token"
    description="The same Container at three values of --ui-container. Nothing here sets a width: the token moves and every Container follows it."
    meta={meta}
  >
    <Fragment slot="react"><ContainerPreview client:load /></Fragment>
    <Fragment slot="vue"><ContainerPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
