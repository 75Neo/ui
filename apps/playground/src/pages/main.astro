---
import * as MainParts from "@75neo/react/main";
import { mainSchema } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import MainPreview from "../previews/MainPreview.tsx";
import MainPreviewVue from "../previews/MainPreview.vue";

// Read off the module rather than restated here, so this ledger cannot drift.
const parts = Object.keys(MainParts).filter((key) => !key.startsWith("use"));
const variantKeys = Object.keys(mainSchema);
const combinations = variantKeys.reduce(
  (total, key) => total * (mainSchema[key as keyof typeof mainSchema].values.length as number),
  1,
);

const meta = [
  { term: "parts", value: parts.join(" · ") },
  { term: "variants", value: variantKeys.length > 0 ? variantKeys.join(" · ") : "none" },
  { term: "combinations", value: String(combinations) },
];
---

<Playground title="Main" description="The content region, sized to fill what the Header leaves. Without it a short page leaves the Footer floating in the middle of the screen.">
  <Preview
    title="Variant matrix"
    description="The region at its natural height, shown short here. Both columns render the same matrix."
    meta={meta}
  >
    <Fragment slot="react"><MainPreview client:load /></Fragment>
    <Fragment slot="vue"><MainPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
