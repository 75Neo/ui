---
import { main as recipe } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import MainPreview from "../previews/MainPreview.tsx";
import MainPreviewVue from "../previews/MainPreview.vue";

// Read off the recipe rather than restated here, so this ledger cannot drift.
const slots = Object.keys(recipe.slots);

// The recipe declares no variant, so there is no matrix to count and no row for one.
const meta = [
  { term: "key", value: "main" },
  { term: "slots", value: String(slots.length) },
  { term: "variants", value: "none" },
];
---

<Playground
  eyebrow="component"
  title="Main"
  description="The page's content region, tall enough to push a Footer to the bottom of the screen. It claims the viewport less the Header, which is the one measurement it cannot take for itself."
  hasStage
>
  <Preview
    title="A short page and a long one"
    description="Identical chrome around one paragraph and around eight. The Footer is at the bottom in both, which is the whole of what this component does."
    meta={meta}
  >
    <Fragment slot="react"><MainPreview client:load /></Fragment>
    <Fragment slot="vue"><MainPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
