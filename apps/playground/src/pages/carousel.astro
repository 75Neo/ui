---
import { carousel, variantValues } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import CarouselPreview from "../previews/CarouselPreview.tsx";
import CarouselPreviewVue from "../previews/CarouselPreview.vue";

// Read off the recipe rather than restated here, so this ledger cannot drift.
const slots = Object.keys(carousel.slots);
const variantKeys = [...carousel.variantKeys] as string[];
const combinations = variantKeys.length
  ? variantKeys.reduce(
      (total, key) => total * (variantValues as (r: unknown, k: string) => unknown[])(carousel, key).length,
      1,
    )
  : 1;

const meta = [
  { term: "key", value: "carousel" },
  { term: "slots", value: String(slots.length) },
  { term: "variants", value: variantKeys.length ? variantKeys.join(" · ") : "—" },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="Carousel"
  description="One recipe in @75neo/themes, rendered by both adapters. Wraps Ark UI's embla carousel with one items prop and an escaped render slot, so neither adapter restates a class name and the two previews stay in lockstep."
  hasStage
>
  <Preview
    title="Behaviour matrix"
    description="Default, loop, autoplay, slidesPerPage, spacing, vertical orientation, mouse drag, the render escape hatch and a controlled page. Both columns render the same matrix, so anything that differs between them is a real difference between the adapters."
    meta={meta}
  >
    <Fragment slot="react"><CarouselPreview client:load /></Fragment>
    <Fragment slot="vue"><CarouselPreviewVue client:load /></Fragment>
  </Preview>

  <aside class="border-muted mt-16 border-t pt-8 lg:mt-24">
    <div class="grid gap-6 lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-12">
      <h2 class="text-highlighted text-base font-semibold tracking-[-0.015em]">
        Where this comes from
      </h2>
      <dl class="grid gap-x-12 gap-y-4 text-sm sm:grid-cols-2">
        {
          [
            {
              term: "packages/themes/src/components/carousel.ts",
              value: "The recipe, its slot and variant types, and the registry entry.",
            },
            {
              term: "packages/react/src/components/Carousel.tsx",
              value: "The React adapter — Ark's parts, wearing the recipe's slots.",
            },
            {
              term: "packages/vue/src/components/Carousel.vue",
              value: "The Vue adapter, with props written out by hand.",
            },
            {
              term: "packages/core/src/utils/__tests__/resolve.test.ts",
              value: "The cascade order, asserted. That file is the specification.",
            },
          ].map(({ term, value }) => (
            <div>
              <dt class="text-toned font-mono text-xs break-all" data-identifier>
                {term}
              </dt>
              <dd class="text-muted mt-1.5 text-sm/6">{value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </aside>
</Playground>
