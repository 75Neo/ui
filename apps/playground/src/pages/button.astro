---
import * as ButtonParts from "@75neo/react/button";
import { buttonSchema } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import ButtonPreview from "../previews/ButtonPreview.tsx";
import ButtonPreviewVue from "../previews/ButtonPreview.vue";

// Read off the module rather than restated here, so this ledger cannot drift.
const parts = Object.keys(ButtonParts).filter((key) => !key.startsWith("use"));
const variantKeys = Object.keys(buttonSchema);
const combinations = variantKeys.reduce(
  (total, key) =>
    total * (buttonSchema[key as keyof typeof buttonSchema].values.length as number),
  1,
);

const meta = [
  { term: "parts", value: parts.join(" · ") },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="Button"
  description="One part carrying the whole colour system: six variants across seven colors, forty-two compound cells generated by six eachColor calls and one hand-written neutral row. The call-site className merges over all of it through cn."
>
  <Preview
    title="Variant matrix"
    description="Every variant with an icon, then all seven colors, then the five sizes, then block, square, loading, disabled, and one call-site override proving the merge. Both columns render the same matrix, so anything that differs between them is a real difference between the adapters."
    meta={meta}
  >
    <Fragment slot="react"><ButtonPreview client:load /></Fragment>
    <Fragment slot="vue"><ButtonPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
