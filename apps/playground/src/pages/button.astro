---
import { button, variantValues } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import ButtonPreview from "../previews/ButtonPreview.tsx";
import ButtonPreviewVue from "../previews/ButtonPreview.vue";

// Read off the recipe rather than restated here, so this ledger cannot drift. The
// appearance count is the part worth watching: it is the table `eachColor` generates,
// and it is why the recipe is a third of the size it used to be.
const slots = Object.keys(button.slots);
const variantKeys = [...button.variantKeys];
const appearances = variantValues(button, "variant").length * variantValues(button, "color").length;

const meta = [
  { term: "key", value: "button" },
  { term: "slots", value: String(slots.length) },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "appearances", value: `${appearances} generated` },
];
---

<Playground
  title="Button"
  description="One recipe in @75neo/themes, rendered by both adapters. Neither adapter restates a class name, and neither does this page — the matrix below is read off the recipe at runtime."
  hasStage
>
  <Preview
    title="Variant matrix"
    description="Every variant against every color, then the size scale and the behavioural states. Both columns render the same matrix, so anything that differs between them is a real difference between the adapters."
    meta={meta}
  >
    <Fragment slot="react"><ButtonPreview client:load /></Fragment>
    <Fragment slot="vue"><ButtonPreviewVue client:load /></Fragment>
  </Preview>

  <aside class="border-default mt-16 border-t pt-8 lg:mt-24">
    <div class="grid gap-6 lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-12">
      <h2 class="text-highlighted text-base font-semibold tracking-tight">
        Where this comes from
      </h2>
      <dl class="grid gap-x-12 gap-y-4 text-sm sm:grid-cols-2">
        {
          [
            {
              term: "packages/themes/src/components/button.ts",
              value: "The recipe, its slot and variant types, and the registry entry.",
            },
            {
              term: "packages/react/src/components/Button.tsx",
              value: "The React adapter — resolve the theme, render the slots.",
            },
            {
              term: "packages/vue/src/components/Button.vue",
              value: "The Vue adapter, with props written out by hand.",
            },
            {
              term: "packages/themes/src/colors.ts",
              value: "eachColor, which builds the variant × color table above.",
            },
          ].map(({ term, value }) => (
            <div>
              <dt class="text-toned font-mono text-xs break-all" data-identifier>
                {term}
              </dt>
              <dd class="text-muted mt-1.5 text-sm/6">{value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </aside>
</Playground>
