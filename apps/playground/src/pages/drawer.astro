---
import * as DrawerParts from "@75neo/react/drawer";
import { drawerSchema } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import DrawerPreview from "../previews/DrawerPreview.tsx";
import DrawerPreviewVue from "../previews/DrawerPreview.vue";

// Read off the module rather than restated here, so this ledger cannot drift.
const parts = Object.keys(DrawerParts).filter((key) => !key.startsWith("use"));
const variantKeys = Object.keys(drawerSchema);
const combinations = variantKeys.reduce(
  (total, key) =>
    total * (drawerSchema[key as keyof typeof drawerSchema].values.length as number),
  1,
);

const meta = [
  { term: "parts", value: parts.join(" · ") },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="Drawer"
  description="A panel docked to an edge. Placement drives which side it enters from and which dimension the size runs along."
>
  <Preview
    title="Variant matrix"
    description="Every size, then every edge, then no cross. Both columns render the same matrix, so anything that differs between them is a real difference between the adapters."
    meta={meta}
  >
    <Fragment slot="react"><DrawerPreview client:load /></Fragment>
    <Fragment slot="vue"><DrawerPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
