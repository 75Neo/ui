---
import { drawer, variantValues } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import DrawerPreview from "../previews/DrawerPreview.tsx";
import DrawerPreviewVue from "../previews/DrawerPreview.vue";

// Read off the recipe rather than restated here, so this ledger cannot drift.
const slots = Object.keys(drawer.slots);
const variantKeys = [...drawer.variantKeys];
const combinations = variantKeys.reduce(
  (total, key) => total * variantValues(drawer, key).length,
  1,
);

const meta = [
  { term: "key", value: "drawer" },
  { term: "slots", value: String(slots.length) },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  eyebrow="component"
  title="Drawer"
  description="A panel sliding in from an edge of the viewport, with a backdrop, a header, a scrollable body and a footer, wrapping Ark UI."
  hasStage
>
  <Preview
    title="Placements, sizes, and a controlled drawer"
    description="Four placements sliding in from each edge of the viewport, three sizes, and one whose open state is held outside the component."
    meta={meta}
  >
    <Fragment slot="react"><DrawerPreview client:load /></Fragment>
    <Fragment slot="vue"><DrawerPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
