---
import * as PaginationParts from "@75neo/react/pagination";
import { paginationSchema } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import PaginationPreview from "../previews/PaginationPreview.tsx";
import PaginationPreviewVue from "../previews/PaginationPreview.vue";

// Read off the module rather than restated here, so this ledger cannot drift.
const parts = Object.keys(PaginationParts).filter((key) => !key.startsWith("use"));
const variantKeys = Object.keys(paginationSchema);
const combinations = variantKeys.reduce(
  (total, key) => total * (paginationSchema[key as keyof typeof paginationSchema].values.length as number),
  1,
);

const meta = [
  { term: "parts", value: parts.join(" · ") },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground title="Pagination" description="A row of page numbers with the arrows either side. The count is how many things there are, not how many pages; the pages follow from it and the page size.">
  <Preview
    title="Variant matrix"
    description="Every size, then all seven colors, then the edge buttons, then the row as links. Both columns render the same matrix."
    meta={meta}
  >
    <Fragment slot="react"><PaginationPreview client:load /></Fragment>
    <Fragment slot="vue"><PaginationPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
