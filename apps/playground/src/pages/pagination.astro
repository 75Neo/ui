---
import { pagination as recipe, variantValues } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import PaginationPreview from "../previews/PaginationPreview.tsx";
import PaginationPreviewVue from "../previews/PaginationPreview.vue";

// Read off the recipe rather than restated here, so this ledger cannot drift.
const slots = Object.keys(recipe.slots);
const variantKeys = [...recipe.variantKeys];
const combinations = variantKeys.reduce(
  (total, key) => total * variantValues(recipe, key).length,
  1,
);

const meta = [
  { term: "key", value: "pagination" },
  { term: "slots", value: String(slots.length) },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="Pagination"
  description="One recipe in @75neo/themes, rendered by both adapters. It is told how many things there are, not how many pages, because that is the number a caller reliably knows."
  hasStage
>
  <Preview
    title="Sizes, accents and the shape of the row"
    description="Three sizes, then every accent color, then a page size, wider and narrower windows, a single page, and pages rendered as links. The last one is controlled and prints the page it is on."
    meta={meta}
  >
    <Fragment slot="react"><PaginationPreview client:load /></Fragment>
    <Fragment slot="vue"><PaginationPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
