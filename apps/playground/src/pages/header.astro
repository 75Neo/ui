---
import * as HeaderParts from "@75neo/react/header";
import { headerSchema } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import HeaderPreview from "../previews/HeaderPreview.tsx";
import HeaderPreviewVue from "../previews/HeaderPreview.vue";

// Read off the module rather than restated here, so this ledger cannot drift.
const parts = Object.keys(HeaderParts).filter((key) => !key.startsWith("use"));
const variantKeys = Object.keys(headerSchema);
const combinations = variantKeys.reduce(
  (total, key) => total * (headerSchema[key as keyof typeof headerSchema].values.length as number),
  1,
);

const meta = [
  { term: "parts", value: parts.join(" · ") },
  { term: "variants", value: variantKeys.length > 0 ? variantKeys.join(" · ") : "none" },
  { term: "combinations", value: String(combinations) },
];
---

<Playground title="Header" description="The bar across the top of a page, and the menu it opens where there is no room for a navigation. The wordmark and the actions render in both.">
  <Preview
    title="Variant matrix"
    description="A bar with a wordmark, a navigation and an action, and the menu behind it on a narrow viewport. Both columns render the same matrix."
    meta={meta}
  >
    <Fragment slot="react"><HeaderPreview client:load /></Fragment>
    <Fragment slot="vue"><HeaderPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
