---
import { floatingPanel, variantValues } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import FloatingPanelPreview from "../previews/FloatingPanelPreview.tsx";
import FloatingPanelPreviewVue from "../previews/FloatingPanelPreview.vue";

// Read off the recipe rather than restated here, so this ledger cannot drift.
const slots = Object.keys(floatingPanel.slots);
const variantKeys = [...floatingPanel.variantKeys];
const combinations = variantKeys.reduce(
  (total, key) => total * variantValues(floatingPanel, key).length,
  1,
);

const meta = [
  { term: "key", value: "floatingPanel" },
  { term: "slots", value: String(slots.length) },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="FloatingPanel"
  description="A non-modal window the caller drags and resizes over the page, with minimize, maximize and close controls, wrapping Ark UI."
  hasStage
>
  <Preview
    title="Sizes and a controlled panel"
    description="Three sizes draggable across the viewport and resizable from any edge or corner, and one whose open state is held outside the component."
    meta={meta}
  >
    <Fragment slot="react"><FloatingPanelPreview client:load /></Fragment>
    <Fragment slot="vue"><FloatingPanelPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
