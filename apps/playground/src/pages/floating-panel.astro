---
import * as FloatingPanelParts from "@75neo/react/floating-panel";
import { floatingPanelSchema } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import FloatingPanelPreview from "../previews/FloatingPanelPreview.tsx";
import FloatingPanelPreviewVue from "../previews/FloatingPanelPreview.vue";

// Read off the module rather than restated here, so this ledger cannot drift.
const parts = Object.keys(FloatingPanelParts).filter((key) => !key.startsWith("use"));
const variantKeys = Object.keys(floatingPanelSchema);
const combinations = variantKeys.reduce(
  (total, key) =>
    total * (floatingPanelSchema[key as keyof typeof floatingPanelSchema].values.length as number),
  1,
);

const meta = [
  { term: "parts", value: parts.join(" · ") },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="FloatingPanel"
  description="A draggable window with stage controls and resize handles. The pixel size reaches Ark as `size`, so the contract names it `panelSize` and the size in the room stays the variant."
>
  <Preview
    title="Variant matrix"
    description="Every size, then a pinned-open panel, no cross, and a fixed strategy. Both columns render the same matrix, so anything that differs between them is a real difference between the adapters."
    meta={meta}
  >
    <Fragment slot="react"><FloatingPanelPreview client:load /></Fragment>
    <Fragment slot="vue"><FloatingPanelPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
