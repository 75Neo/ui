---
import { sidebar as recipe, variantValues } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import SidebarPreview from "../previews/SidebarPreview.tsx";
import SidebarPreviewVue from "../previews/SidebarPreview.vue";

// Read off the recipe rather than restated here, so this ledger cannot drift.
const slots = Object.keys(recipe.slots);
const variantKeys = [...recipe.variantKeys];
const combinations = variantKeys.reduce(
  (total, key) => total * variantValues(recipe, key).length,
  1,
);

const meta = [
  { term: "key", value: "sidebar" },
  { term: "slots", value: String(slots.length) },
  { term: "variants", value: variantKeys.join(" · ") || "none" },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  eyebrow="component"
  title="Sidebar"
  description="A column beside the page that collapses to a strip or disappears, and slides in over the page where there is no room beside it. One tree serves both, so nothing inside it is rendered twice."
  hasStage
>
  <Preview
    title="Three looks and three ways of collapsing"
    description="Each specimen is a whole shell. Use the rail on the outer edge or the button in the header to collapse one, and watch the spacer beside the panel move with it."
    meta={meta}
  >
    <Fragment slot="react"><SidebarPreview client:load /></Fragment>
    <Fragment slot="vue"><SidebarPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
