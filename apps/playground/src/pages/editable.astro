---
import * as EditableParts from "@75neo/react/editable";
import { editableSchema } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import EditablePreview from "../previews/EditablePreview.tsx";
import EditablePreviewVue from "../previews/EditablePreview.vue";

// Read off the module rather than restated here, so this ledger cannot drift.
const parts = Object.keys(EditableParts).filter((key) => !key.startsWith("use"));
const variantKeys = Object.keys(editableSchema);
const combinations = variantKeys.reduce(
  (total, key) =>
    total * (editableSchema[key as keyof typeof editableSchema].values.length as number),
  1,
);

const meta = [
  { term: "parts", value: parts.join(" · ") },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="Editable"
  description="Text that turns into a field where it stands. Input and preview stack in one grid cell and Ark hides whichever is not showing, so the field never moves when entered."
>
  <Preview
    title="Variant matrix"
    description="Every size, then all seven colors, then states. Both columns render the same matrix, so anything that differs between them is a real difference between the adapters."
    meta={meta}
  >
    <Fragment slot="react"><EditablePreview client:load /></Fragment>
    <Fragment slot="vue"><EditablePreviewVue client:load /></Fragment>
  </Preview>
</Playground>
