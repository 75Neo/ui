---
import { editable, variantValues } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import EditablePreview from "../previews/EditablePreview.tsx";
import EditablePreviewVue from "../previews/EditablePreview.vue";

// Read off the recipe rather than restated here, so this ledger cannot drift.
const slots = Object.keys(editable.slots);
const variantKeys = [...editable.variantKeys];
const combinations = variantKeys.reduce(
  (total, key) => total * variantValues(editable, key).length,
  1,
);

const meta = [
  { term: "key", value: "editable" },
  { term: "slots", value: String(slots.length) },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="Editable"
  description="A sentence that becomes a field when it is touched. The text and the buttons swap with the edit state, which only Ark's context knows, so the adapter reads it there rather than tracking it twice."
  hasStage
>
  <Preview
    title="Sizes, accents, activation and a controlled pair"
    description="Three sizes, then the accent on the field's focus ring, two activation modes, a read-only and a disabled field, and one whose text and edit state are both owned outside the component."
    meta={meta}
  >
    <Fragment slot="react"><EditablePreview client:load /></Fragment>
    <Fragment slot="vue"><EditablePreviewVue client:load /></Fragment>
  </Preview>
</Playground>
