---
import * as DatePickerParts from "@75neo/react/date-picker";
import { datePickerSchema } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import DatePickerPreview from "../previews/DatePickerPreview.tsx";
import DatePickerPreviewVue from "../previews/DatePickerPreview.vue";

// Read off the module rather than restated here, so this ledger cannot drift.
const parts = Object.keys(DatePickerParts).filter((key) => !key.startsWith("use"));
const variantKeys = Object.keys(datePickerSchema);
const combinations = variantKeys.reduce(
  (total, key) =>
    total * (datePickerSchema[key as keyof typeof datePickerSchema].values.length as number),
  1,
);

const meta = [
  { term: "parts", value: parts.join(" · ") },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="DatePicker"
  description="A field with a calendar behind it. Day, month and year grids share one view control, and a range is two fields each editable on its own."
>
  <Preview
    title="Variant matrix"
    description="Every size, then all seven colors, then range and states. Both columns render the same matrix, so anything that differs between them is a real difference between the adapters."
    meta={meta}
  >
    <Fragment slot="react"><DatePickerPreview client:load /></Fragment>
    <Fragment slot="vue"><DatePickerPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
