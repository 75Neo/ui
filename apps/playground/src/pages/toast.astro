---
import * as ToastParts from "@75neo/react/toast";
import { toastSchema } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import ToastPreview from "../previews/ToastPreview.tsx";
import ToastPreviewVue from "../previews/ToastPreview.vue";

// Read off the module rather than restated here, so this ledger cannot drift.
const parts = Object.keys(ToastParts).filter((key) => !key.startsWith("use"));
const variantKeys = Object.keys(toastSchema);
const combinations = variantKeys.reduce(
  (total, key) =>
    total * (toastSchema[key as keyof typeof toastSchema].values.length as number),
  1,
);

const meta = [
  { term: "parts", value: parts.join(" · ") },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="Toast"
  description="A stack of notices held by a store. Placement and stacking belong to `createToaster`; the toaster renders what the store holds, each toast styled by its type."
>
  <Preview
    title="Variant matrix"
    description="One of every type, then an action toast. The stack is a singleton, so there is one toaster, not a matrix of them. Both columns render the same specimens, so anything that differs between them is a real difference between the adapters."
    meta={meta}
  >
    <Fragment slot="react"><ToastPreview client:load /></Fragment>
    <Fragment slot="vue"><ToastPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
