---
import * as DialogParts from "@75neo/react/dialog";
import { dialogSchema } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import DialogPreview from "../previews/DialogPreview.tsx";
import DialogPreviewVue from "../previews/DialogPreview.vue";

// Read off the module rather than restated here, so this ledger cannot drift.
const parts = Object.keys(DialogParts).filter((key) => !key.startsWith("use"));
const variantKeys = Object.keys(dialogSchema);
const combinations = variantKeys.reduce(
  (total, key) =>
    total * (dialogSchema[key as keyof typeof dialogSchema].values.length as number),
  1,
);

const meta = [
  { term: "parts", value: parts.join(" · ") },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="Dialog"
  description="A centered panel over a backdrop. The trigger is the caller's own element, the heading and body are data, and one prop dismisses both halves of dismissal at once."
>
  <Preview
    title="Variant matrix"
    description="Every size, then no backdrop, no cross, and fullscreen. Both columns render the same matrix, so anything that differs between them is a real difference between the adapters."
    meta={meta}
  >
    <Fragment slot="react"><DialogPreview client:load /></Fragment>
    <Fragment slot="vue"><DialogPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
