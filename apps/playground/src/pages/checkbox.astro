---
import * as CheckboxParts from "@75neo/react/checkbox";
import { checkboxSchema } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import CheckboxPreview from "../previews/CheckboxPreview.tsx";
import CheckboxPreviewVue from "../previews/CheckboxPreview.vue";

// Read off the module rather than restated here, so this ledger cannot drift.
const parts = Object.keys(CheckboxParts).filter((key) => !key.startsWith("use"));
const variantKeys = Object.keys(checkboxSchema);
const combinations = variantKeys.reduce(
  (total, key) =>
    total * (checkboxSchema[key as keyof typeof checkboxSchema].values.length as number),
  1,
);

const meta = [
  { term: "parts", value: parts.join(" · ") },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="Checkbox"
  description="A box that ticks, unticks, or holds the third state across five sizes. The dash has its own indicator, and the checked state comes from Ark."
>
  <Preview
    title="Variant matrix"
    description="Every size, then all seven colors, then checked, indeterminate and disabled. Both columns render the same matrix, so anything that differs between them is a real difference between the adapters."
    meta={meta}
  >
    <Fragment slot="react"><CheckboxPreview client:load /></Fragment>
    <Fragment slot="vue"><CheckboxPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
