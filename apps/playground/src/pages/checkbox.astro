---
import { checkbox, variantValues } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import CheckboxPreview from "../previews/CheckboxPreview.tsx";
import CheckboxPreviewVue from "../previews/CheckboxPreview.vue";

// Read off the recipe rather than restated here, so this ledger cannot drift.
const slots = Object.keys(checkbox.slots);
const variantKeys = [...checkbox.variantKeys];
const combinations = variantKeys.reduce(
  (total, key) => total * variantValues(checkbox, key).length,
  1,
);

const meta = [
  { term: "key", value: "checkbox" },
  { term: "slots", value: String(slots.length) },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="Checkbox"
  description="One recipe in @75neo/themes, rendered by both adapters. Checked, unchecked and indeterminate are read off Ark's data-state rather than declared as a variant, so toggling one never re-resolves its classes."
  hasStage
>
  <Preview
    title="Sizes, colors and the third state"
    description="Five sizes, then every color in all three states, then a description, a disabled box and an invalid one. The group at the bottom drives its parent: tick one child and the parent goes indeterminate."
    meta={meta}
  >
    <Fragment slot="react"><CheckboxPreview client:load /></Fragment>
    <Fragment slot="vue"><CheckboxPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
