---
import { numberInput as recipe, variantValues } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import NumberInputPreview from "../previews/NumberInputPreview.tsx";
import NumberInputPreviewVue from "../previews/NumberInputPreview.vue";

// Read off the recipe rather than restated here, so this ledger cannot drift.
const slots = Object.keys(recipe.slots);
const variantKeys = [...recipe.variantKeys];
const combinations = variantKeys.reduce(
  (total, key) => total * variantValues(recipe, key).length,
  1,
);

const meta = [
  { term: "key", value: "numberInput" },
  { term: "slots", value: String(slots.length) },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="NumberInput"
  description="One recipe in @75neo/themes, rendered by both adapters. Three elements serve both arrangements: the row places them with order, the column by grid line, so neither adapter has a branch in it."
  hasStage
>
  <Preview
    title="Sizes, arrangements, accents and formats"
    description="Three sizes, then both arrangements, then every accent color, then a range, a step, a currency, a percentage, the wheel, and disabled. The last one is controlled and prints the field's text."
    meta={meta}
  >
    <Fragment slot="react"><NumberInputPreview client:load /></Fragment>
    <Fragment slot="vue"><NumberInputPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
