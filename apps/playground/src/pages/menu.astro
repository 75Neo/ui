---
import * as MenuParts from "@75neo/react/menu";
import { menuSchema } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import MenuPreview from "../previews/MenuPreview.tsx";
import MenuPreviewVue from "../previews/MenuPreview.vue";

// Read off the module rather than restated here, so this ledger cannot drift.
const parts = Object.keys(MenuParts).filter((key) => !key.startsWith("use"));
const variantKeys = Object.keys(menuSchema);
const combinations = variantKeys.reduce(
  (total, key) =>
    total * (menuSchema[key as keyof typeof menuSchema].values.length as number),
  1,
);

const meta = [
  { term: "parts", value: parts.join(" · ") },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  title="Menu"
  description="A panel of rows dropped from a trigger. One flat array holds every kind of row, submenus nest as menus, and one set of classes styles every level."
>
  <Preview
    title="Variant matrix"
    description="Every size, then all seven colors, then checkbox rows, a submenu and the arrow. Both columns render the same matrix, so anything that differs between them is a real difference between the adapters."
    meta={meta}
  >
    <Fragment slot="react"><MenuPreview client:load /></Fragment>
    <Fragment slot="vue"><MenuPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
