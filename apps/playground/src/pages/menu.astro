---
import { menu as recipe, variantValues } from "@75neo/themes";
import Preview from "../components/Preview.astro";
import Playground from "../layouts/Playground.astro";
import MenuPreview from "../previews/MenuPreview.tsx";
import MenuPreviewVue from "../previews/MenuPreview.vue";

// Read off the recipe rather than restated here, so this ledger cannot drift.
const slots = Object.keys(recipe.slots);
const variantKeys = [...recipe.variantKeys];
const combinations = variantKeys.reduce(
  (total, key) => total * variantValues(recipe, key).length,
  1,
);

const meta = [
  { term: "key", value: "menu" },
  { term: "slots", value: String(slots.length) },
  { term: "variants", value: variantKeys.join(" · ") },
  { term: "combinations", value: String(combinations) },
];
---

<Playground
  eyebrow="component"
  title="Menu"
  description="One recipe in @75neo/themes, rendered by both adapters. One flat array of rows becomes headings, separators, ticks, links and submenus to any depth, and one recipe styles every level of them."
  hasStage
>
  <Preview
    title="Sizes, accents and every kind of row"
    description="Three sizes, then every accent color, then headings, ticks beside a link, three levels of submenu, an arrow, and no motion. The last one reports the value of whichever row was chosen."
    meta={meta}
  >
    <Fragment slot="react"><MenuPreview client:load /></Fragment>
    <Fragment slot="vue"><MenuPreviewVue client:load /></Fragment>
  </Preview>
</Playground>
