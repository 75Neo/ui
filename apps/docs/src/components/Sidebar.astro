---
import { type Framework, docHref } from "../lib/framework";
import type { SidebarLink } from "../lib/navigation";

/**
 * The column of every page in the documentation.
 *
 * @remarks
 * The current row is painted from `aria-current` rather than from a class decided here.
 * This element is carried across navigations, so the markup arriving with the new page
 * is discarded and only an attribute a script can set moves the highlight.
 */
interface Props {
  framework: Framework;
  /** The components section, one row per documented component. */
  components: SidebarLink[];
  /** The path the reader is on, so one row is already current on first paint. */
  path: string;
}

const { framework, components, path } = Astro.props;

const sections = [
  {
    label: "Guides",
    links: [
      { href: docHref(framework, "getting-started"), label: "Getting started" },
      { href: docHref(framework, "components"), label: "Components" },
    ],
  },
  { label: "Components", links: components },
];
---

<nav aria-label="Documentation" class="flex flex-col gap-5 py-6">
  {
    sections.map(({ label, links }) => (
      <div>
        <p class="text-highlighted px-2 pb-1.5 text-sm font-semibold">{label}</p>

        <ul class="flex flex-col gap-px">
          {links.map(({ href, label: link }) => (
            <li>
              <a
                href={href}
                aria-current={path === href ? "page" : undefined}
                class="text-muted hover:text-highlighted hover:bg-elevated outline-primary/25 block truncate rounded-md px-2 py-1.5 text-sm transition-colors focus-visible:outline-3"
              >
                {link}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</nav>
