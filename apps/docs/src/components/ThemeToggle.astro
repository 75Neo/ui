---
import { Monitor, Moon, Sun } from "@lucide/astro";

/**
 * A three-way theme control.
 *
 * @remarks
 * The active segment is painted from `data-theme` on the root element, which an inline
 * script sets before first paint, so the right segment is lit on the first frame rather
 * than after hydration. That also means it survives a client-side navigation: the root
 * element is never swapped, so nothing has to repaint the control afterwards.
 */
const options = [
  { value: "light", label: "Light", icon: Sun },
  { value: "dark", label: "Dark", icon: Moon },
  { value: "auto", label: "System", icon: Monitor },
] as const;
---

<div
  role="group"
  aria-label="Theme"
  class="border-muted bg-elevated/60 flex items-center gap-px rounded-lg border p-px"
>
  {
    options.map(({ value, label, icon: Icon }) => (
      <button
        type="button"
        data-theme-option={value}
        title={label}
        class="text-dimmed hover:text-toned grid size-6 cursor-pointer place-items-center rounded-[0.4rem]"
      >
        <Icon size={13} aria-hidden="true" />
        <span class="sr-only">{label}</span>
      </button>
    ))
  }
</div>
