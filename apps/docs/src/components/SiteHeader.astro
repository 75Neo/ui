---
import { PanelLeft } from "@lucide/astro";
import BrandIcon from "./BrandIcon.astro";
import FrameworkSwitch from "./FrameworkSwitch.astro";
import Search from "./Search.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { iconButton } from "../lib/controls";
import { type Framework, docHref } from "../lib/framework";
import type { SearchEntry } from "../lib/search";

/**
 * The one bar across the top of every page, in the shape the Header component renders:
 * the same height, the same surface, the same gutters. The framework is optional
 * because the landing page belongs to neither; without one the navigation points at
 * React, as the redirect at `/docs` does.
 */
interface Props {
  framework?: Framework;
  /** The path the reader is on, so one navigation link can be marked current. */
  path: string;
  entries: SearchEntry[];
  /** Whether the page has a sidebar the narrow layout needs a button for. */
  hasSidebar?: boolean;
}

const { framework, path, entries, hasSidebar = false } = Astro.props;
const target = framework ?? "react";

const nav = [
  { href: docHref(target, "getting-started"), label: "Docs" },
  { href: docHref(target, "components"), label: "Components" },
];
---

<header
  class="border-default bg-default/75 sticky top-0 z-50 h-header border-b backdrop-blur-sm"
>
  <div class="mx-auto flex h-full w-full max-w-page items-center gap-2 px-5 sm:px-8 lg:px-12">
    {
      hasSidebar && (
        <button
          type="button"
          data-nav-toggle
          aria-expanded="false"
          aria-controls="page-nav"
          class={`${iconButton} -ms-1.5 lg:hidden`}
        >
          <PanelLeft aria-hidden="true" />
          <span class="sr-only">Navigation</span>
        </button>
      )
    }

    <a
      href="/"
      class="text-highlighted outline-primary/25 me-2 flex shrink-0 items-center gap-2 rounded-sm focus-visible:outline-3"
    >
      <img src="/logo-brand.svg" alt="" width="22" height="22" class="rounded-sm" />
      <span class="text-base font-bold tracking-tight">75NeoUI</span>
    </a>

    <nav aria-label="Sections" class="hidden items-center gap-1 md:flex">
      {
        nav.map(({ href, label }) => (
          <a
            href={href}
            aria-current={path.startsWith(href) ? "page" : undefined}
            class="text-muted hover:text-highlighted aria-[current]:text-highlighted outline-primary/25 rounded-sm px-2 py-1 text-sm transition-colors focus-visible:outline-3 aria-[current]:font-medium"
          >
            {label}
          </a>
        ))
      }
    </nav>

    <div class="ms-auto flex min-w-0 items-center gap-1.5">
      <Search entries={entries} />
      {framework && <FrameworkSwitch framework={framework} path={path} />}
      <a
        href="https://github.com/75Neo/ui"
        class={`${iconButton} hidden sm:inline-flex`}
      >
        <BrandIcon name="github" size={16} />
        <span class="sr-only">75NeoUI on GitHub</span>
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>
