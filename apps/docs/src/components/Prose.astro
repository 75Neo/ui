---
/**
 * Rendered Markdown, held to the measure the rest of the page uses.
 *
 * @remarks
 * A wrapper rather than a class on every caller, so the one place that decides what
 * prose looks like stays one place.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["prose", className]}>
  <slot />
</div>
