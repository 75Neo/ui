---
import { type Framework, docHref, frameworkFacts, frameworks, isFramework } from "../lib/framework";

/**
 * React or Vue, without leaving the page. Every route exists under both adapters, so
 * this takes the path rather than a destination: the other copy is one segment swapped.
 *
 * @remarks
 * Painted like the SegmentGroup component: a recessed track, and the current segment
 * lifted back to the page's own surface with a hairline around it.
 */
interface Props {
  framework: Framework;
  /** The path the reader is on, of the shape `/docs/<framework>/<page>`. */
  path: string;
}

const { framework, path } = Astro.props;

/** Swap the framework segment, leaving everything around it alone. */
const hrefFor = (next: Framework) => {
  const segments = path.split("/");
  const at = segments.findIndex((segment) => isFramework(segment));

  if (at === -1) return docHref(next, "getting-started");

  segments[at] = next;
  return segments.join("/");
};
---

<div
  role="group"
  aria-label="Framework"
  class="bg-elevated hidden items-center gap-0.5 rounded-md p-0.5 sm:flex"
>
  {
    frameworks.map((option) => (
      <a
        href={hrefFor(option)}
        aria-current={option === framework ? "true" : undefined}
        class:list={[
          "outline-primary/25 rounded-sm px-2 py-1 text-xs font-medium transition-colors focus-visible:outline-3",
          option === framework
            ? "bg-default text-highlighted ring-default ring"
            : "text-muted hover:text-highlighted",
        ]}
      >
        {frameworkFacts[option].label}
      </a>
    ))
  }
</div>
