---
import { Check, Copy } from "@lucide/astro";

/**
 * Hands the reader the page's own Markdown: what the content collection holds, not a
 * rendering of it.
 *
 * @remarks
 * The source travels as JSON inside a script element, because the Markdown quotes Vue
 * examples and an HTML parser ends a script at the first tag that closes one. The
 * `replaceAll` below escapes that sequence. It is spelled out nowhere here on purpose:
 * written literally in the frontmatter, a comment included, it mis-slices the file for
 * `astro check`, which then reports `Props` as unused.
 */
interface Props {
  source: string;
}

const { source } = Astro.props;
---

<div class="shrink-0">
  <button
    type="button"
    data-copy-markdown
    class="border-muted text-muted hover:border-accented hover:text-highlighted flex h-8 cursor-pointer items-center gap-1.5 rounded-lg border px-2.5 text-xs font-medium"
  >
    {/* The state lives on a wrapper, because the icon component takes no `hidden`. */}
    <span data-copy-idle class="flex"><Copy size={13} aria-hidden="true" /></span>
    <span data-copy-done hidden class="text-success flex"><Check size={13} aria-hidden="true" /></span>
    Copy Markdown
  </button>
  <script
    is:inline
    type="application/json"
    data-copy-source
    set:html={JSON.stringify(source).replaceAll("</", String.raw`<\/`)}
  />
</div>

<script>
  // Bound once for the visit, because a navigation replaces the button.
  document.addEventListener("click", async (event) => {
    const button = (event.target as HTMLElement | null)?.closest<HTMLElement>(
      "[data-copy-markdown]",
    );
    if (!button) return;

    const encoded = document.querySelector("[data-copy-source]")?.textContent;
    if (!encoded) return;
    const source = JSON.parse(encoded) as string;

    try {
      await navigator.clipboard.writeText(source);
    } catch {
      // A denied permission or an insecure origin. Nothing to report on the button.
      return;
    }

    const idle = button.querySelector<HTMLElement>("[data-copy-idle]");
    const done = button.querySelector<HTMLElement>("[data-copy-done]");
    if (!idle || !done) return;

    idle.hidden = true;
    done.hidden = false;
    window.setTimeout(() => {
      idle.hidden = false;
      done.hidden = true;
    }, 1600);
  });
</script>
