// The vertical slice: Button and Accordion only. The batch migration restores one
// group at a time, appending its lines here and in Thumbnail.astro.

/**
 * One component's live specimen, in the framework the route is for.
 *
 * @remarks
 * Written out as a switch because a client directive has to name its component through a
 * static import; one reached through a lookup table leaves Astro nothing to hydrate.
 * Both adapters appear, so a reader on the Vue route sees Vue rendering.
 */
interface Props {
  /** Exported component name, as it appears in a content entry. */
  name: string;
  framework: Framework;
}

const { name, framework } = Astro.props;
const react = framework === "react";
const vue = framework === "vue";
---

