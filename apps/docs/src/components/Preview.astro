import AccordionPreviewVue from "../previews/AccordionPreview.vue";
import ButtonPreviewVue from "../previews/ButtonPreview.vue";
import ClipboardPreviewVue from "../previews/ClipboardPreview.vue";
import ComboboxPreviewVue from "../previews/ComboboxPreview.vue";
import TagsInputPreviewVue from "../previews/TagsInputPreview.vue";
import PinInputPreviewVue from "../previews/PinInputPreview.vue";
import PasswordInputPreviewVue from "../previews/PasswordInputPreview.vue";
import NumberInputPreviewVue from "../previews/NumberInputPreview.vue";
import EditablePreviewVue from "../previews/EditablePreview.vue";
import ListboxPreviewVue from "../previews/ListboxPreview.vue";
import MenuPreviewVue from "../previews/MenuPreview.vue";
import SelectPreviewVue from "../previews/SelectPreview.vue";
import RatingGroupPreviewVue from "../previews/RatingGroupPreview.vue";
import SegmentGroupPreviewVue from "../previews/SegmentGroupPreview.vue";
import SwitchPreviewVue from "../previews/SwitchPreview.vue";
import RadioGroupPreviewVue from "../previews/RadioGroupPreview.vue";
import CheckboxPreviewVue from "../previews/CheckboxPreview.vue";
import TableOfContentsPreviewVue from "../previews/TableOfContentsPreview.vue";
import TreeViewPreviewVue from "../previews/TreeViewPreview.vue";
import ColorPickerPreviewVue from "../previews/ColorPickerPreview.vue";
import DateInputPreviewVue from "../previews/DateInputPreview.vue";
import DatePickerPreviewVue from "../previews/DatePickerPreview.vue";
import DownloadTriggerPreviewVue from "../previews/DownloadTriggerPreview.vue";
import TabsPreviewVue from "../previews/TabsPreview.vue";
import ToggleGroupPreviewVue from "../previews/ToggleGroupPreview.vue";
import TogglePreviewVue from "../previews/TogglePreview.vue";

// The vertical slice: Button and Accordion only. The batch migration restores one
// group at a time, appending its lines here and in Thumbnail.astro.

/**
 * One component's live specimen, in the framework the route is for.
 *
 * @remarks
 * Written out as a switch because a client directive has to name its component through a
 * static import; one reached through a lookup table leaves Astro nothing to hydrate.
 * Both adapters appear, so a reader on the Vue route sees Vue rendering.
 */
interface Props {
  /** Exported component name, as it appears in a content entry. */
  name: string;
  framework: Framework;
}

const { name, framework } = Astro.props;
const react = framework === "react";
const vue = framework === "vue";
---

{react && name === "Accordion" && <AccordionPreview client:visible />}
{react && name === "Button" && <ButtonPreview client:visible />}
{react && name === "Clipboard" && <ClipboardPreview client:visible />}
{react && name === "Combobox" && <ComboboxPreview client:visible />}
{react && name === "TagsInput" && <TagsInputPreview client:visible />}
{react && name === "PinInput" && <PinInputPreview client:visible />}
{react && name === "PasswordInput" && <PasswordInputPreview client:visible />}
{react && name === "NumberInput" && <NumberInputPreview client:visible />}
{react && name === "Editable" && <EditablePreview client:visible />}
{react && name === "Listbox" && <ListboxPreview client:visible />}
{react && name === "Menu" && <MenuPreview client:visible />}
{react && name === "Select" && <SelectPreview client:visible />}
{react && name === "RatingGroup" && <RatingGroupPreview client:visible />}
{react && name === "SegmentGroup" && <SegmentGroupPreview client:visible />}
{react && name === "Switch" && <SwitchPreview client:visible />}
{react && name === "RadioGroup" && <RadioGroupPreview client:visible />}
{react && name === "Checkbox" && <CheckboxPreview client:visible />}
{react && name === "TableOfContents" && <TableOfContentsPreview client:visible />}
{react && name === "TreeView" && <TreeViewPreview client:visible />}
{react && name === "ColorPicker" && <ColorPickerPreview client:visible />}
{react && name === "DateInput" && <DateInputPreview client:visible />}
{react && name === "DatePicker" && <DatePickerPreview client:visible />}
{react && name === "DownloadTrigger" && <DownloadTriggerPreview client:visible />}
{react && name === "Tabs" && <TabsPreview client:visible />}
{react && name === "ToggleGroup" && <ToggleGroupPreview client:visible />}
{react && name === "Toggle" && <TogglePreview client:visible />}

{vue && name === "Accordion" && <AccordionPreviewVue client:visible />}
{vue && name === "Button" && <ButtonPreviewVue client:visible />}
{vue && name === "Clipboard" && <ClipboardPreviewVue client:visible />}
