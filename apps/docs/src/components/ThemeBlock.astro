---
import { accordion, button } from "@75neo/styles";
import { Code } from "astro:components";

/**
 * Prints a component's theme as the object an app would override.
 * The value comes from `@75neo/styles` rather than from this file, so it cannot drift
 * out of step with the theme it documents.
 */
interface Props {
  name: "accordion" | "button";
}

const { name } = Astro.props;

const themes = { accordion, button };
const theme = themes[name];

// `tailwind-variants` adds an implicit `base` slot to every slotted theme. A multi-part
// component has no element behind it, so it is not part of the public surface.
const slots = Object.fromEntries(
  Object.entries(theme.slots ?? {}).filter(([slot]) => slot !== "base" || name === "button"),
);

const indent = (value: unknown) => JSON.stringify(value, null, 2).replaceAll("\n", "\n  ");

// A key the theme does not declare is omitted rather than printed as `undefined` — the
// accordion has no default variants, and only the button has compound ones.
const entry = (key: string, value: unknown) =>
  value === undefined ? [] : [`  ${key}: ${indent(value)},`];

const source = [
  "{",
  ...entry("slots", slots),
  ...entry("variants", theme.variants),
  ...entry("compoundVariants", theme.compoundVariants),
  ...entry("defaultVariants", theme.defaultVariants),
  "}",
].join("\n");
---

<h2 id="theme">Theme</h2>
<p>
  The object below is the real theme, read from <code>@75neo/styles</code> at build time. A
  <code>ThemeConfig</code> merges into it — see <a href="/customization">Customization</a>.
</p>
<Code code={source} lang="ts" />
