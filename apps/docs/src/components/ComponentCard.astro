---
import Thumbnail from "./Thumbnail.astro";
import { componentHref } from "../lib/components";
import { hasPreview } from "../lib/previews";
import type { DocumentedComponent } from "../lib/components";
import type { Framework } from "../lib/framework";

/**
 * One component on a wall of them: its name, its line, and a picture of it.
 *
 * @remarks
 * The picture is the component itself, laid out at half again the card's width and
 * scaled to two thirds, so a specimen that would wrap at card width keeps its
 * proportions. It is inert and hidden from the accessibility tree, and the name above it
 * carries a stretched link, so the card is one target and the specimen's buttons are not.
 */
interface Props {
  component: DocumentedComponent;
  framework: Framework;
  /**
   * Heading level, so a card can sit under an `h1` or an `h2`. Not spelled `as`:
   * `astro check` loses the link between `Props` and `Astro.props` at that name.
   */
  level?: "h2" | "h3";
}

const { component, framework, level: Heading = "h2" } = Astro.props;
const { entry, api, slug } = component;
---

<li class="border-default hover:bg-elevated/40 relative flex flex-col overflow-hidden rounded-lg border transition-colors">
  <div class="px-4 pt-4 pb-3.5">
    <Heading class="text-highlighted text-sm font-semibold tracking-tight">
      <a href={componentHref(framework, slug)} class="after:absolute after:inset-0">
        {entry.data.name}
      </a>
    </Heading>
    <p class="text-muted mt-1 line-clamp-2 text-xs/5 text-pretty">{entry.data.summary}</p>
  </div>

  <div data-stage data-thumbnail class="border-default mt-auto h-36 overflow-hidden border-t">
    {
      hasPreview(entry.data.name) ? (
        <div
          aria-hidden="true"
          inert
          class="pointer-events-none flex h-[13.85rem] w-[154%] origin-top-left scale-[0.65] items-center justify-center px-6"
        >
          <Thumbnail name={entry.data.name} framework={framework} />
        </div>
      ) : (
        <p class="text-dimmed grid h-full place-items-center font-mono text-xs" data-identifier>
          {api.parts.length} parts
        </p>
      )
    }
  </div>
</li>
