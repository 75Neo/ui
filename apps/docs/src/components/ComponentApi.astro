---
import PropsTable from "./PropsTable.astro";
import type { ComponentApi, PartApi, PropDoc } from "../lib/component-api";
import { type Framework, frameworkFacts } from "../lib/framework";

interface Props {
  api: ComponentApi;
  framework: Framework;
  /**
   * Prefix for the row anchors inside the tables. The section ids are fixed, because a
   * component has a page to itself and nothing else on it claims them.
   */
  id: string;
}

const { api, framework, id } = Astro.props;
const facts = frameworkFacts[framework];

/**
 * The contract writes an icon as the type parameter `F`, because it is one type in
 * React and another in Vue. The route knows which, so the reader never has to.
 */
const named = (props: PropDoc[]) =>
  props.map((prop) => ({ ...prop, type: prop.type.replace(/\bF\b/g, facts.icon) }));

/** A section is worth a heading only when it has rows. */
const hasReact = (part: PartApi) => part.react.props.length > 0 || part.react.inherits.length > 0;
const hasVue = (part: PartApi) =>
  part.vue.props.length > 0 || part.vue.slots.length > 0 || part.vue.models.length > 0;
const hasShared = (part: PartApi) => part.shared.length > 0;
const hasFramework = (part: PartApi) =>
  framework === "react" ? hasReact(part) : hasVue(part);

const heading =
  "text-highlighted border-default border-t pt-8 text-2xl font-semibold tracking-tight";
const aside = "text-muted mt-3 max-w-[70ch] text-base/7 text-pretty";
---

<div class="mt-12 space-y-12">
  <section aria-labelledby="parts">
    <h2 id="parts" class={heading}>Parts</h2>
    <p class={aside}>
      One export per part, one file per part. The export name is the{" "}
      <code class="text-muted" data-identifier>data-slot</code> in kebab-case, so{" "}
      <code class="text-muted" data-identifier>AccordionItemTrigger</code> answers to{" "}
      <code class="text-muted" data-identifier>accordion-item-trigger</code>.
    </p>
    <ul class="mt-4 flex flex-wrap gap-1.5">
      {
        api.parts.map((part) => (
          <li
            class="bg-elevated text-toned rounded-md px-2 py-1 font-mono text-xs"
            data-identifier
          >
            {part.name}
          </li>
        ))
      }
    </ul>
  </section>

  {
    api.variants.length > 0 && (
      <section aria-labelledby="variants">
        <h2 id="variants" class={heading}>
          Variants
        </h2>
        <p class={aside}>
          Read off the schema object, so these are the values that actually resolve. The
          root publishes them through context; every part reads them into its own styles.
        </p>
        <dl class="divide-default border-default mt-4 divide-y border-t">
          {api.variants.map((variant) => (
            <div class="flex flex-wrap items-baseline gap-x-8 gap-y-2 py-3">
              <dt
                class="text-highlighted w-28 shrink-0 font-mono text-xs"
                data-identifier
              >
                {variant.name}
              </dt>
              <dd class="flex flex-wrap items-baseline gap-1.5">
                {variant.values.map((value) => (
                  <span
                    class:list={[
                      "rounded-md px-2 py-0.5 font-mono text-xs",
                      value === variant.defaultValue
                        ? "bg-primary/10 text-primary"
                        : "bg-elevated text-toned",
                    ]}
                    data-identifier
                  >
                    {value}
                  </span>
                ))}
              </dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  {
    api.parts.map(
      (part) =>
        (hasShared(part) || hasFramework(part)) && (
          <section aria-labelledby={`part-${part.name}`}>
            <h2 id={`part-${part.name}`} class={heading}>
              {part.name}
            </h2>
            {hasShared(part) && (
              <>
                <p class={aside}>
                  Taken by both adapters. The same names and the same types work in{" "}
                  {frameworkFacts.react.label} and {frameworkFacts.vue.label}.
                </p>
                <div class="mt-4">
                  <PropsTable props={named(part.shared)} id={`${id}-${part.name}-prop`} />
                </div>
              </>
            )}
            {framework === "react" && hasReact(part) && (
              <>
                <h3 class="text-highlighted mt-6 text-lg font-semibold tracking-tight">
                  React only
                </h3>
                {part.react.inherits.length > 0 && (
                  <p class={aside}>
                    Also takes{" "}
                    {part.react.inherits.map((clause, index) => (
                      <>
                        {index > 0 && ", and "}
                        <code class="text-toned font-mono" data-identifier>
                          {clause}
                        </code>
                      </>
                    ))}
                    . A <code class="text-muted" data-identifier>className</code> among
                    them merges over the part's own classes.
                  </p>
                )}
                {part.react.props.length > 0 && (
                  <div class="mt-3">
                    <PropsTable
                      props={named(part.react.props)}
                      id={`${id}-${part.name}-react`}
                    />
                  </div>
                )}
              </>
            )}
            {framework === "vue" && hasVue(part) && (
              <>
                <h3 class="text-highlighted mt-6 text-lg font-semibold tracking-tight">
                  Vue only
                </h3>
                {part.vue.models.length > 0 && (
                  <p class={aside}>
                    Binds{" "}
                    {part.vue.models.map((model, index) => (
                      <>
                        {index > 0 && ", "}
                        <code class="text-toned font-mono" data-identifier>
                          {model}
                        </code>
                      </>
                    ))}
                    .
                  </p>
                )}

                {part.vue.props.length > 0 && (
                  <div class="mt-3">
                    <PropsTable
                      props={named(part.vue.props)}
                      id={`${id}-${part.name}-vue`}
                    />
                  </div>
                )}

                {part.vue.slots.length > 0 && (
                  <dl class="divide-default border-default mt-6 divide-y border-t">
                    {part.vue.slots.map((slot) => (
                      <div class="grid gap-x-10 gap-y-2 py-4 lg:grid-cols-[minmax(0,18rem)_minmax(0,1fr)]">
                        <dt class="min-w-0">
                          <span class="text-highlighted font-mono text-xs" data-identifier>
                            #{slot.name}
                          </span>
                          {slot.scope && (
                            <p
                              class="text-toned mt-1 font-mono text-xs break-words"
                              data-identifier
                            >
                              {slot.scope}
                            </p>
                          )}
                        </dt>
                        <dd class="text-muted min-w-0 text-sm/6 text-pretty">
                          {slot.description}
                        </dd>
                      </div>
                    ))}
                  </dl>
                )}
              </>
            )}
          </section>
        ),
    )
  }
</div>
