---
import type { Framework } from "../lib/framework";
import { AccordionPreview } from "../previews/AccordionPreview";
import { ButtonPreview } from "../previews/ButtonPreview";
import { ClipboardPreview } from "../previews/ClipboardPreview";
import { TableOfContentsPreview } from "../previews/TableOfContentsPreview";
import AccordionPreviewVue from "../previews/AccordionPreview.vue";
import ButtonPreviewVue from "../previews/ButtonPreview.vue";
import ClipboardPreviewVue from "../previews/ClipboardPreview.vue";
import TableOfContentsPreviewVue from "../previews/TableOfContentsPreview.vue";

/**
 * One component's specimen at thumbnail size, rendered but never hydrated.
 *
 * @remarks
 * The index shows forty at once, so each is rendered to real markup at build time and
 * ships no JavaScript: the classes, the anatomy and the `data-slot` attributes are the
 * than as a flag on it because a client directive is written or not written, and cannot
 * be decided by a prop.
 */
interface Props {
  /** Exported component name, as it appears in a content entry. */
  name: string;
  framework: Framework;
}

const { name, framework } = Astro.props;
const react = framework === "react";
const vue = framework === "vue";
---

{react && name === "Accordion" && <AccordionPreview />}
{react && name === "Button" && <ButtonPreview />}
{react && name === "Clipboard" && <ClipboardPreview />}
{react && name === "TableOfContents" && <TableOfContentsPreview />}

{vue && name === "Accordion" && <AccordionPreviewVue />}
{vue && name === "Button" && <ButtonPreviewVue />}
{vue && name === "Clipboard" && <ClipboardPreviewVue />}
{vue && name === "TableOfContents" && <TableOfContentsPreviewVue />}
