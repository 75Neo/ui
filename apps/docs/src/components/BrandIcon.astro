---
import * as icons from "simple-icons";

/**
 * A brand mark, drawn from Simple Icons.
 *
 * @remarks
 * Lucide dropped its brand icons, and a trademark is the one glyph that cannot be
 * approximated. The lookup runs at build time and the path is inlined, so the package
 * reaches no browser. The mark is decorative, like every other icon here: whatever
 * contains it carries the name.
 */
interface Props {
  /** A Simple Icons slug, as in `github` or `visual-studio-code`. */
  name: string;
  /** Edge length in pixels. */
  size?: number;
  class?: string;
}

const { name, size = 16, class: className } = Astro.props;

/** Simple Icons exports a hyphenated slug camel-cased, so `x-y` is `siXY`. */
const camel = name
  .split("-")
  .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
  .join("");
const icon = (icons as Record<string, { path: string } | undefined>)[`si${camel}`];

if (!icon) throw new Error(`Simple Icons has no icon named "${name}"`);
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="currentColor"
  aria-hidden="true"
  class={className}
>
  <path d={icon.path} />
</svg>
