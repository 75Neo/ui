---
import type { TableOfContentsItem } from "@75neo/themes";
import Base from "./Base.astro";
import CopyMarkdown from "../components/CopyMarkdown.astro";
import Sidebar from "../components/Sidebar.astro";
import TocRail from "../components/TocRail.astro";
import { shell, stickyColumn } from "../lib/layout";
import { type Framework, frameworkFacts } from "../lib/framework";
import type { SidebarLink } from "../lib/navigation";
import type { SearchEntry } from "../lib/search";

/**
 * The documentation shell: a column of pages, an article, and a rail of headings.
 *
 * @remarks
 * The two outer columns are sticky and scroll on their own, so a long components list
 * and a long article never drag each other around. The article sits on a card because
 * the page behind it is the muted surface: that one step of elevation is what separates
 * the thing being read from the furniture around it, and it is the only elevation on
 * the page.
 */
interface Props {
  title: string;
  description: string;
  framework: Framework;
  /** The components section of the sidebar. */
  components: SidebarLink[];
  /** The headings the rail tracks. Empty on a page with nothing to track. */
  headings: TableOfContentsItem[];
  entries: SearchEntry[];
  /** The page's own Markdown, offered to the reader as a copy button. */
  source?: string;
}

const { title, description, framework, components, headings, entries, source } = Astro.props;
const facts = frameworkFacts[framework];
const path = Astro.url.pathname.replace(/\/$/, "");
---

<Base
  title={`${title} · ${facts.label} · 75NeoUI`}
  description={description}
  framework={framework}
  entries={entries}
  hasSidebar
>
  {
    /*
     * `data-framework` is what hides the code fences belonging to the other adapter.
     * It sits on the whole page rather than on the prose, so a specimen or a panel
     * outside the article can key off it too.
     */
  }
  <div data-framework={framework} class={shell}>
    <div
      class="grid items-start gap-x-8 lg:grid-cols-[14rem_minmax(0,1fr)] xl:grid-cols-[14rem_minmax(0,1fr)_13rem]"
    >
      <aside
        id="page-nav"
        data-page-nav
        data-open="false"
        transition:persist={`sidebar-${framework}`}
        class={`border-muted border-b py-2 lg:border-b-0 lg:py-0 ${stickyColumn}`}
      >
        <Sidebar framework={framework} components={components} path={path} />
      </aside>

      <main id="content" class="min-w-0 py-4 lg:py-6">
        <article class="border-muted bg-default rounded-2xl border px-5 py-8 sm:px-8 sm:py-10">
          <div class="flex items-start justify-between gap-6">
            <div class="min-w-0">
              <h1
                class="text-highlighted text-3xl font-semibold tracking-[-0.03em] text-balance sm:text-[2rem]"
              >
                {title}
              </h1>
              <p class="text-muted mt-3 max-w-[62ch] text-[0.9375rem]/7 text-pretty">
                {description}
              </p>
            </div>

            {source && <CopyMarkdown source={source} />}
          </div>

          <slot />
        </article>
      </main>

      {
        headings.length > 0 && (
          <aside class={`hidden xl:block ${stickyColumn}`}>
            <div class="py-6">
              <TocRail framework={framework} items={headings} />
            </div>
          </aside>
        )
      }
    </div>
  </div>
</Base>
