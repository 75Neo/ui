---
import { ArrowLeft, ArrowRight } from "@lucide/astro";
import type { TableOfContentsItem } from "../lib/navigation";
import Base from "./Base.astro";
import PageActions from "../components/PageActions.astro";
import Sidebar from "../components/Sidebar.astro";
import TocRail from "../components/TocRail.astro";
import { shell, stickyColumn } from "../lib/layout";
import { type Framework, frameworkFacts } from "../lib/framework";
import type { SidebarLink } from "../lib/navigation";
import type { SearchEntry } from "../lib/search";

/**
 * The documentation shell: a column of pages, an article, and a rail of headings.
 *
 * @remarks
 * Three columns divided by hairlines, and the two outer ones scroll on their own so a
 * long list and a long article never drag each other around. The article sits on the
 * page's own surface rather than on a card: a page whose subject is a component should
 * put nothing between the reader and the component.
 */
interface Props {
  title: string;
  description: string;
  framework: Framework;
  /** The components section of the sidebar. */
  components: SidebarLink[];
  /** The headings the rail tracks. Empty on a page with nothing to track. */
  headings: TableOfContentsItem[];
  entries: SearchEntry[];
  /** The page's own Markdown, offered to the reader as a copy button. */
  source?: string;
  /** Where that Markdown is served, for the menu beside the copy button. */
  markdown?: string;
  /** The pages either side of this one, in the order the sidebar lists them. */
  previous?: { href: string; label: string };
  next?: { href: string; label: string };
}

const {
  title,
  description,
  framework,
  components,
  headings,
  entries,
  source,
  markdown,
  previous,
  next,
} = Astro.props;

const facts = frameworkFacts[framework];
const path = Astro.url.pathname.replace(/\/$/, "");
const hasRail = headings.length > 0;

const step =
  "group border-default hover:bg-elevated flex min-w-0 flex-col gap-1 rounded-lg border px-4 py-3 transition-colors";
---

<Base
  title={`${title} · ${facts.label} · 75NeoUI`}
  description={description}
  framework={framework}
  entries={entries}
  hasSidebar
>
  {
    /*
     * `data-framework` hides the other adapter's fences. It sits on the whole page, so a
     * specimen or a panel outside the article can key off it too.
     */
  }
  <div data-framework={framework} class={shell}>
    <div
      class:list={[
        "grid items-start lg:grid-cols-[15rem_minmax(0,1fr)]",
        hasRail && "xl:grid-cols-[15rem_minmax(0,1fr)_14rem]",
      ]}
    >
      <aside
        id="page-nav"
        data-page-nav
        data-column
        transition:persist={`sidebar-${framework}`}
        data-open="false"
        class={`border-default border-b lg:border-b-0 lg:border-e lg:pe-4 ${stickyColumn}`}
      >
        <Sidebar framework={framework} components={components} path={path} />
      </aside>

      <main id="content" class="min-w-0 py-10 lg:ps-8 xl:pe-8">
        <div class="flex items-start justify-between gap-6">
          <h1 class="text-highlighted text-3xl font-semibold tracking-tight text-balance">
            {title}
          </h1>

          {
            source && markdown && (
              <PageActions
                source={source}
                markdown={markdown}
                previous={previous}
                next={next}
              />
            )
          }
        </div>

        <p class="text-muted mt-2 max-w-[70ch] text-base/7 text-pretty">{description}</p>

        <slot />

        {
          (previous || next) && (
            <nav aria-label="Pages" class="border-default mt-16 grid gap-3 border-t pt-8 sm:grid-cols-2">
              {previous ? (
                <a href={previous.href} class={step}>
                  <span class="text-dimmed flex items-center gap-1.5 text-xs">
                    <ArrowLeft size={13} aria-hidden="true" />
                    Previous
                  </span>
                  <span class="text-highlighted truncate text-sm font-medium">
                    {previous.label}
                  </span>
                </a>
              ) : (
                <span />
              )}

              {next && (
                <a href={next.href} class={`${step} sm:items-end sm:text-end`}>
                  <span class="text-dimmed flex items-center gap-1.5 text-xs">
                    Next
                    <ArrowRight size={13} aria-hidden="true" />
                  </span>
                  <span class="text-highlighted truncate text-sm font-medium">{next.label}</span>
                </a>
              )}
            </nav>
          )
        }
      </main>

      {
        hasRail && (
          <aside data-column class={`hidden xl:block ${stickyColumn} border-default xl:border-s xl:ps-6`}>
            <div class="py-10">
              <TocRail framework={framework} items={headings} />
            </div>
          </aside>
        )
      }
    </div>
  </div>
</Base>
