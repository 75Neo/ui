---
import { ClientRouter } from "astro:transitions";
import "../assets/css/main.css";
import SiteHeader from "../components/SiteHeader.astro";
import { shell } from "../lib/layout";
import type { Framework } from "../lib/framework";
import type { SearchEntry } from "../lib/search";

interface Props {
  title: string;
  description: string;
  /**
   * The adapter this page documents. Absent on the landing page, which belongs to
   * neither, and where the switcher would have nothing to switch.
   */
  framework?: Framework;
  /** Every page the search dialog can reach from here. */
  entries: SearchEntry[];
  /** Whether the page has a sidebar the narrow layout needs a button for. */
  hasSidebar?: boolean;
  /**
   * Whether to close the page with the site footer. The documentation shell fills the
   * viewport and scrolls its middle column, so a footer under it would only ever be
   * reachable by scrolling past the end of an article.
   */
  footer?: boolean;
}

const {
  title,
  description,
  framework,
  entries,
  hasSidebar = false,
  footer = false,
} = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/logo-brand.svg" type="image/svg+xml" />
    <link rel="icon" href="/logo-brand.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/logo-brand.png" />

    {
      /*
       * Client-side routing. A navigation swaps the head and the body and leaves the
       * root element alone, which is where the theme lives, so the page never repaints
       * from scratch and never flashes the wrong theme on the way.
       */
    }
    <ClientRouter />

    <script is:inline>
      // Runs before first paint so the page never flashes the wrong theme.
      (() => {
        const root = document.documentElement;
        let theme = "auto";
        try {
          theme = localStorage.getItem("neo-theme") ?? "auto";
        } catch {
          // Storage can throw in a locked-down browser; the default stands.
        }
        root.dataset.theme = theme;
        root.classList.toggle(
          "dark",
          theme === "dark"
            || (theme === "auto" && window.matchMedia("(prefers-color-scheme: dark)").matches),
        );
      })();
    </script>
  </head>

  <body class="bg-muted text-default font-sans antialiased">
    <a
      href="#content"
      class="bg-inverted text-inverted sr-only rounded-lg px-4 py-2 text-sm font-medium focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-skip-link"
    >
      Skip to content
    </a>

    <SiteHeader framework={framework} path={path} entries={entries} hasSidebar={hasSidebar} />

    <slot />

    {
      footer && (
        <footer class="border-muted border-t">
          <div class={`${shell} flex flex-wrap items-center justify-between gap-x-8 gap-y-3 py-8`}>
            <p class="text-dimmed max-w-[58ch] text-xs/6">
              Every props table on this site is read out of{" "}
              <code class="text-muted" data-identifier>
                packages/*/src
              </code>{" "}
              at build time, so a renamed prop changes the docs or fails the build.
            </p>
            <a
              href="https://github.com/75Neo/ui"
              class="text-muted hover:text-highlighted rounded-sm font-mono text-xs"
              data-identifier
            >
              github.com/75Neo/ui
            </a>
          </div>
        </footer>
      )
    }

    <script>
      /**
       * The chrome's two stateful controls, bound once for the whole visit.
       *
       * @remarks
       * Everything here is delegated from `document`, because client-side navigation
       * replaces the body and would otherwise leave every listener attached to an
       * element no longer on the page.
       *
       * The choice itself is held here rather than read back off the root element,
       * because a swap rewrites the root element's attributes from the incoming
       * document: `data-theme` and the `dark` class are both gone by the time the new
       * page is in place. So they are put back on `astro:after-swap`, which runs before
       * the browser paints, and the reader never sees the light theme flash past.
       */
      const root = document.documentElement;
      const media = window.matchMedia("(prefers-color-scheme: dark)");

      /** `"light"`, `"dark"` or `"auto"`. */
      let theme = root.dataset.theme ?? "auto";

      const apply = () => {
        root.dataset.theme = theme;
        root.classList.toggle("dark", theme === "dark" || (theme === "auto" && media.matches));

        for (const button of document.querySelectorAll<HTMLElement>("[data-theme-option]")) {
          button.setAttribute("aria-pressed", String(theme === button.dataset.themeOption));
        }
      };

      /*
       * The sidebar is carried across navigations so its scroll position survives, which
       * means the row it marks as current is the one from the page before. Nothing else
       * on the page needs this: everything else is rendered fresh by the swap.
       */
      const markCurrent = () => {
        const here = window.location.pathname.replace(/\/$/, "") || "/";
        for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-page-nav] a")) {
          const href = new URL(link.href).pathname.replace(/\/$/, "") || "/";
          if (href === here) link.setAttribute("aria-current", "page");
          else link.removeAttribute("aria-current");
        }
      };

      document.addEventListener("click", (event) => {
        const target = event.target as HTMLElement | null;

        const option = target?.closest<HTMLElement>("[data-theme-option]");
        if (option?.dataset.themeOption) {
          theme = option.dataset.themeOption;
          try {
            localStorage.setItem("neo-theme", theme);
          } catch {
            // Nothing to persist to; the choice still applies to this visit.
          }
          apply();
          return;
        }

        const toggle = target?.closest<HTMLElement>("[data-nav-toggle]");
        if (toggle) {
          const panel = document.querySelector<HTMLElement>("[data-page-nav]");
          if (!panel) return;
          const open = panel.dataset.open !== "true";
          panel.dataset.open = String(open);
          toggle.setAttribute("aria-expanded", String(open));
          return;
        }

        // A tap on a link inside the narrow-layout navigation puts it away again.
        if (target?.closest("[data-page-nav] a")) {
          const panel = document.querySelector<HTMLElement>("[data-page-nav]");
          const button = document.querySelector<HTMLElement>("[data-nav-toggle]");
          if (panel && window.matchMedia("(width < 64rem)").matches) {
            panel.dataset.open = "false";
            button?.setAttribute("aria-expanded", "false");
          }
        }
      });

      media.addEventListener("change", apply);
      document.addEventListener("astro:after-swap", () => {
        apply();
        markCurrent();
      });

      apply();
      markCurrent();
    </script>
  </body>
</html>
