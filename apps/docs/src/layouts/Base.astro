---
import { ClientRouter } from "astro:transitions";
import "../assets/css/main.css";
import SiteHeader from "../components/SiteHeader.astro";
import { shell } from "../lib/layout";
import type { Framework } from "../lib/framework";
import type { SearchEntry } from "../lib/search";

interface Props {
  title: string;
  description: string;
  /** The adapter this page documents. Absent on the landing page, which has neither. */
  framework?: Framework;
  /** Every page the search dialog can reach from here. */
  entries: SearchEntry[];
  /** Whether the page has a sidebar the narrow layout needs a button for. */
  hasSidebar?: boolean;
  /**
   * Whether to close the page with the site footer. The doc shell scrolls its own middle
   * column, so a footer under it would sit past the end of every article.
   */
  footer?: boolean;
}

const {
  title,
  description,
  framework,
  entries,
  hasSidebar = false,
  footer = false,
} = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/logo-brand.svg" type="image/svg+xml" />
    <link rel="icon" href="/logo-brand.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/logo-brand.png" />

    <ClientRouter />

    <script is:inline>
      // Runs before first paint so the page never flashes the wrong theme.
      (() => {
        const root = document.documentElement;
        let theme = "auto";
        try {
          theme = localStorage.getItem("neo-theme") ?? "auto";
        } catch {
          // Storage can throw in a locked-down browser; the default stands.
        }
        root.dataset.theme = theme;
        root.classList.toggle(
          "dark",
          theme === "dark"
            || (theme === "auto" && window.matchMedia("(prefers-color-scheme: dark)").matches),
        );
      })();
    </script>
  </head>

  <body class="bg-default text-default font-sans antialiased">
    <a
      href="#content"
      class="bg-inverted text-inverted sr-only rounded-md px-4 py-2 text-sm font-medium focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50"
    >
      Skip to content
    </a>

    <SiteHeader framework={framework} path={path} entries={entries} hasSidebar={hasSidebar} />

    <slot />

    {
      footer && (
        <footer class="border-default border-t">
          <div class={`${shell} flex flex-wrap items-center justify-between gap-x-8 gap-y-3 py-8`}>
            <p class="text-dimmed max-w-[58ch] text-xs/6">
              Every props table on this site is read out of{" "}
              <code class="text-muted" data-identifier>
                packages/*/src
              </code>{" "}
              at build time, so a renamed prop changes the docs or fails the build.
            </p>
            <a
              href="https://github.com/75Neo/ui"
              class="text-muted hover:text-highlighted rounded-sm font-mono text-xs"
              data-identifier
            >
              github.com/75Neo/ui
            </a>
          </div>
        </footer>
      )
    }

    <script>
      /**
       * The chrome's stateful controls, bound once for the whole visit.
       *
       * @remarks
       * Listeners are delegated from `document`, because a navigation replaces the body.
       * The theme is held here rather than read off the root element, whose attributes a
       * swap rewrites from the incoming document, and is put back on `astro:after-swap`
       * before the browser paints.
       */
      const root = document.documentElement;
      const media = window.matchMedia("(prefers-color-scheme: dark)");

      /** `"light"`, `"dark"` or `"auto"`. */
      let theme = root.dataset.theme ?? "auto";

      const apply = () => {
        root.dataset.theme = theme;
        root.classList.toggle("dark", theme === "dark" || (theme === "auto" && media.matches));

        for (const button of document.querySelectorAll<HTMLElement>("[data-theme-option]")) {
          button.setAttribute("aria-checked", String(theme === button.dataset.themeOption));
        }
      };

      /** The persisted sidebar keeps the previous page's current row, so move it here. */
      const markCurrent = () => {
        const here = window.location.pathname.replace(/\/$/, "") || "/";
        for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-page-nav] a")) {
          const href = new URL(link.href).pathname.replace(/\/$/, "") || "/";
          if (href === here) link.setAttribute("aria-current", "page");
          else link.removeAttribute("aria-current");
        }
      };

      /**
       * Put every menu away. They are `details` elements, so this is one attribute
       * each, and `except` is the one the reader just clicked inside.
       */
      const closeMenus = (except?: Element | null) => {
        for (const menu of document.querySelectorAll<HTMLDetailsElement>("[data-menu]")) {
          if (menu !== except) menu.removeAttribute("open");
        }
      };

      document.addEventListener("click", (event) => {
        const target = event.target as HTMLElement | null;

        closeMenus(target?.closest("[data-menu]"));

        const option = target?.closest<HTMLElement>("[data-theme-option]");
        if (option?.dataset.themeOption) {
          theme = option.dataset.themeOption;
          try {
            localStorage.setItem("neo-theme", theme);
          } catch {
            // Nothing to persist to; the choice still applies to this visit.
          }
          apply();
          closeMenus();
          return;
        }

        const toggle = target?.closest<HTMLElement>("[data-nav-toggle]");
        if (toggle) {
          const panel = document.querySelector<HTMLElement>("[data-page-nav]");
          if (!panel) return;
          const open = panel.dataset.open !== "true";
          panel.dataset.open = String(open);
          toggle.setAttribute("aria-expanded", String(open));
          return;
        }

        // A tap on a link inside the narrow-layout navigation puts it away again.
        if (target?.closest("[data-page-nav] a")) {
          const panel = document.querySelector<HTMLElement>("[data-page-nav]");
          const button = document.querySelector<HTMLElement>("[data-nav-toggle]");
          if (panel && window.matchMedia("(width < 64rem)").matches) {
            panel.dataset.open = "false";
            button?.setAttribute("aria-expanded", "false");
          }
        }
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") closeMenus();
      });

      media.addEventListener("change", apply);
      document.addEventListener("astro:after-swap", () => {
        apply();
        markCurrent();
      });

      apply();
      markCurrent();
    </script>

    <script>
      /**
       * A copy button on every code block.
       *
       * @remarks
       * Shiki hands back a bare `pre`, so the button needs a positioned box around it:
       * one wrapper per block, added after each navigation and skipped on a block that
       * already has one. The click itself is delegated from `document`, like every
       * other listener in the chrome.
       */
      const wrap = () => {
        for (const block of document.querySelectorAll<HTMLPreElement>(".prose pre")) {
          if (block.parentElement?.classList.contains("code-block")) continue;

          const wrapper = document.createElement("div");
          wrapper.className = "code-block";
          block.replaceWith(wrapper);
          wrapper.append(block);

          const button = document.createElement("button");
          button.type = "button";
          button.dataset.copyCode = "";
          button.className =
            "bg-default text-dimmed hover:text-highlighted ring-default cursor-pointer"
            + " rounded-md p-1.5 ring transition-colors";
          button.setAttribute("aria-label", "Copy code");
          button.innerHTML =
            '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"'
            + ' stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">'
            + '<rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>'
            + '<path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>';
          wrapper.append(button);
        }
      };

      document.addEventListener("click", async (event) => {
        const button = (event.target as HTMLElement | null)?.closest<HTMLElement>(
          "[data-copy-code]",
        );
        const code = button?.previousElementSibling?.textContent;
        if (!button || !code) return;

        try {
          await navigator.clipboard.writeText(code);
        } catch {
          // A denied permission or an insecure origin. Nothing to report on the button.
          return;
        }

        button.dataset.copied = "true";
        window.setTimeout(() => delete button.dataset.copied, 1600);
      });

      document.addEventListener("astro:page-load", wrap);
      wrap();
    </script>
  </body>
</html>
