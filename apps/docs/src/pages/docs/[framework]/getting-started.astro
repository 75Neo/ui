---
import { getEntry, render } from "astro:content";
import Doc from "../../../layouts/Doc.astro";
import Prose from "../../../components/Prose.astro";
import { type Framework, frameworkFacts, frameworks } from "../../../lib/framework";
import { componentLinks, railItems } from "../../../lib/navigation";
import { documentedComponents } from "../../../lib/components";
import { searchIndex } from "../../../lib/search";

export function getStaticPaths() {
  return frameworks.map((framework) => ({ params: { framework } }));
}

const framework = Astro.params.framework as Framework;
const facts = frameworkFacts[framework];

const entry = await getEntry("guides", "getting-started");

if (!entry) throw new Error("src/content/guides/getting-started.md is missing");

const { Content, headings } = await render(entry);
const components = await documentedComponents();

/*
 * The install command is copied rather than read, so it sits in a plain code block —
 * the chrome puts a copy button on every one. This was a Clipboard; the batch
 * migration restores that component and this block goes back to reaching for it.
 */
const install = `pnpm add ${facts.package}`;
const rail = [{ value: "install", depth: 2, label: "Install" }, ...railItems(headings)];
---

<Doc
  title={entry.data.title}
  description={entry.data.description}
  framework={framework}
  components={componentLinks(framework, components)}
  headings={rail}
  entries={searchIndex(framework, components)}
  source={entry.body}
  markdown="/raw/getting-started.md"
  next={{
    href: `/docs/${framework}/components`,
    label: "Components",
  }}
>
  <section aria-labelledby="install" class="mt-12">
    <h2 class="text-highlighted border-default border-t pt-8 text-2xl font-semibold tracking-tight" id="install">
      Install
    </h2>
    <p class="text-muted mt-4 max-w-[70ch] text-base/7 text-pretty">
      One package. It pulls <code
        class="bg-elevated text-toned rounded-sm px-1.5 py-0.5 font-mono text-[0.8125em]"
        data-identifier>@75neo/themes</code
      > in with it, so the styles arrive at the same time as the components. Needs {
        facts.requires
      }.
    </p>

    <div class="prose mt-5 max-w-[34rem]">
      <pre>{install}</pre>
    </div>

    <p class="text-dimmed mt-3 text-sm/6">
      Swap <code class="text-muted font-mono text-xs" data-identifier>pnpm add</code> for <code
        class="text-muted font-mono text-xs"
        data-identifier>npm install</code
      >, <code class="text-muted font-mono text-xs" data-identifier>yarn add</code> or <code
        class="text-muted font-mono text-xs"
        data-identifier>bun add</code
      > as you prefer.
    </p>
  </section>

  <Prose class="mt-2">
    <Content />
  </Prose>
</Doc>
