---
import { getEntry, render } from "astro:content";
import { Clipboard } from "@75neo/react";
import InstallCommandVue from "../../../previews/InstallCommand.vue";
import Doc from "../../../layouts/Doc.astro";
import Prose from "../../../components/Prose.astro";
import { type Framework, frameworkFacts, frameworks } from "../../../lib/framework";
import { componentLinks, railItems } from "../../../lib/navigation";
import { documentedComponents } from "../../../lib/components";
import { searchIndex } from "../../../lib/search";

export function getStaticPaths() {
  return frameworks.map((framework) => ({ params: { framework } }));
}

const framework = Astro.params.framework as Framework;
const facts = frameworkFacts[framework];

const entry = await getEntry("guides", "getting-started");

if (!entry) throw new Error("src/content/guides/getting-started.md is missing");

const { Content, headings } = await render(entry);
const components = await documentedComponents();

/*
 * The install command is copied rather than read, so it is a Clipboard rather than a
 * fence. It is also the only part of the guide that differs between adapters by more
 * than a language tag, which is why it lives here and the prose stays one file.
 */
const install = `pnpm add ${facts.package}`;
const rail = [{ value: "install", depth: 2, label: "Install" }, ...railItems(headings)];
---

<Doc
  title={entry.data.title}
  description={entry.data.description}
  framework={framework}
  components={componentLinks(framework, components)}
  headings={rail}
  entries={searchIndex(framework, components)}
  source={entry.body}
>
  <section aria-labelledby="install" class="mt-10 max-w-[46rem]">
    <h2 class="text-highlighted text-xl font-semibold tracking-[-0.02em]" id="install">
      Install
    </h2>
    <p class="text-muted mt-3 text-sm/7 text-pretty">
      One package. It pulls <code class="text-toned font-mono text-xs" data-identifier
        >@75neo/themes</code
      > in with it, so the styles arrive at the same time as the components. Needs {
        facts.requires
      }.
    </p>

    <div class="mt-5">
      {framework === "react" && <Clipboard value={install} size="lg" client:load />}
      {framework === "vue" && <InstallCommandVue value={install} client:load />}
    </div>

    <p class="text-dimmed mt-3 text-xs/6">
      Swap <code class="text-muted font-mono" data-identifier>pnpm add</code> for <code
        class="text-muted font-mono"
        data-identifier>npm install</code
      >, <code class="text-muted font-mono" data-identifier>yarn add</code> or <code
        class="text-muted font-mono"
        data-identifier>bun add</code
      > as you prefer.
    </p>
  </section>

  <Prose class="mt-4">
    <Content />
  </Prose>
</Doc>
