---
import Doc from "../../../../layouts/Doc.astro";
import ComponentCard from "../../../../components/ComponentCard.astro";
import { documentedComponents } from "../../../../lib/components";
import { componentLinks } from "../../../../lib/navigation";
import { searchIndex } from "../../../../lib/search";
import { type Framework, frameworkFacts, frameworks } from "../../../../lib/framework";

export function getStaticPaths() {
  return frameworks.map((framework) => ({ params: { framework } }));
}

const framework = Astro.params.framework as Framework;
const facts = frameworkFacts[framework];

const components = await documentedComponents();
---

<Doc
  title="Components"
  description={`Every component has a page of its own, with a live specimen and an API read out of the source at build time. The card below each name is ${facts.package} rendering for real, so it carries the same classes and the same slot names the page it links to documents.`}
  framework={framework}
  components={componentLinks(framework, components)}
  headings={[]}
  entries={searchIndex(framework, components)}
>
  <ul class="mt-10 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
    {
      components.map((component) => (
        <ComponentCard component={component} framework={framework} />
      ))
    }
  </ul>
</Doc>
