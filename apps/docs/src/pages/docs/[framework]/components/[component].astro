---
import { render } from "astro:content";
import Doc from "../../../../layouts/Doc.astro";
import Prose from "../../../../components/Prose.astro";
import Stage from "../../../../components/Stage.astro";
import ComponentApi from "../../../../components/ComponentApi.astro";
import Preview from "../../../../components/Preview.astro";
import { componentHref, documentedComponents } from "../../../../lib/components";
import { apiSections, componentLinks, railItems } from "../../../../lib/navigation";
import { hasPreview } from "../../../../lib/previews";
import { searchIndex } from "../../../../lib/search";
import { type Framework, docHref, frameworks } from "../../../../lib/framework";

/**
 * One page per component, per adapter. The content collection is the list of pages, so
 * one Markdown file grows a route under both frameworks, a sidebar row, an index card
 * and its place in the previous and next links.
 */
export async function getStaticPaths() {
  const components = await documentedComponents();

  return frameworks.flatMap((framework) =>
    components.map((component, index) => ({
      params: { framework, component: component.slug },
      props: {
        component,
        components,
        previous: components[index - 1],
        next: components[index + 1],
      },
    })),
  );
}

const framework = Astro.params.framework as Framework;
const { component, components, previous, next } = Astro.props;
const { entry, api, slug } = component;

const { Content, headings } = await render(entry);

// The prose subheadings first, then the generated tables, which is the order on the page.
const rail = [...railItems(headings), ...apiSections(api, framework)];
---

<Doc
  title={entry.data.name}
  description={entry.data.summary}
  framework={framework}
  components={componentLinks(framework, components)}
  headings={rail}
  entries={searchIndex(framework, components)}
  source={entry.body}
  markdown={`/raw/components/${slug}.md`}
  previous={previous
    ? { href: componentHref(framework, previous.slug), label: previous.entry.data.name }
    : { href: docHref(framework, "components"), label: "Components" }}
  next={next
    ? { href: componentHref(framework, next.slug), label: next.entry.data.name }
    : undefined}
>
  <p class="text-dimmed mt-3 font-mono text-xs" data-identifier>{entry.data.key}</p>

  {
    hasPreview(entry.data.name) && (
      <Stage class="mt-6">
        <Preview name={entry.data.name} framework={framework} />
      </Stage>
    )
  }

  <Prose class="mt-10">
    <Content />
  </Prose>

  <ComponentApi api={api} framework={framework} id={slug} />
</Doc>
