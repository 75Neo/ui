---
import { render } from "astro:content";
import { ArrowLeft, ArrowRight } from "@lucide/astro";
import Doc from "../../../../layouts/Doc.astro";
import Prose from "../../../../components/Prose.astro";
import Stage from "../../../../components/Stage.astro";
import ComponentApi from "../../../../components/ComponentApi.astro";
import Preview from "../../../../components/Preview.astro";
import { componentHref, documentedComponents } from "../../../../lib/components";
import { apiSections, componentLinks, railItems } from "../../../../lib/navigation";
import { hasPreview } from "../../../../lib/previews";
import { type Framework, frameworks } from "../../../../lib/framework";

/**
 * One page per component, per adapter.
 *
 * @remarks
 * The content collection is the list of pages. Adding a component to the docs is still
 * adding one Markdown file: it grows a route under both frameworks, a row in the
 * sidebar, a card on the index, and its place in the previous and next links, without
 * any of those being written down a second time.
 */
export async function getStaticPaths() {
  const components = await documentedComponents();

  return frameworks.flatMap((framework) =>
    components.map((component, index) => ({
      params: { framework, component: component.slug },
      props: {
        component,
        components,
        previous: components[index - 1],
        next: components[index + 1],
      },
    })),
  );
}

const framework = Astro.params.framework as Framework;
const { component, components, previous, next } = Astro.props;
const { entry, api, slug } = component;

const { Content, headings } = await render(entry);

/*
 * The prose subheadings first, then the generated tables, which is the order they
 * appear in. The API headings are rendered by a component rather than written in
 * Markdown, so `render()` knows nothing about them.
 */
const rail = [...railItems(headings), ...apiSections(api, framework)];

const step =
  "group border-muted flex min-w-0 flex-col gap-1 rounded-lg border px-4 py-3 hover:border-accented";
---

<Doc
  eyebrow="component"
  title={entry.data.name}
  description={entry.data.summary}
  framework={framework}
  components={componentLinks(framework, components)}
  headings={rail}
>
  <p class="text-dimmed font-mono text-xs" data-identifier>{entry.data.key}</p>

  {
    hasPreview(entry.data.name) && (
      <Stage class="mt-5">
        <Preview name={entry.data.name} framework={framework} />
      </Stage>
    )
  }

  <Prose class="mt-10">
    <Content />
  </Prose>

  <ComponentApi api={api} framework={framework} id={slug} />

  <nav
    aria-label="Components"
    class="border-muted mt-16 grid gap-3 border-t pt-8 sm:grid-cols-2"
  >
    {
      previous ? (
        <a href={componentHref(framework, previous.slug)} class={step}>
          <span
            class="text-dimmed flex items-center gap-1.5 font-mono text-[0.6875rem]"
            data-identifier
          >
            <ArrowLeft size={12} aria-hidden="true" />
            previous
          </span>
          <span class="text-highlighted group-hover:text-primary truncate text-sm font-medium">
            {previous.entry.data.name}
          </span>
        </a>
      ) : (
        <span />
      )
    }

    {
      next && (
        <a href={componentHref(framework, next.slug)} class={`${step} sm:items-end sm:text-end`}>
          <span
            class="text-dimmed flex items-center gap-1.5 font-mono text-[0.6875rem]"
            data-identifier
          >
            next
            <ArrowRight size={12} aria-hidden="true" />
          </span>
          <span class="text-highlighted group-hover:text-primary truncate text-sm font-medium">
            {next.entry.data.name}
          </span>
        </a>
      )
    }
  </nav>
</Doc>
