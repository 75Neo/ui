---
import Layout from "../layouts/Layout.astro";

const packages = [
  { name: "@75neo/react", description: "Components for React 18+" },
  { name: "@75neo/vue", description: "Components for Vue 3.5+" },
  { name: "@75neo/svelte", description: "Components for Svelte 5" },
  { name: "@75neo/styles", description: "Shared Panda CSS preset and runtime" },
];
---

<Layout title="75NeoUI">
  <main>
    <h1>75NeoUI</h1>
    <p>An Ark UI + Panda CSS component library for React, Vue and Svelte.</p>
    <ul>
      {
        packages.map((pkg) => (
          <li>
            <code>{pkg.name}</code> — {pkg.description}
          </li>
        ))
      }
    </ul>
  </main>
</Layout>
