---
import { ArrowRight } from "@lucide/astro";
import { Code } from "astro:components";
import { themeColors } from "@75neo/themes";
import { Clipboard } from "@75neo/react";
import Base from "../layouts/Base.astro";
import BrandIcon from "../components/BrandIcon.astro";
import ComponentCard from "../components/ComponentCard.astro";
import { shell } from "../lib/layout";
import { documentedComponents } from "../lib/components";
import { searchIndex } from "../lib/search";
import { ButtonPreview } from "../previews/ButtonPreview";
import { SelectPreview } from "../previews/SelectPreview";
import { SliderPreview } from "../previews/SliderPreview";
import { SwitchPreview } from "../previews/SwitchPreview";
import { docHref, frameworkFacts, frameworks } from "../lib/framework";

const components = await documentedComponents();

/** The strengths a recipe may spend a color at, documented in `themes/src/colors.ts`. */
const strengths = [
  { class: "bg-primary/10", label: "/10", note: "A soft, tinted fill." },
  { class: "bg-primary/15", label: "/15", note: "That fill, hovered." },
  { class: "bg-primary/25", label: "/25", note: "A hairline ring, and focus." },
  { class: "bg-primary/50", label: "/50", note: "A ring that reads as a border." },
  { class: "bg-primary/75", label: "/75", note: "A solid fill, hovered." },
  { class: "bg-primary", label: "full", note: "A solid fill, or text." },
];

/** `code` is the part of a layer's name that is an identifier rather than a word. */
const layers = [
  { name: "The recipe", note: "What the component looks like before anyone says anything." },
  { name: "Every", code: "Theme", after: "above it", note: "Already folded into one config." },
  { name: "The", code: "ui", after: "prop", note: "This call site, per slot." },
  { code: "class", note: "This call site, reaching the base slot only." },
];

/* The same call in each framework, so a reader can see what their own would look like. */
const sample = {
  react: `import { ArrowRight } from "lucide-react";
import { Button } from "@75neo/react";

<Button
  variant="soft"
  color="success"
  size="lg"
  trailingIcon={<ArrowRight />}
  ui={{ label: "tracking-wide" }}
>
  Continue
</Button>`,
  vue: `<script setup lang="ts">
import { ArrowRight } from "@lucide/vue";
import { Button } from "@75neo/vue";
</script>

<Button
  variant="soft"
  color="success"
  size="lg"
  :ui="{ label: 'tracking-wide' }"
>
  Continue
  <template #trailing><ArrowRight /></template>
</Button>`,
};

/** A sample of the reference, as a wall under the fold. */
const wall = components.slice(0, 9);

const shiki = { light: "github-light", dark: "github-dark" } as const;

const specimenCard = "border-default bg-default overflow-hidden rounded-lg border px-4 py-3.5";
const specimenLabel = "text-dimmed mb-3 block font-mono text-xs";
const frameHeader =
  "bg-muted border-default flex items-center justify-between gap-3 border-b px-4 py-2.5";
const sectionHeading = "text-highlighted text-2xl font-semibold tracking-tight text-balance";
const step = "text-dimmed font-mono text-xs";
---

<Base
  title="75NeoUI · A component library for React and Vue"
  description="A component library for React and Vue. Behaviour from Ark UI, styling from Tailwind CSS and Tailwind Variants, and theming through CSS custom properties you can redefine."
  entries={searchIndex("react", components)}
  footer
>
  <main id="content">
    <section class="border-default bg-default border-b">
      <div
        class={`${shell} grid items-center gap-12 py-16 lg:grid-cols-[minmax(0,30rem)_minmax(0,1fr)] lg:gap-20 lg:py-24`}
      >
        <div>
          <h1
            class="text-highlighted text-4xl font-semibold tracking-tighter text-balance sm:text-5xl lg:text-[3.25rem] lg:leading-[1.06]"
          >
            A component library for React and Vue.
          </h1>
          <p class="text-muted mt-6 max-w-[46ch] text-base/7 text-pretty">
            Behaviour and accessibility from Ark UI, styling from Tailwind CSS, and
            theming through CSS custom properties you can redefine.
          </p>

          <ul class="mt-7 flex flex-wrap gap-2.5">
            {
              frameworks.map((framework) => (
                <li class="border-default flex items-center gap-2.5 rounded-lg border px-3 py-2">
                  <BrandIcon
                    name={frameworkFacts[framework].brand}
                    size={17}
                    class="text-toned shrink-0"
                  />
                  <span class="text-highlighted text-sm font-medium">
                    {frameworkFacts[framework].label}
                  </span>
                  <span class="text-dimmed font-mono text-xs" data-identifier>
                    {frameworkFacts[framework].requires.replace(/^\w+\s/, "")}
                  </span>
                </li>
              ))
            }
          </ul>

          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a
              href={docHref("react", "getting-started")}
              class="bg-inverted text-inverted hover:bg-inverted/90 outline-inverted/25 inline-flex items-center rounded-md px-3 py-2 text-base font-medium transition-colors focus-visible:outline-3"
            >
              Get started
            </a>
            <a
              href={docHref("react", "components")}
              class="text-default ring-accented hover:bg-elevated bg-default outline-inverted/25 inline-flex items-center gap-2 rounded-md px-3 py-2 text-base font-medium ring ring-inset transition-colors focus-visible:outline-3"
            >
              Browse components
              <ArrowRight size={15} aria-hidden="true" />
            </a>
          </div>
        </div>

        {
          /*
           * Hydrated, so a reader can work the library before reading a word. All four
           * have a settled footprint: working them changes what they show and never how
           * much room it takes. An Accordion here opened its panel into the grid row and
           * moved the headline beside it, so the page shifted under the reader.
           */
        }
        <div
          data-stage
          class="border-default grid gap-3 rounded-lg border p-3 sm:grid-cols-2 sm:p-4"
        >
          <div class={specimenCard}>
            <span class={specimenLabel} data-identifier>button</span>
            <ButtonPreview client:visible />
          </div>
          <div class={specimenCard}>
            <span class={specimenLabel} data-identifier>select</span>
            <SelectPreview client:visible />
          </div>
          <div class={specimenCard}>
            <span class={specimenLabel} data-identifier>switch</span>
            <SwitchPreview client:visible />
          </div>
          <div class={specimenCard}>
            <span class={specimenLabel} data-identifier>slider</span>
            <SliderPreview client:visible />
          </div>
        </div>
      </div>
    </section>

    <section aria-labelledby="install" class="border-default bg-default border-b">
      <div class={`${shell} grid gap-10 py-14 lg:grid-cols-2 lg:gap-16 lg:py-20`}>
        <div>
          <p class={step} data-identifier>step 1</p>
          <h2 id="install" class={`${sectionHeading} mt-2`}>Install the adapter</h2>
          <p class="text-muted mt-3 max-w-[46ch] text-sm/6 text-pretty">
            Either package brings the themes package in with it, so the styles arrive at
            the same time as the components.
          </p>

          <div class="mt-6 flex flex-col gap-3">
            {
              frameworks.map((framework) => (
                <div class="flex items-center gap-3">
                  <BrandIcon
                    name={frameworkFacts[framework].brand}
                    size={16}
                    class="text-dimmed w-5 shrink-0"
                  />
                  <Clipboard
                    className="min-w-0 flex-1"
                    value={`pnpm add ${frameworkFacts[framework].package}`}
                    client:visible
                  />
                </div>
              ))
            }
          </div>
        </div>

        <div>
          <p class={step} data-identifier>step 2</p>
          <h2 class={`${sectionHeading} mt-2`}>Import the stylesheet</h2>
          <p class="text-muted mt-3 max-w-[46ch] text-sm/6 text-pretty">
            Two lines in the stylesheet your app already loads. That brings the tokens,
            the light and dark variants, and the base layer. Dark mode is a
            <code class="text-toned font-mono text-xs" data-identifier>.dark</code> class
            on a root element, so a theme toggle only has to move that class.
          </p>

          <Code
            code={`@import "tailwindcss";
@import "@75neo/themes";`}
            lang="css"
            themes={shiki}
            class="border-default !bg-muted mt-6 overflow-x-auto rounded-lg border p-5 text-[0.8125rem]/[1.7]"
          />
        </div>
      </div>
    </section>

    <section aria-labelledby="usage" class="border-default bg-default border-b">
      <div class={`${shell} py-14 lg:py-20`}>
        <p class={step} data-identifier>step 3</p>
        <h2 id="usage" class={`${sectionHeading} mt-2`}>Render a component</h2>
        <p class="text-muted mt-3 max-w-[62ch] text-sm/6 text-pretty">
          The same props, the same variant values and the same slot names in both
          adapters. What changes between these two is what the frameworks themselves
          spell differently.
        </p>

        <div class="border-default mt-8 overflow-hidden rounded-lg border">
          <div class="grid lg:grid-cols-2">
            {
              frameworks.map((framework, index) => (
                <article
                  class:list={[
                    "min-w-0",
                    index === 0 && "border-default border-b lg:border-e lg:border-b-0",
                  ]}
                >
                  <header class={frameHeader}>
                    <h3 class="text-highlighted flex items-center gap-2 text-xs leading-none">
                      <BrandIcon
                        name={frameworkFacts[framework].brand}
                        size={13}
                        class="text-dimmed shrink-0"
                      />
                      <span class="font-mono" data-identifier>
                        {framework}
                      </span>
                    </h3>
                    <span
                      class="text-dimmed font-mono text-[0.6875rem] leading-none"
                      data-identifier
                    >
                      {frameworkFacts[framework].package}
                    </span>
                  </header>
                  <Code
                    code={sample[framework]}
                    lang={frameworkFacts[framework].language}
                    themes={shiki}
                    class="!bg-default overflow-x-auto p-5 text-[0.8125rem]/[1.7]"
                  />
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section aria-labelledby="cascade" class="border-default bg-default border-b">
      <div
        class={`${shell} grid gap-10 py-14 lg:grid-cols-[minmax(0,24rem)_minmax(0,1fr)] lg:gap-20 lg:py-20`}
      >
        <div>
          <p class={step} data-identifier>step 4</p>
          <h2 id="cascade" class={`${sectionHeading} mt-2`}>Restyle it</h2>
          <p class="text-muted mt-3 max-w-[44ch] text-sm/6 text-pretty">
            Four layers can set a component's classes, and they fold weakest first.
            Tailwind-merge settles conflicts, so a later layer replaces the utility it
            conflicts with and every other utility survives.
          </p>
          <a
            href={docHref("react", "getting-started")}
            class="text-muted hover:text-highlighted mt-5 inline-flex items-center gap-2 rounded-sm text-sm font-medium"
          >
            How to reach each layer
            <ArrowRight size={15} aria-hidden="true" />
          </a>
        </div>

        <ol class="divide-default border-default max-w-[46rem] divide-y border-t">
          {
            layers.map(({ name, code, after, note }, index) => (
              <li class="flex gap-6 py-4">
                <span class="text-dimmed w-4 shrink-0 pt-0.5 font-mono text-xs" data-identifier>
                  {index + 1}
                </span>
                <div class="min-w-0">
                  <p class="text-highlighted flex flex-wrap items-baseline gap-1.5 text-sm font-medium">
                    {name}
                    {code && (
                      <code class="text-toned font-mono text-xs" data-identifier>
                        {code}
                      </code>
                    )}
                    {after}
                  </p>
                  <p class="text-muted mt-1 text-sm/6 text-pretty">{note}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section aria-labelledby="color" class="border-default bg-default border-b">
      <div class={`${shell} py-14 lg:py-20`}>
        <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-5">
          <div>
            <h2 id="color" class={sectionHeading}>Rebrand with one line per color</h2>
            <p class="text-muted mt-4 max-w-[52ch] text-sm/6 text-pretty">
              Each semantic color is a single token, and a recipe asks for it at a
              different strength rather than reaching for a second one. So there is no
              hover token to retune and no border token to match.
            </p>
          </div>

          <div class="flex flex-wrap gap-1.5">
            {
              themeColors.map((color) => (
                <span
                  class="border-default text-toned rounded-lg border px-2 py-1 font-mono text-xs"
                  data-identifier
                >
                  {color}
                </span>
              ))
            }
            <span
              class="border-default text-dimmed rounded-lg border border-dashed px-2 py-1 font-mono text-xs"
              data-identifier
              title="No hue to spend, so it borrows the surface tokens"
            >
              neutral
            </span>
          </div>
        </div>

        <dl class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {
            strengths.map(({ class: swatch, label, note }) => (
              <div class="border-default flex items-center gap-4 rounded-lg border px-4 py-3.5">
                <span
                  class="size-9 shrink-0 overflow-hidden rounded-lg"
                  data-checker
                  aria-hidden="true"
                >
                  <span class={`block size-full ${swatch}`} />
                </span>
                <div class="min-w-0">
                  <dt class="text-highlighted font-mono text-xs" data-identifier>
                    {label}
                  </dt>
                  <dd class="text-muted mt-1 text-sm/5 text-pretty">{note}</dd>
                </div>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section aria-labelledby="components" class="bg-default">
      <div class={`${shell} py-14 lg:py-20`}>
        <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-3">
          <div>
            <h2 id="components" class={sectionHeading}>Browse the components</h2>
            <p class="text-muted mt-3 max-w-[52ch] text-sm/6 text-pretty">
              Every props table, variant list and slot name is read out of the packages at
              build time, so a page never drifts from the component it documents.
            </p>
          </div>
          <a
            href={docHref("react", "components")}
            class="text-muted hover:text-highlighted flex shrink-0 items-center gap-2 rounded-sm text-sm font-medium"
          >
            See all
            <ArrowRight size={15} aria-hidden="true" />
          </a>
        </div>

        <ul class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
          {
            wall.map((component) => (
              <ComponentCard component={component} framework="react" level="h3" />
            ))
          }
        </ul>
      </div>
    </section>
  </main>
</Base>
