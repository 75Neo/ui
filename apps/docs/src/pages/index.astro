---
import { themeColors } from "@75neo/themes";
import { Clipboard } from "@75neo/react";
import Base from "../layouts/Base.astro";
import Stage from "../components/Stage.astro";
import { shell } from "../lib/layout";
import { componentHref, documentedComponents } from "../lib/components";
import { ButtonPreview } from "../previews/ButtonPreview";
import { docHref, frameworkFacts, frameworks } from "../lib/framework";

const components = await documentedComponents();

/**
 * The strengths a recipe is allowed to spend a color at. Six cover the library, and
 * `packages/themes/src/colors.ts` is where they are documented.
 */
const strengths = [
  { class: "bg-primary/10", label: "/10", note: "a soft, tinted fill" },
  { class: "bg-primary/15", label: "/15", note: "that fill, hovered" },
  { class: "bg-primary/25", label: "/25", note: "a hairline ring, and focus" },
  { class: "bg-primary/50", label: "/50", note: "a ring that reads as a border" },
  { class: "bg-primary/75", label: "/75", note: "a solid fill, hovered" },
  { class: "bg-primary", label: "full", note: "a solid fill, or text" },
];

/** `code` is the part of a layer's name that is an identifier rather than a word. */
const layers = [
  { name: "The recipe", note: "What the component looks like before anyone says anything." },
  { name: "Every", code: "Theme", after: "above it", note: "Already folded into one config." },
  { name: "The", code: "ui", after: "prop", note: "This call site, per slot." },
  { code: "class", note: "This call site, reaching the base slot only." },
];
---

<Base
  title="75NeoUI · One design system, two frameworks"
  description="A component library for React and Vue built on Ark UI, Tailwind CSS and Tailwind Variants. One recipe, two adapters, four layers of theming that fold into one class string."
>
  <main id="content" class="flex-1">
    <section class="border-muted border-b">
      <div class={`${shell} grid gap-14 py-16 lg:grid-cols-[minmax(0,32rem)_minmax(0,1fr)] lg:gap-20 lg:py-24`}>
        <div>
          <p class="text-dimmed font-mono text-xs tracking-wide" data-identifier>
            component library · react + vue
          </p>
          <h1
            class="text-highlighted mt-4 text-4xl font-semibold tracking-[-0.04em] text-balance sm:text-5xl lg:text-[3.5rem] lg:leading-[1.05]"
          >
            One design system, two frameworks.
          </h1>
          <p class="text-muted mt-6 max-w-[52ch] text-base/7 text-pretty">
            75NeoUI ships the same components for React and Vue from one set of styles.
            The recipe, the slot names and the props live in a single module, so the two
            adapters cannot drift apart.
          </p>

          {
            /*
             * The documentation is split by adapter, so the first choice on the site is
             * which one you are here for. Two doors rather than one and a switcher
             * buried inside it.
             */
          }
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a
              href={docHref("react", "getting-started")}
              class="bg-inverted text-inverted hover:bg-inverted/90 inline-flex items-center rounded-md px-4 py-2 text-sm font-medium"
            >
              React docs
            </a>
            <a
              href={docHref("vue", "getting-started")}
              class="text-default ring-accented hover:bg-elevated inline-flex items-center rounded-md px-4 py-2 text-sm font-medium ring ring-inset"
            >
              Vue docs
            </a>
          </div>

          <div class="mt-8 flex flex-col gap-2.5">
            {
              frameworks.map((framework) => (
                <div class="flex items-center gap-3">
                  <span
                    class="text-dimmed w-9 shrink-0 font-mono text-[0.6875rem]"
                    data-identifier
                  >
                    {frameworkFacts[framework].label.toLowerCase()}
                  </span>
                  <Clipboard
                    className="min-w-0 flex-1"
                    value={`pnpm add ${frameworkFacts[framework].package}`}
                    client:load
                  />
                </div>
              ))
            }
          </div>
        </div>

        <Stage class="self-center">
          <ButtonPreview client:load />
        </Stage>
      </div>
    </section>

    <section aria-labelledby="cascade" class="border-muted border-b">
      <div class={`${shell} grid gap-10 py-14 lg:grid-cols-[minmax(0,26rem)_minmax(0,1fr)] lg:gap-20 lg:py-20`}>
        <div>
          <p class="text-dimmed font-mono text-xs" data-identifier>the cascade</p>
          <h2
            id="cascade"
            class="text-highlighted mt-3 text-2xl font-semibold tracking-[-0.025em] text-balance"
          >
            Four layers, one class string
          </h2>
          <p class="text-muted mt-4 max-w-[46ch] text-sm/6 text-pretty">
            Anything that can restyle a component enters the same cascade, folded weakest
            first. Tailwind-merge settles conflicts, so a later layer replaces the utility
            it conflicts with and every other utility survives. A component renders a
            finished string with no merging of its own.
          </p>
        </div>

        <ol class="divide-muted border-muted divide-y border-t">
          {
            layers.map(({ name, code, after, note }, index) => (
              <li class="flex gap-6 py-4">
                <span class="text-dimmed w-4 shrink-0 pt-0.5 font-mono text-xs" data-identifier>
                  {index + 1}
                </span>
                <div class="min-w-0">
                  <p class="text-highlighted flex flex-wrap items-baseline gap-1.5 text-sm font-medium">
                    {name}
                    {code && (
                      <code class="text-toned font-mono text-xs" data-identifier>
                        {code}
                      </code>
                    )}
                    {after}
                  </p>
                  <p class="text-muted mt-1 text-sm/6 text-pretty">{note}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section aria-labelledby="color" class="border-muted border-b">
      <div class={`${shell} grid gap-10 py-14 lg:grid-cols-[minmax(0,26rem)_minmax(0,1fr)] lg:gap-20 lg:py-20`}>
        <div>
          <p class="text-dimmed font-mono text-xs" data-identifier>color</p>
          <h2
            id="color"
            class="text-highlighted mt-3 text-2xl font-semibold tracking-[-0.025em] text-balance"
          >
            One token per color
          </h2>
          <p class="text-muted mt-4 max-w-[46ch] text-sm/6 text-pretty">
            There is no second token for a hover shade and no third for a border. A recipe
            asks for the same color at a different strength, so rebranding is one line per
            color and no role is left to retune by hand.
          </p>

          <div class="mt-6 flex flex-wrap gap-1.5">
            {
              themeColors.map((color) => (
                <span
                  class="border-muted text-toned rounded-md border px-2 py-1 font-mono text-xs"
                  data-identifier
                >
                  {color}
                </span>
              ))
            }
            <span
              class="border-muted text-dimmed rounded-md border border-dashed px-2 py-1 font-mono text-xs"
              data-identifier
              title="No hue to spend, so it borrows the surface tokens"
            >
              neutral
            </span>
          </div>
        </div>

        <dl class="divide-muted border-muted divide-y border-t">
          {
            strengths.map(({ class: swatch, label, note }) => (
              <div class="flex items-center gap-5 py-3">
                <span
                  class="size-8 shrink-0 overflow-hidden rounded-md"
                  data-checker
                  aria-hidden="true"
                >
                  <span class={`block size-full ${swatch}`} />
                </span>
                <dt class="text-toned w-14 shrink-0 font-mono text-xs" data-identifier>
                  {label}
                </dt>
                <dd class="text-muted min-w-0 text-sm/6">{note}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section aria-labelledby="components">
      <div class={`${shell} py-14 lg:py-20`}>
        <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2">
          <h2
            id="components"
            class="text-highlighted text-2xl font-semibold tracking-[-0.025em]"
          >
            Components
          </h2>
          <a
            href={docHref("react", "components")}
            class="text-muted hover:text-highlighted rounded-sm font-mono text-xs"
            data-identifier
          >
            full reference →
          </a>
        </div>

        <ul class="mt-8">
          {
            components.map(({ entry, api, slug }) => (
              <li>
                <a
                  href={componentHref("react", slug)}
                  class="group border-muted grid items-baseline gap-x-12 gap-y-2 border-b py-7 first:border-t lg:grid-cols-[11rem_minmax(0,1fr)_auto]"
                >
                  <h3 class="text-highlighted group-hover:text-primary text-xl font-medium tracking-[-0.02em]">
                    {entry.data.name}
                  </h3>
                  <p class="text-muted max-w-[58ch] text-sm/6 text-pretty">
                    {entry.data.summary}
                  </p>
                  <span
                    class="text-dimmed group-hover:text-primary font-mono text-xs lg:text-right"
                    data-identifier
                  >
                    {api.slots.length} slots
                    <span class="ml-1.5">→</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
</Base>
