---
import { ArrowRight } from "@lucide/astro";
import { Code } from "astro:components";
import { themeColors } from "@75neo/themes";
import { Clipboard } from "@75neo/react";
import Base from "../layouts/Base.astro";
import ComponentCard from "../components/ComponentCard.astro";
import { shell } from "../lib/layout";
import { documentedComponents } from "../lib/components";
import { searchIndex } from "../lib/search";
import { ButtonPreview } from "../previews/ButtonPreview";
import { SelectPreview } from "../previews/SelectPreview";
import { SliderPreview } from "../previews/SliderPreview";
import { SwitchPreview } from "../previews/SwitchPreview";
import { docHref, frameworkFacts, frameworks } from "../lib/framework";

const components = await documentedComponents();

/**
 * The strengths a recipe is allowed to spend a color at. Six cover the library, and
 * `packages/themes/src/colors.ts` is where they are documented.
 */
const strengths = [
  { class: "bg-primary/10", label: "/10", note: "A soft, tinted fill." },
  { class: "bg-primary/15", label: "/15", note: "That fill, hovered." },
  { class: "bg-primary/25", label: "/25", note: "A hairline ring, and focus." },
  { class: "bg-primary/50", label: "/50", note: "A ring that reads as a border." },
  { class: "bg-primary/75", label: "/75", note: "A solid fill, hovered." },
  { class: "bg-primary", label: "full", note: "A solid fill, or text." },
];

/** `code` is the part of a layer's name that is an identifier rather than a word. */
const layers = [
  { name: "The recipe", note: "What the component looks like before anyone says anything." },
  { name: "Every", code: "Theme", after: "above it", note: "Already folded into one config." },
  { name: "The", code: "ui", after: "prop", note: "This call site, per slot." },
  { code: "class", note: "This call site, reaching the base slot only." },
];

/*
 * The same call, written in each framework. One prop is renamed by the framework's own
 * conventions and nothing else moves, which is the claim the whole library rests on and
 * the fastest way to check it is to read the two side by side.
 */
const sample = {
  react: `import { ArrowRight } from "lucide-react";
import { Button } from "@75neo/react";

<Button
  variant="soft"
  color="success"
  size="lg"
  trailingIcon={<ArrowRight />}
  ui={{ label: "tracking-wide" }}
>
  Continue
</Button>`,
  vue: `<script setup lang="ts">
import { ArrowRight } from "@lucide/vue";
import { Button } from "@75neo/vue";
</script>

<Button
  variant="soft"
  color="success"
  size="lg"
  :ui="{ label: 'tracking-wide' }"
>
  Continue
  <template #trailing><ArrowRight /></template>
</Button>`,
};

/** The first nine of the reference, as a wall under the fold. */
const wall = components.slice(0, 9);

const shiki = { light: "github-light", dark: "github-dark" } as const;

const specimenCard = "border-muted bg-default overflow-hidden rounded-xl border px-4 py-3.5";
const specimenLabel = "text-dimmed mb-3 block font-mono text-xs";
const frameHeader =
  "bg-muted border-muted flex items-center justify-between gap-3 border-b px-4 py-2.5";
---

<Base
  title="75NeoUI · One design system, two frameworks"
  description="A component library for React and Vue built on Ark UI, Tailwind CSS and Tailwind Variants. One recipe, two adapters, four layers of theming that fold into one class string."
  entries={searchIndex("react", components)}
  footer
>
  <main id="content">
    <section class="border-muted bg-default border-b">
      <div
        class={`${shell} grid items-center gap-12 py-16 lg:grid-cols-[minmax(0,30rem)_minmax(0,1fr)] lg:gap-20 lg:py-24`}
      >
        <div>
          <h1
            class="text-highlighted text-4xl font-semibold tracking-[-0.04em] text-balance sm:text-5xl lg:text-[3.25rem] lg:leading-[1.06]"
          >
            One design system, two frameworks.
          </h1>
          <p class="text-muted mt-6 max-w-[46ch] text-base/7 text-pretty">
            {components.length} components for React and Vue, from one recipe, one set of
            slot names and one props type.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a
              href={docHref("react", "getting-started")}
              class="bg-inverted text-inverted hover:bg-inverted/90 inline-flex items-center rounded-lg px-4 py-2.5 text-sm font-medium"
            >
              Get started
            </a>
            <a
              href={docHref("react", "components")}
              class="text-default ring-accented hover:bg-elevated inline-flex items-center gap-2 rounded-lg px-4 py-2.5 text-sm font-medium ring ring-inset"
            >
              Browse components
              <ArrowRight size={15} aria-hidden="true" />
            </a>
          </div>
        </div>

        {
          /*
           * The hero's asset is the library itself, hydrated so a reader can work it
           * before reading a word.
           *
           * All four have a settled footprint: working them changes what they show and
           * never how much room it takes. That is the whole reason for this particular
           * four. An Accordion here opened its panel into the grid row, which moved the
           * headline beside it, so the first thing the page did was shift under the
           * reader. A component that resizes belongs on its own page, where the room
           * below it is nobody else's.
           */
        }
        <div
          data-stage
          class="border-muted grid gap-3 rounded-2xl border p-3 sm:grid-cols-2 sm:p-4"
        >
          <div class={specimenCard}>
            <span class={specimenLabel} data-identifier>button</span>
            <ButtonPreview client:visible />
          </div>
          <div class={specimenCard}>
            <span class={specimenLabel} data-identifier>select</span>
            <SelectPreview client:visible />
          </div>
          <div class={specimenCard}>
            <span class={specimenLabel} data-identifier>switch</span>
            <SwitchPreview client:visible />
          </div>
          <div class={specimenCard}>
            <span class={specimenLabel} data-identifier>slider</span>
            <SliderPreview client:visible />
          </div>
        </div>
      </div>
    </section>

    <section aria-labelledby="install" class="border-muted bg-default border-b">
      <div class={`${shell} py-12`}>
        <h2 id="install" class="text-highlighted text-lg font-semibold tracking-[-0.02em]">
          One package per adapter
        </h2>
        <p class="text-muted mt-2 max-w-[62ch] text-sm/6 text-pretty">
          Each pulls the themes package in with it, so the styles arrive at the same time
          as the components.
        </p>

        <div class="mt-5 grid gap-3 lg:grid-cols-2">
          {
            frameworks.map((framework) => (
              <div class="flex items-center gap-3">
                <span class="text-dimmed w-9 shrink-0 font-mono text-xs" data-identifier>
                  {frameworkFacts[framework].label.toLowerCase()}
                </span>
                <Clipboard
                  className="min-w-0 flex-1"
                  value={`pnpm add ${frameworkFacts[framework].package}`}
                  client:visible
                />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section aria-labelledby="parity" class="border-muted bg-default border-b">
      <div class={`${shell} py-14 lg:py-20`}>
        <h2
          id="parity"
          class="text-highlighted text-2xl font-semibold tracking-[-0.025em] text-balance"
        >
          The same component, written twice
        </h2>
        <p class="text-muted mt-4 max-w-[62ch] text-sm/6 text-pretty">
          The recipe, the slot names, the variant values and the props type live in one
          module that neither adapter can disagree with. What changes between these two is
          what the frameworks themselves spell differently, and the props tables in the
          reference are read out of that module rather than written down.
        </p>

        <div class="border-muted mt-8 overflow-hidden rounded-xl border">
          <div class="grid lg:grid-cols-2">
            {
              frameworks.map((framework, index) => (
                <article class:list={["min-w-0", index === 0 && "border-muted border-b lg:border-e lg:border-b-0"]}>
                  <header class={frameHeader}>
                    <h3 class="text-highlighted font-mono text-xs leading-none" data-identifier>
                      {framework}
                    </h3>
                    <span class="text-dimmed font-mono text-[0.6875rem] leading-none" data-identifier>
                      {frameworkFacts[framework].package}
                    </span>
                  </header>
                  <Code
                    code={sample[framework]}
                    lang={frameworkFacts[framework].language}
                    themes={shiki}
                    class="!bg-default overflow-x-auto p-5 text-[0.8125rem]/[1.7]"
                  />
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section aria-labelledby="cascade" class="border-muted bg-default border-b">
      <div
        class={`${shell} grid gap-10 py-14 lg:grid-cols-[minmax(0,24rem)_minmax(0,1fr)] lg:gap-20 lg:py-20`}
      >
        <div>
          <h2
            id="cascade"
            class="text-highlighted text-2xl font-semibold tracking-[-0.025em] text-balance"
          >
            Four layers, one class string
          </h2>
          <p class="text-muted mt-4 max-w-[44ch] text-sm/6 text-pretty">
            Anything that can restyle a component enters the same cascade, folded weakest
            first. Tailwind-merge settles conflicts, so a later layer replaces the utility
            it conflicts with and every other utility survives. A component renders a
            finished string with no merging of its own.
          </p>
        </div>

        <ol class="divide-muted border-muted max-w-[46rem] divide-y border-t">
          {
            layers.map(({ name, code, after, note }, index) => (
              <li class="flex gap-6 py-4">
                <span class="text-dimmed w-4 shrink-0 pt-0.5 font-mono text-xs" data-identifier>
                  {index + 1}
                </span>
                <div class="min-w-0">
                  <p class="text-highlighted flex flex-wrap items-baseline gap-1.5 text-sm font-medium">
                    {name}
                    {code && (
                      <code class="text-toned font-mono text-xs" data-identifier>
                        {code}
                      </code>
                    )}
                    {after}
                  </p>
                  <p class="text-muted mt-1 text-sm/6 text-pretty">{note}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section aria-labelledby="color" class="border-muted bg-default border-b">
      <div class={`${shell} py-14 lg:py-20`}>
        <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-5">
          <div>
            <h2
              id="color"
              class="text-highlighted text-2xl font-semibold tracking-[-0.025em] text-balance"
            >
              One token per color
            </h2>
            <p class="text-muted mt-4 max-w-[52ch] text-sm/6 text-pretty">
              There is no second token for a hover shade and no third for a border. A
              recipe asks for the same color at a different strength, so rebranding is one
              line per color and no role is left to retune by hand.
            </p>
          </div>

          <div class="flex flex-wrap gap-1.5">
            {
              themeColors.map((color) => (
                <span
                  class="border-muted text-toned rounded-lg border px-2 py-1 font-mono text-xs"
                  data-identifier
                >
                  {color}
                </span>
              ))
            }
            <span
              class="border-muted text-dimmed rounded-lg border border-dashed px-2 py-1 font-mono text-xs"
              data-identifier
              title="No hue to spend, so it borrows the surface tokens"
            >
              neutral
            </span>
          </div>
        </div>

        <dl class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {
            strengths.map(({ class: swatch, label, note }) => (
              <div class="border-muted flex items-center gap-4 rounded-xl border px-4 py-3.5">
                <span
                  class="size-9 shrink-0 overflow-hidden rounded-lg"
                  data-checker
                  aria-hidden="true"
                >
                  <span class={`block size-full ${swatch}`} />
                </span>
                <div class="min-w-0">
                  <dt class="text-highlighted font-mono text-xs" data-identifier>
                    {label}
                  </dt>
                  <dd class="text-muted mt-1 text-sm/5 text-pretty">{note}</dd>
                </div>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section aria-labelledby="components" class="bg-default">
      <div class={`${shell} py-14 lg:py-20`}>
        <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-3">
          <div>
            <h2
              id="components"
              class="text-highlighted text-2xl font-semibold tracking-[-0.025em]"
            >
              {components.length} components, documented from source
            </h2>
            <p class="text-muted mt-3 max-w-[52ch] text-sm/6 text-pretty">
              Every props table, variant list and slot name is read back out of the
              packages at build time, so a renamed prop changes the docs or fails the
              build.
            </p>
          </div>
          <a
            href={docHref("react", "components")}
            class="text-muted hover:text-highlighted flex shrink-0 items-center gap-2 rounded-sm text-sm font-medium"
          >
            See all
            <ArrowRight size={15} aria-hidden="true" />
          </a>
        </div>

        <ul class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
          {wall.map((component) => <ComponentCard component={component} framework="react" level="h3" />)}
        </ul>
      </div>
    </section>
  </main>
</Base>
