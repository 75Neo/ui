---
import { type CollectionEntry, getCollection, render } from "astro:content";
import ThemeBlock from "../components/ThemeBlock.astro";
import Layout from "../layouts/Layout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("docs");

  return entries.map((entry) => ({
    // `index` is the site root; every other entry's id is its path.
    params: { slug: entry.id === "index" ? undefined : entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"docs">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={entry.data.title} description={entry.data.description}>
  <article class="prose">
    <h1>{entry.data.title}</h1>
    <p class="lede">{entry.data.description}</p>
    <Content />
    {entry.data.theme && <ThemeBlock name={entry.data.theme} />}
  </article>
</Layout>
