{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // Astro syncs the content collection's generated types into `.astro` before it builds
    // or type-checks, and `typecheck` produces nothing else. This is the only project in the
    // repo that emits from a check.
    "build": {
      "outputs": ["$TURBO_EXTENDS$", ".astro/**"]
    },
    "typecheck": {
      "outputs": [".astro/**"]
    }
  }
}
