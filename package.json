{
  "name": "75NeoUI",
  "version": "0.0.0",
  "description": "A component library for React, Vue, and Svelte",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter 'playground-*'",
    "dev:react": "turbo run dev --filter playground-react",
    "dev:vue": "turbo run dev --filter playground-vue",
    "dev:svelte": "turbo run dev --filter playground-svelte",
    "dev:docs": "turbo run dev --filter docs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:packages": "turbo run lint:package --filter './packages/*'",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "turbo": "^2.10.11",
    "typescript": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.20.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
