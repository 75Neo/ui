{
  "name": "75NeoUI",
  "version": "1.0.0",
  "description": "A component library for React and Vue",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "registry:generate": "node scripts/build-registry.mjs",
    "registry:build": "pnpm registry:generate && shadcn build registry.react.json --output public/r/react && shadcn-vue build registry.vue.json --output public/r/vue",
    "build": "pnpm registry:build && astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "pnpm registry:generate"
  },
  "dependencies": {
    "@ark-ui/react": "^5.39.1",
    "@ark-ui/vue": "^5.39.1",
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^6.0.5",
    "@astrojs/ts-plugin": "^1.10.11",
    "@astrojs/vue": "^7.0.2",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@lucide/vue": "^1.41.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "cn": "^0.2.5",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "ts-morph": "^28.0.0",
    "typescript": "~6.0.3",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "astro": "^7.3.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tailwindcss": "^1.10.2",
    "shadcn": "^4.21.0",
    "shadcn-vue": "^2.8.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "warn"
    }
  }
}
