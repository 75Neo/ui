{
  "name": "75neo-ui",
  "version": "0.0.0",
  "private": true,
  "description": "75NeoUI — an Ark UI + Tailwind CSS component library for React, Vue and Svelte",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/playground-*\" run dev",
    "dev:react": "pnpm --filter playground-react run dev",
    "dev:vue": "pnpm --filter playground-vue run dev",
    "dev:svelte": "pnpm --filter playground-svelte run dev",
    "dev:docs": "pnpm --filter docs run dev",
    "build": "pnpm -r run build",
    "check": "pnpm -r run check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:packages": "pnpm --filter \"./packages/*\" exec publint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "clean": "pnpm -r exec rm -rf dist storybook-static .astro .svelte-kit node_modules/.tmp node_modules/.vite"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.20.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
