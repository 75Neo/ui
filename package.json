{
  "name": "75NeoUI",
  "version": "0.0.0",
  "description": "A component library for React, and Vue",
  "type": "module",
  "scripts": {
    "dev:docs": "turbo run dev --filter docs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:packages": "turbo run lint:package --filter './packages/*'",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "oxfmt": "^0.64.0",
    "oxlint": "^1.80.0",
    "oxlint-tailwindcss": "^1.10.0",
    "puppeteer": "^25.9.0",
    "turbo": "^2.10.12"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.20.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
