{
  "name": "75NeoUI",
  "version": "1.0.0",
  "description": "A component library for React and Vue",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "packages:build": "pnpm --filter @75neo/ui build",
    "registry:generate": "node scripts/build-registry.mjs && node scripts/build-demos.mjs",
    "build": "pnpm packages:build && pnpm registry:generate && astro build",
    "preview": "astro preview",
    "typecheck": "pnpm --filter @75neo/ui typecheck && astro check && vue-tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "pnpm packages:build && pnpm registry:generate",
    "demos:generate": "node scripts/build-demos.mjs"
  },
  "dependencies": {
    "@75neo/ui": "workspace:*",
    "@ark-ui/react": "^5.39.1",
    "@ark-ui/vue": "^5.39.1",
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^6.0.5",
    "@astrojs/ts-plugin": "^1.10.11",
    "@astrojs/vue": "^7.0.2",
    "@comark/vue": "^0.6.2",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@lucide/vue": "^1.41.0",
    "@shikijs/themes": "^4.4.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "cn": "^0.2.5",
    "comark": "^0.6.2",
    "lucide-react": "^1.41.0",
    "puppeteer": "^25.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.4.3",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "ts-morph": "^28.0.0",
    "typescript": "~6.0.3",
    "vue": "^3.5.42",
    "vue-component-meta": "^3.3.11"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "astro": "^7.3.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tailwindcss": "^1.10.2",
    "shadcn": "^4.21.0",
    "simple-icons": "^16.30.0",
    "vue-tsc": "^3.3.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "warn"
    }
  }
}
