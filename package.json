{
  "name": "75NeoUI",
  "version": "0.0.0",
  "description": "A component library for React, and Vue",
  "type": "module",
  "scripts": {
    "dev:docs": "turbo run dev --filter docs",
    "dev:play": "turbo run dev --filter playground",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "turbo run test"
  },
  "devDependencies": {
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tailwindcss": "^1.10.2",
    "turbo": "^2.10.12"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "warn"
    }
  }
}
